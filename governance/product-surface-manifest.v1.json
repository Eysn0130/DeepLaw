{
  "schema_version": "deeplaw.product-surface-manifest/v1",
  "package_version": "0.12.0",
  "lifecycle_status": "source_candidate",
  "release_ready": false,
  "default_product": [
    {"name": "init", "status": "current", "bindings": ["deeplaw init", "deeplaw knowledge init"]},
    {"name": "doctor", "status": "current", "bindings": ["deeplaw doctor", "deeplaw knowledge doctor"]},
    {"name": "source add", "status": "current", "bindings": ["deeplaw add", "deeplaw knowledge source add"]},
    {"name": "compile", "status": "current", "bindings": ["deeplaw knowledge compile"]},
    {"name": "reconcile", "status": "current", "bindings": ["deeplaw knowledge reconcile", "deeplaw knowledge autonomy reconcile"]},
    {"name": "query/context", "status": "current", "bindings": ["deeplaw knowledge query", "deeplaw knowledge context", "knowledge_support operation=query", "knowledge_support operation=context", "knowledge_support operation=explain"]},
    {"name": "snapshot", "status": "current", "bindings": ["deeplaw knowledge snapshot create", "deeplaw knowledge snapshot verify", "deeplaw knowledge snapshot restore"]},
    {"name": "forget", "status": "current", "bindings": ["deeplaw knowledge forget", "deeplaw knowledge autonomy gc"]},
    {"name": "host connect", "status": "current", "bindings": ["deeplaw knowledge host connect", "contracts/host-connect-plan.v2.schema.json", "docs/AGENT_ADAPTERS.md"]},
    {"name": "task continuity", "status": "current", "bindings": ["deeplaw knowledge task start/locate/inspect/timeline/resume/fork/compaction/checkpoint/forget", "contracts/task-handle.v1.schema.json", "contracts/task-continuity-result.v2.schema.json", "contracts/workspace-snapshot-receipt.v1.schema.json", "src/deeplaw/task_continuity.py"]}
  ],
  "external_callers": [
    {"caller": "CLI", "current_bindings": ["src/deeplaw/cli.py", "src/deeplaw/knowledge_cli.py", "src/deeplaw/host_connect.py", "pyproject.toml project.scripts.deeplaw"], "compatibility_bindings": ["deeplaw recall", "deeplaw knowledge search", "deeplaw knowledge recall", "deeplaw knowledge autonomy recall", "deeplaw knowledge autonomy context"], "mutation_boundary": "Owner and maintainer mutations remain explicit CLI operations; read commands and Host connection plans do not hide writes."},
    {"caller": "knowledge_support", "current_bindings": ["knowledge_support leaf", "contracts/knowledge-support.input.v7.schema.json", "contracts/knowledge-support.output.v6.schema.json", "advertised operations: query, context, explain"], "compatibility_bindings": ["contracts/knowledge-support.input.v1.schema.json through v6 (internal compatibility)", "contracts/knowledge-support.output.v1.schema.json through v5 (internal compatibility)"], "mutation_boundary": "Read-only MCP process; only query/context/explain are advertised; no operation may create or widen a grant or mutate canonical knowledge."},
    {"caller": "knowledge_sink", "current_bindings": ["knowledge_sink leaf", "contracts/knowledge-sink.input.v6.schema.json", "contracts/knowledge-sink.output.v4.schema.json"], "compatibility_bindings": ["contracts/knowledge-sink.input.v1.schema.json through v5", "contracts/knowledge-sink.output.v1.schema.json through v3"], "mutation_boundary": "Separate opt-in process requiring an owner-created writer, scope, sensitivity, operation, rate and capacity grant."},
    {"caller": "law_support", "current_bindings": ["law_support leaf", "contracts/law-support.input.v4.schema.json", "contracts/law-support.output.v4.schema.json"], "compatibility_bindings": ["contracts/law-support.input.v1.schema.json through v3", "contracts/law-support.output.v1.schema.json through v3"], "mutation_boundary": "Read-only legal evidence process; official and private administration remain explicit owner or maintainer CLI operations."},
    {"caller": "plugins/skills", "current_bindings": ["plugins/deeplaw", "plugins/deeplaw-knowledge-os", "knowledge_support", "law_support"], "compatibility_bindings": ["plugins/deeplaw-knowledge-os/skills/use-knowledge-assets", "plugins/deeplaw-knowledge-os/skills/compile-living-wiki"], "mutation_boundary": "Skill text and plugin manifests cannot grant tools, Authority, scope or mutation capability."},
    {"caller": "adapters", "current_bindings": ["adapters/codex", "adapters/claude", "adapters/opencode"], "compatibility_bindings": ["static host configuration and no-model lifecycle fixtures"], "mutation_boundary": "Adapters stay thin and cannot duplicate retrieval, governance, persistence or Host runtime ownership."},
    {"caller": "tests/contracts", "current_bindings": ["tests", "contracts", "benchmarks/release/platform-core-test-manifest-v2.json", "contracts/platform-gate-binding-receipt.v2.schema.json", "benchmarks/release/v013-gate-classification-v8.json"], "compatibility_bindings": ["benchmarks/release/platform-core-test-manifest-v1.json", "contracts/platform-gate-binding-receipt.v1.schema.json", "historical Gate v1-v7 classifications and migration fixtures"], "mutation_boundary": "Tests and contracts observe public seams; they do not establish runtime Authority or release readiness."},
    {"caller": "historical persisted data", "current_bindings": ["Source Revision bytes", "registered Markdown revisions", "trusted Ledger events", "snapshot manifests"], "compatibility_bindings": ["v0.6 release migration fixture", "v0.7 reviewed Knowledge Assets", "legacy one-digest-per-file CAS layout", "knowledge-support and knowledge-sink v1-v5 persisted receipts"], "mutation_boundary": "No persistent contract is removed without migration, recovery, audit replay, rollback evidence and owner approval."}
  ],
  "surfaces": [
    {"surface_id": "default.init_doctor", "product_role": "Core", "lifecycle": "Active", "default_highlight": true, "bindings": ["deeplaw init", "deeplaw doctor"], "persistent_contract": false, "rationale": "These are the normal first-run and health-check entry points."},
    {"surface_id": "default.source_add", "product_role": "Core", "lifecycle": "Active", "default_highlight": true, "bindings": ["deeplaw add", "deeplaw knowledge source add"], "persistent_contract": true, "rationale": "Source addition preserves immutable source identity and evidence before compilation."},
    {"surface_id": "default.compile_reconcile", "product_role": "Core", "lifecycle": "Active", "default_highlight": true, "bindings": ["deeplaw knowledge compile", "deeplaw knowledge reconcile", "deeplaw knowledge autonomy reconcile"], "persistent_contract": true, "rationale": "Compilation and governed reconciliation are the normal Source-to-Knowledge write paths; the direct reconcile command reuses the existing coordinator."},
    {"surface_id": "default.query_context", "product_role": "Core", "lifecycle": "Active", "default_highlight": true, "bindings": ["deeplaw knowledge query", "deeplaw knowledge context", "knowledge_support operation=query", "knowledge_support operation=context"], "persistent_contract": true, "rationale": "Purpose-aware query and bounded context are the canonical Agent read surfaces."},
    {"surface_id": "default.backup_forget", "product_role": "Core", "lifecycle": "Active", "default_highlight": true, "bindings": ["deeplaw knowledge snapshot", "deeplaw knowledge forget"], "persistent_contract": true, "rationale": "Owner recovery and private-data lifecycle are first-class product operations."},
    {"surface_id": "default.host_connect", "product_role": "Driver", "lifecycle": "Active", "default_highlight": true, "bindings": ["deeplaw knowledge host connect", "contracts/host-connect-plan.v2.schema.json", "docs/AGENT_ADAPTERS.md"], "persistent_contract": true, "rationale": "The owner-side command verifies and privately binds one local vault, then returns a path-free merge-only read-only MCP plan; it does not install a Host, manage authentication, or enable the Sink."},
    {"surface_id": "default.task_continuity", "product_role": "Core", "lifecycle": "Active", "default_highlight": true, "bindings": ["deeplaw knowledge task start/locate/inspect/timeline/resume/fork/compaction/checkpoint/forget", "contracts/task-handle.v1.schema.json", "contracts/task-continuity-result.v2.schema.json", "contracts/workspace-snapshot-receipt.v1.schema.json", "src/deeplaw/task_continuity.py"], "persistent_contract": true, "rationale": "Task Continuity is a product role on the shared governed kernel: project plus task text plus current workspace locates the exact route for recovery; the opaque handle is optional and never part of static Host Connect. Timeline is a bounded identity-only projection over existing Run, Checkpoint and Ledger records. Reads stay read-only, while checkpoint and forget remain explicit knowledge_sink operations requiring an owner grant."},
    {"surface_id": "mcp.knowledge_support", "product_role": "Core", "lifecycle": "Active", "default_highlight": true, "bindings": ["knowledge_support", "contracts/knowledge-support.input.v7.schema.json", "contracts/knowledge-support.output.v6.schema.json", "advertised operations: query, context, explain"], "persistent_contract": true, "rationale": "This is the default read-only Agent interface for the shared Context Compiler; input v7/output v6 are current advertisement contracts, while v1-v6 input and v1-v5 output remain internal compatibility only."},
    {"surface_id": "mcp.law_support", "product_role": "Core", "lifecycle": "Active", "default_highlight": false, "bindings": ["law_support", "contracts/law-support.input.v4.schema.json", "contracts/law-support.output.v4.schema.json"], "persistent_contract": true, "rationale": "This is the separate read-only Agent interface for the Legal Pack, not a general default query engine."},
    {"surface_id": "default.living_wiki", "product_role": "Core", "lifecycle": "Active", "default_highlight": true, "bindings": ["deeplaw knowledge compile", "deeplaw knowledge reconcile", "deeplaw knowledge wiki page/backlinks/outlinks/browse-kind/recent"], "persistent_contract": true, "rationale": "Source-native Wiki compilation, projection, navigation and governed edit reconciliation are v0.13 Kernel behavior; third-party desktop presentation is separate, and Wiki is not a fourth Provider operation."},
    {"surface_id": "advanced.semantic_synthesis_backfill", "product_role": "Driver", "lifecycle": "Hidden", "default_highlight": false, "bindings": ["deeplaw knowledge semantic", "deeplaw knowledge synthesis", "deeplaw knowledge backfill"], "persistent_contract": true, "rationale": "These explicit compilation and promotion protocols require expert governance context."},
    {"surface_id": "advanced.discovery_diagnostics", "product_role": "Driver", "lifecycle": "Hidden", "default_highlight": false, "bindings": ["deeplaw knowledge retrieval-profile", "deeplaw knowledge compare-retrieval", "deeplaw knowledge diagnose-retrieval", "deeplaw knowledge discovery-model"], "persistent_contract": true, "rationale": "Ranking, comparison and diagnostic controls aid operators but are not the default product story."},
    {"surface_id": "advanced.wiki_graph_analytics", "product_role": "Driver", "lifecycle": "Hidden", "default_highlight": false, "bindings": ["deeplaw knowledge wiki local-graph", "Living Wiki Canvas", "community projection", "centrality projection", "visual graph analytics"], "persistent_contract": false, "rationale": "Canvas, communities, centrality and visual graph analysis are derived optional operator surfaces, not the Core Living Wiki contract."},
    {"surface_id": "advanced.knowledge_sink", "product_role": "Driver", "lifecycle": "Hidden", "default_highlight": false, "bindings": ["deeplaw knowledge sink", "knowledge_sink", "contracts/knowledge-sink.input.v6.schema.json"], "persistent_contract": true, "rationale": "Low-level mutation stays separately enabled, least-privilege and absent from default host registration."},
    {"surface_id": "advanced.owner_legal_admin", "product_role": "Driver", "lifecycle": "Hidden", "default_highlight": false, "bindings": ["deeplaw official", "deeplaw private", "deeplaw maintainer"], "persistent_contract": true, "rationale": "Catalog, private-library and signing workflows require explicit owner or maintainer authority."},
    {"surface_id": "compatibility.read_aliases", "product_role": "Compatibility", "lifecycle": "Hidden", "default_highlight": false, "bindings": ["deeplaw recall", "deeplaw knowledge search", "deeplaw knowledge recall", "deeplaw knowledge autonomy recall", "deeplaw knowledge autonomy context"], "persistent_contract": true, "rationale": "Caller and migration evidence is incomplete, so aliases remain executable and are not deprecated in Pass 11."},
    {"surface_id": "compatibility.legacy_contracts", "product_role": "Compatibility", "lifecycle": "Hidden", "default_highlight": false, "bindings": ["contracts/host-connect-plan.v1.schema.json", "knowledge-support input v1-v6/output v1-v5", "knowledge-sink v1-v5", "law-support v1-v3", "legacy one-digest-per-file CAS"], "persistent_contract": true, "rationale": "Historical Host plans, receipts, and persisted Vaults require caller inventory, migration, and rollback evidence before removal."},
    {"surface_id": "compatibility.review_workflows", "product_role": "Compatibility", "lifecycle": "Hidden", "default_highlight": false, "bindings": ["deeplaw knowledge propose", "deeplaw knowledge approve", "deeplaw knowledge review", "deeplaw knowledge inbox"], "persistent_contract": true, "rationale": "Reviewed source-derived and external-import workflows remain explicit compatibility paths."},
    {"surface_id": "experimental.obsidian", "product_role": "Experiment", "lifecycle": "Deferred", "default_highlight": false, "bindings": ["Obsidian CLI bridge", "Obsidian plugin bundle", "benchmarks/hosts/evidence/pass11-obsidian-desktop-2026-08-11"], "persistent_contract": false, "rationale": "The first-party desktop adapter and visual E2E remain deferred; underlying Markdown, Wikilink, alias, link, rename/move and edit/reconcile behavior remains Core."},
    {"surface_id": "experimental.tolaria", "product_role": "Experiment", "lifecycle": "Deferred", "default_highlight": false, "bindings": ["Tolaria v2026-08-11 external MCP bridge", "benchmarks/hosts/run_tolaria_workspace_interop.py"], "persistent_contract": false, "rationale": "Tolaria Desktop and visual E2E remain deferred; underlying Markdown, Wikilink, controlled edit, conflict/reconcile and source-successor behavior remains Core."},
    {"surface_id": "experimental.discovery_sidecar", "product_role": "Experiment", "lifecycle": "Deferred", "default_highlight": false, "bindings": ["deeplaw knowledge discovery-model", "deeplaw knowledge build-discovery", "deeplaw knowledge search-discovery"], "persistent_contract": false, "rationale": "Discovery proposes candidates only and remains an explicit optional local sidecar."},
    {"surface_id": "retire_candidate.use_knowledge_assets", "product_role": "Compatibility", "lifecycle": "Deferred", "default_highlight": false, "bindings": ["plugins/deeplaw-knowledge-os/skills/use-knowledge-assets"], "persistent_contract": false, "rationale": "Split Skills supersede this wrapper, but caller inventory and migration evidence are not complete."},
    {"surface_id": "retire_candidate.compile_living_wiki", "product_role": "Compatibility", "lifecycle": "Deferred", "default_highlight": false, "bindings": ["plugins/deeplaw-knowledge-os/skills/compile-living-wiki"], "persistent_contract": false, "rationale": "The scheduled wrapper is compatibility-only; no deletion occurs until host callers and rollback evidence are complete."}
  ],
  "deprecation_policy": {
    "persistent_contracts_deleted_in_pass10": false,
    "aliases_deprecated_in_pass10": false,
    "required_before_deprecation": [
      "external_caller_inventory",
      "historical_data_migration_evidence",
      "rollback_rehearsal",
      "owner_approval"
    ]
  }
}
