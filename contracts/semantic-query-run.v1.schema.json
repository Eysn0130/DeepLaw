{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/semantic-query-run.v1.schema.json",
  "title": "DeepLaw Frozen First-Party Semantic Query Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "status", "gold_id", "gold_sha256",
    "fixture_manifest_sha256", "compiler_report_id", "source_revision_set_sha256",
    "query_set_sha256", "first_party_command_sha256", "budget",
    "retrieval_configuration", "execution_environment", "cases", "challenges",
    "metrics", "recorded_at", "competitive_claim_eligible"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.semantic-query-run/v1"},
    "report_id": {"type": "string", "pattern": "^semanticqueryrun_[0-9a-f]{24}$"},
    "status": {"enum": ["passed", "failed"]},
    "gold_id": {"type": "string", "pattern": "^semanticgold_[0-9a-f]{24}$"},
    "gold_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "compiler_report_id": {"type": "string", "pattern": "^(semantichostrun|semanticdeterministic)_[0-9a-f]{24}$"},
    "source_revision_set_sha256": {"$ref": "#/$defs/sha256"},
    "query_set_sha256": {"$ref": "#/$defs/sha256"},
    "first_party_command_sha256": {"$ref": "#/$defs/sha256"},
    "budget": {"$ref": "#/$defs/budget"},
    "retrieval_configuration": {"$ref": "#/$defs/retrieval_configuration"},
    "execution_environment": {"$ref": "#/$defs/execution_environment"},
    "cases": {
      "type": "array", "minItems": 15, "maxItems": 100,
      "items": {"$ref": "#/$defs/case"}
    },
    "challenges": {
      "type": "array", "minItems": 5, "maxItems": 20,
      "items": {"$ref": "#/$defs/challenge"}
    },
    "metrics": {"$ref": "#/$defs/metrics"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "competitive_claim_eligible": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "retrieval_configuration": {
      "type": "object", "additionalProperties": false,
      "required": [
        "query_plan_schema_version", "policy_ids", "fts_identity",
        "dense_model_identity", "reranker_model_identity", "graph_hops",
        "channel_order_sha256"
      ],
      "properties": {
        "query_plan_schema_version": {"const": "deeplaw.knowledge-query-plan/v5"},
        "policy_ids": {
          "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
          "items": {"enum": ["compiled-first-v1", "evidence-first-v1", "balanced-v1"]}
        },
        "fts_identity": {"const": "sqlite-fts5/autonomous_search_v3"},
        "dense_model_identity": {"type": "string", "minLength": 1, "maxLength": 200},
        "reranker_model_identity": {"type": "string", "minLength": 1, "maxLength": 200},
        "graph_hops": {"const": 1},
        "channel_order_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution_environment": {
      "type": "object", "additionalProperties": false,
      "required": [
        "os", "python", "sqlite_version", "dependency_inventory_sha256",
        "hardware", "network_policy",
        "cold_state_definition", "warm_state_definition"
      ],
      "properties": {
        "os": {
          "type": "object", "additionalProperties": false,
          "required": ["system", "release", "machine"],
          "properties": {
            "system": {"type": "string", "minLength": 1, "maxLength": 200},
            "release": {"type": "string", "minLength": 1, "maxLength": 500},
            "machine": {"type": "string", "minLength": 1, "maxLength": 200}
          }
        },
        "python": {
          "type": "object", "additionalProperties": false,
          "required": ["implementation", "version"],
          "properties": {
            "implementation": {"type": "string", "minLength": 1, "maxLength": 100},
            "version": {"type": "string", "minLength": 1, "maxLength": 100}
          }
        },
        "sqlite_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "dependency_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "hardware": {
          "type": "object", "additionalProperties": false,
          "required": ["logical_cpu_count", "processor", "total_memory_bytes"],
          "properties": {
            "logical_cpu_count": {"type": ["integer", "null"], "minimum": 1},
            "processor": {"type": "string", "minLength": 1, "maxLength": 500},
            "total_memory_bytes": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "network_policy": {"type": "string", "minLength": 1, "maxLength": 100},
        "cold_state_definition": {"type": "string", "minLength": 1, "maxLength": 1000},
        "warm_state_definition": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_items", "max_sources", "max_chars", "max_tokens", "max_sensitivity"],
      "properties": {
        "max_items": {"const": 8}, "max_sources": {"const": 12},
        "max_chars": {"const": 8000}, "max_tokens": {"const": 6000},
        "max_sensitivity": {"const": "public"}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": [
        "query_count", "execution_count", "passed_count", "provider_payload_bytes",
        "provider_bytes_per_matched_target",
        "raw_fragment_baseline_bytes", "bytes_saved_ratio", "cold_latency_p50_ms",
        "cold_latency_p95_ms", "warm_latency_p50_ms", "warm_latency_p95_ms",
        "repeated_query_reuse_rate", "compiled_hit_ratio", "source_fallback_ratio",
        "uncompiled_source_count", "extraction_completeness",
        "retrieval_source_coverage", "evidence_attachment_rate", "peak_rss_bytes",
        "provider_hard_limit_violations",
        "unauthorized_writes", "authority_elevations", "invalid_official_citations",
        "silent_fallbacks",
        "stale_prohibited_selections", "recall_at_k", "target_scoped_precision_at_k",
        "mrr", "ndcg_at_k", "citation_validity", "claim_evidence_binding_accuracy",
        "context_verification_rate", "continuation_success_rate",
        "challenge_execution_counts", "prompt_injection_failures",
        "unsupported_authoritative_claims", "restricted_disclosures",
        "unauthorized_mutation_failures", "silent_fallback_challenge_failures"
      ],
      "properties": {
        "query_count": {"type": "integer", "minimum": 15, "maximum": 100},
        "execution_count": {"type": "integer", "minimum": 30, "maximum": 200},
        "passed_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "provider_payload_bytes": {"type": "integer", "minimum": 0},
        "provider_bytes_per_matched_target": {"type": "number", "minimum": 0},
        "raw_fragment_baseline_bytes": {"type": "integer", "minimum": 0},
        "bytes_saved_ratio": {"type": "number", "minimum": -1000, "maximum": 1},
        "cold_latency_p50_ms": {"type": "integer", "minimum": 0},
        "cold_latency_p95_ms": {"type": "integer", "minimum": 0},
        "warm_latency_p50_ms": {"type": "integer", "minimum": 0},
        "warm_latency_p95_ms": {"type": "integer", "minimum": 0},
        "repeated_query_reuse_rate": {"$ref": "#/$defs/ratio"},
        "compiled_hit_ratio": {
          "$ref": "#/$defs/ratio",
          "description": "Fraction of cases with at least one required compiled Gold target that retrieved at least one matching labelled target; explicit-gap-only cases are excluded."
        },
        "source_fallback_ratio": {"$ref": "#/$defs/ratio"},
        "uncompiled_source_count": {"type": "integer", "minimum": 0},
        "extraction_completeness": {"$ref": "#/$defs/ratio"},
        "retrieval_source_coverage": {"$ref": "#/$defs/ratio"},
        "evidence_attachment_rate": {"$ref": "#/$defs/ratio"},
        "peak_rss_bytes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Maximum sampled resident set size of a first-party CLI query or adversarial-challenge process during the run."
        },
        "provider_hard_limit_violations": {"type": "integer", "minimum": 0},
        "unauthorized_writes": {"type": "integer", "minimum": 0},
        "authority_elevations": {"type": "integer", "minimum": 0},
        "invalid_official_citations": {"type": "integer", "minimum": 0},
        "silent_fallbacks": {"type": "integer", "minimum": 0},
        "stale_prohibited_selections": {"type": "integer", "minimum": 0},
        "recall_at_k": {"$ref": "#/$defs/ratio"},
        "target_scoped_precision_at_k": {"$ref": "#/$defs/ratio"},
        "mrr": {"$ref": "#/$defs/ratio"},
        "ndcg_at_k": {"$ref": "#/$defs/ratio"},
        "citation_validity": {"$ref": "#/$defs/ratio"},
        "claim_evidence_binding_accuracy": {"$ref": "#/$defs/ratio"},
        "context_verification_rate": {"$ref": "#/$defs/ratio"},
        "continuation_success_rate": {"$ref": "#/$defs/ratio"},
        "challenge_execution_counts": {
          "type": "object", "additionalProperties": false,
          "required": [
            "prompt_injection", "unsupported_authoritative_claim",
            "restricted_disclosure", "unauthorized_mutation", "silent_fallback"
          ],
          "properties": {
            "prompt_injection": {"type": "integer", "minimum": 1},
            "unsupported_authoritative_claim": {"type": "integer", "minimum": 1},
            "restricted_disclosure": {"type": "integer", "minimum": 1},
            "unauthorized_mutation": {"type": "integer", "minimum": 1},
            "silent_fallback": {"type": "integer", "minimum": 1}
          }
        },
        "prompt_injection_failures": {"type": "integer", "minimum": 0},
        "unsupported_authoritative_claims": {"type": "integer", "minimum": 0},
        "restricted_disclosures": {"type": "integer", "minimum": 0},
        "unauthorized_mutation_failures": {"type": "integer", "minimum": 0},
        "silent_fallback_challenge_failures": {"type": "integer", "minimum": 0}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": [
        "case_id", "task_type", "query_phase", "query_sha256", "purpose", "status",
        "expected_targets", "actual_objects", "query_plan", "query_plan_sha256",
        "cold_latency_ms", "warm_latency_ms", "cold_peak_rss_bytes",
        "warm_peak_rss_bytes", "provider_payload_bytes",
        "context_provider_payload_bytes", "context_capsule_id", "context_capsule_sha256",
        "context_verification_valid", "compiled_revision_ids",
        "selected_source_revision_ids", "gap_codes", "explicit_gap", "repeat_reused",
        "write_performed", "authority_changed_by_ranking", "source_fallback_visible",
        "provider_hard_limit_valid", "continuation_valid", "citation_checks",
        "claim_evidence_checks", "citation_validity", "claim_evidence_binding_accuracy",
        "matched_label_ids",
        "recall_at_k", "target_scoped_precision_at_k", "reciprocal_rank", "ndcg_at_k",
        "failure_reason"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^semantic-case-[0-9]{2}$"},
        "task_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "query_phase": {"enum": ["baseline", "post_transition"]},
        "query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "purpose": {"enum": ["answer", "verify", "quote", "historical", "freshness_check"]},
        "expected_targets": {
          "type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/expected_target"}
        },
        "actual_objects": {
          "type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/actual_object"}
        },
        "query_plan": {"type": "object"},
        "query_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["passed", "failed"]},
        "cold_latency_ms": {"type": "integer", "minimum": 0},
        "warm_latency_ms": {"type": "integer", "minimum": 0},
        "cold_peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "warm_peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "provider_payload_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "context_provider_payload_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "context_capsule_id": {"type": "string", "pattern": "^capsule_[0-9a-f]{24}$"},
        "context_capsule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "context_verification_valid": {"type": "boolean"},
        "compiled_revision_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^knowledgerev_[0-9a-f]{24}$"}},
        "selected_source_revision_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"}},
        "gap_codes": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
        "explicit_gap": {"type": "boolean"},
        "repeat_reused": {"type": "boolean"},
        "write_performed": {"type": "boolean"},
        "authority_changed_by_ranking": {"type": "boolean"},
        "source_fallback_visible": {"type": "boolean"},
        "provider_hard_limit_valid": {"type": "boolean"},
        "continuation_valid": {"type": "boolean"},
        "citation_checks": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/citation_check"}},
        "claim_evidence_checks": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/claim_evidence_check"}},
        "citation_validity": {"$ref": "#/$defs/ratio"},
        "claim_evidence_binding_accuracy": {"$ref": "#/$defs/ratio"},
        "matched_label_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^label-[a-z0-9-]+$"}},
        "recall_at_k": {"$ref": "#/$defs/ratio"},
        "target_scoped_precision_at_k": {"$ref": "#/$defs/ratio"},
        "reciprocal_rank": {"$ref": "#/$defs/ratio"},
        "ndcg_at_k": {"$ref": "#/$defs/ratio"},
        "failure_reason": {"type": ["string", "null"], "maxLength": 1000}
      }
    },
    "citation_check": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_revision_id", "fragment_id", "fragment_revision_id",
        "locator", "quote_sha256", "valid"
      ],
      "properties": {
        "source_revision_id": {"type": ["string", "null"], "pattern": "^sourcerev_[0-9a-f]{24}$"},
        "fragment_id": {"type": ["string", "null"], "pattern": "^fragment_[0-9a-f]{24}$"},
        "fragment_revision_id": {"type": ["string", "null"], "pattern": "^irfragment_[0-9a-f]{24}$"},
        "locator": {"type": ["string", "null"], "maxLength": 2000},
        "quote_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "valid": {"type": "boolean"}
      },
      "anyOf": [
        {"properties": {"fragment_id": {"type": "string"}}},
        {"properties": {"fragment_revision_id": {"type": "string"}}}
      ]
    },
    "claim_evidence_check": {
      "type": "object", "additionalProperties": false,
      "required": [
        "label_id", "claim_id", "knowledge_id", "revision_id",
        "expected_source_revision_ids", "actual_source_revision_ids",
        "evidence_refs", "content_terms_valid", "evidence_terms_valid",
        "source_coverage_valid", "receipt_valid", "valid"
      ],
      "properties": {
        "label_id": {"type": "string", "pattern": "^label-[a-z0-9-]+$"},
        "claim_id": {"type": "string", "pattern": "^claim-gold-[a-z0-9-]+$"},
        "knowledge_id": {"type": ["string", "null"], "pattern": "^knowledge_[0-9a-f]{24}$"},
        "revision_id": {"type": ["string", "null"], "pattern": "^knowledgerev_[0-9a-f]{24}$"},
        "expected_source_revision_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"}},
        "actual_source_revision_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"}},
        "evidence_refs": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/source_ref"}},
        "content_terms_valid": {"type": "boolean"},
        "evidence_terms_valid": {"type": "boolean"},
        "source_coverage_valid": {"type": "boolean"},
        "receipt_valid": {"type": "boolean"},
        "valid": {"type": "boolean"}
      }
    },
    "expected_target": {
      "type": "object", "additionalProperties": false,
      "required": ["label_id", "kind", "canonical_label", "required"],
      "properties": {
        "label_id": {"type": "string", "pattern": "^label-[a-z0-9-]+$"},
        "kind": {"type": "string", "minLength": 1, "maxLength": 100},
        "canonical_label": {"type": "string", "minLength": 1, "maxLength": 500},
        "required": {"type": "boolean"}
      }
    },
    "actual_object": {
      "type": "object", "additionalProperties": false,
      "required": [
        "knowledge_id", "revision_id", "kind", "title", "semantic_key",
        "content_excerpt", "source_refs", "synthesis_evidence_receipt"
      ],
      "properties": {
        "knowledge_id": {"type": "string", "pattern": "^knowledge_[0-9a-f]{24}$"},
        "revision_id": {"type": "string", "pattern": "^knowledgerev_[0-9a-f]{24}$"},
        "kind": {"type": "string", "minLength": 1, "maxLength": 100},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "semantic_key": {"type": "string", "minLength": 1, "maxLength": 300},
        "content_excerpt": {"type": "string", "maxLength": 2000},
        "source_refs": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/source_ref"}},
        "synthesis_evidence_receipt": {"type": ["object", "null"]}
      }
    },
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_revision_id", "fragment_id", "fragment_revision_id",
        "locator", "quote_sha256"
      ],
      "properties": {
        "source_revision_id": {"type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"},
        "fragment_id": {"type": ["string", "null"], "pattern": "^fragment_[0-9a-f]{24}$"},
        "fragment_revision_id": {"type": ["string", "null"], "pattern": "^irfragment_[0-9a-f]{24}$"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 2000},
        "quote_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "anyOf": [
        {"properties": {"fragment_id": {"type": "string"}}},
        {"properties": {"fragment_revision_id": {"type": "string"}}}
      ]
    },
    "challenge": {
      "type": "object", "additionalProperties": false,
      "required": [
        "challenge_id", "challenge_type", "status", "query_sha256", "execution_count",
        "selected_source_revision_ids", "gap_codes", "provider_payload_bytes",
        "peak_rss_bytes", "failure_reason", "mutation"
      ],
      "properties": {
        "challenge_id": {"type": "string", "pattern": "^security-challenge-[0-9]{2}$"},
        "challenge_type": {"enum": ["prompt_injection", "unsupported_authoritative_claim", "restricted_disclosure", "unauthorized_mutation", "silent_fallback"]},
        "status": {"enum": ["passed", "failed"]},
        "query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_count": {"const": 1},
        "selected_source_revision_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"}},
        "gap_codes": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
        "provider_payload_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "latency_ms": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "failure_reason": {"type": ["string", "null"], "maxLength": 1000},
        "mutation": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["attempted", "rejected", "return_code", "audit_head_unchanged"],
              "properties": {
                "attempted": {"const": true}, "rejected": {"type": "boolean"},
                "return_code": {"type": "integer", "minimum": 0, "maximum": 255},
                "audit_head_unchanged": {"type": "boolean"}
              }
            }
          ]
        }
      }
    }
  }
}
