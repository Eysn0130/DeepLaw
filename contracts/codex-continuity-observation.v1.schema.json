{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/codex-continuity-observation.v1.schema.json",
  "title": "DeepLaw Codex Continuity Candidate Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "release_ready",
    "claim_eligible",
    "binding",
    "environment",
    "candidate",
    "host",
    "security",
    "preflight",
    "runs",
    "aggregate",
    "not_executed"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.codex-continuity-observation/v1"},
    "status": {"enum": ["executed", "partial", "failed"]},
    "release_ready": {"const": false},
    "claim_eligible": {"const": false},
    "binding": {"$ref": "#/$defs/binding"},
    "environment": {"$ref": "#/$defs/environment"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "host": {"$ref": "#/$defs/host"},
    "security": {"$ref": "#/$defs/security"},
    "preflight": {"$ref": "#/$defs/preflight"},
    "runs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/run"}
    },
    "aggregate": {"$ref": "#/$defs/aggregate"},
    "not_executed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "package_version",
        "worktree_clean",
        "candidate_wheel_name",
        "candidate_wheel_sha256"
      ],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package_version": {"const": "0.12.0"},
        "worktree_clean": {"const": true},
        "candidate_wheel_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.whl$"},
        "candidate_wheel_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating_system", "architecture", "python_version"],
      "properties": {
        "operating_system": {"type": "string", "minLength": 1, "maxLength": 100},
        "architecture": {"type": "string", "minLength": 1, "maxLength": 100},
        "python_version": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "configuration_sha256",
        "case_id",
        "task_sha256",
        "task_binding_sha256"
      ],
      "properties": {
        "name": {"const": "continuity-task-suite-v1.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "case_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "task_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary_name",
        "binary_sha256",
        "version",
        "model",
        "authentication",
        "argv",
        "argv_sha256",
        "mcp_argv",
        "enabled_tools",
        "disabled_capabilities"
      ],
      "properties": {
        "binary_name": {"const": "codex"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "model": {"const": "gpt-5.6-luna"},
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source", "auth_file_read"],
          "properties": {
            "status": {"const": "logged_in_using_chatgpt"},
            "source": {"const": "existing_codex_login"},
            "auth_file_read": {"const": false}
          }
        },
        "argv": {"type": "array", "minItems": 8, "maxItems": 100, "items": {"type": "string", "maxLength": 500}},
        "argv_sha256": {"$ref": "#/$defs/sha256"},
        "mcp_argv": {"type": "array", "minItems": 2, "maxItems": 20, "items": {"type": "string", "maxLength": 200}},
        "enabled_tools": {"const": ["knowledge_support"]},
        "disabled_capabilities": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_canaries_injected",
        "mcp_child_closed_environment",
        "provider_capsule_clean",
        "provider_internal_surface_leak",
        "event_receipts_clean",
        "report_clean",
        "absolute_path_leak",
        "secret_leak",
        "credential_path_forwarded",
        "mcp_wrapper_sha256"
      ],
      "properties": {
        "host_canaries_injected": {"const": true},
        "mcp_child_closed_environment": {"type": "boolean"},
        "provider_capsule_clean": {"type": "boolean"},
        "provider_internal_surface_leak": {"type": "boolean"},
        "event_receipts_clean": {"type": "boolean"},
        "report_clean": {"const": true},
        "absolute_path_leak": {"type": "boolean"},
        "secret_leak": {"type": "boolean"},
        "credential_path_forwarded": {"type": "boolean"},
        "mcp_wrapper_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "providerCapsule": {
      "type": ["object", "null"],
      "maxProperties": 16
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provider_capsule_sha256",
        "provider_capsule",
        "provider_bytes",
        "provider_hard_limit_bytes",
        "relevant_chars",
        "context_chars",
        "relevant_chars_context_chars",
        "correct_state_admitted",
        "stale_state_admitted",
        "wrong_state_admission",
        "wrong_state_rejections",
        "stale_snapshot_gap",
        "query_target_used",
        "ledger_audit_head",
        "write_performed"
      ],
      "properties": {
        "status": {"const": "passed"},
        "provider_capsule_sha256": {"$ref": "#/$defs/sha256"},
        "provider_capsule": {"$ref": "#/$defs/providerCapsule"},
        "provider_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "provider_hard_limit_bytes": {"const": 65536},
        "relevant_chars": {"type": "integer", "minimum": 1},
        "context_chars": {"type": "integer", "minimum": 1},
        "relevant_chars_context_chars": {"type": "number", "minimum": 0, "maximum": 1},
        "correct_state_admitted": {"const": true},
        "stale_state_admitted": {"const": false},
        "wrong_state_admission": {"const": 0},
        "wrong_state_rejections": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "stale_revision", "task_line", "worktree"],
          "properties": {
            "repository": {"const": true},
            "stale_revision": {"const": true},
            "task_line": {"const": true},
            "worktree": {"const": true}
          }
        },
        "stale_snapshot_gap": {"const": "workspace_diverged"},
        "query_target_used": {"const": false},
        "ledger_audit_head": {"$ref": "#/$defs/sha256"},
        "write_performed": {"const": false}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "input_tokens", "cached_input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "status": {"enum": ["provider_reported", "unreported"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "environmentReceipt": {
      "type": ["object", "null"],
      "maxProperties": 10
    },
    "hostOutput": {
      "type": ["object", "null"],
      "maxProperties": 8
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_index",
        "status",
        "exit_status",
        "latency_ms",
        "prompt_sha256",
        "actual_event_receipt",
        "usage",
        "environment_receipt",
        "host_output",
        "provider_capsule",
        "provider_internal_surface_leak",
        "provider_bytes",
        "ledger_audit_head_before",
        "ledger_audit_head_after",
        "ledger_unchanged",
        "failure_class",
        "failure_summary"
      ],
      "properties": {
        "run_index": {"type": "integer", "minimum": 1, "maximum": 3},
        "status": {"enum": ["passed", "failed"]},
        "exit_status": {"type": ["integer", "null"]},
        "latency_ms": {"type": "integer", "minimum": 0},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "actual_event_receipt": {"type": "object", "maxProperties": 16},
        "usage": {"$ref": "#/$defs/usage"},
        "environment_receipt": {"$ref": "#/$defs/environmentReceipt"},
        "host_output": {"$ref": "#/$defs/hostOutput"},
        "provider_capsule": {"$ref": "#/$defs/providerCapsule"},
        "provider_internal_surface_leak": {"type": "boolean"},
        "provider_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "ledger_audit_head_before": {"$ref": "#/$defs/sha256"},
        "ledger_audit_head_after": {"$ref": "#/$defs/sha256"},
        "ledger_unchanged": {"type": "boolean"},
        "failure_class": {"type": ["string", "null"], "maxLength": 100},
        "failure_summary": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed_runs",
        "failed_runs",
        "actual_input_tokens",
        "actual_cached_input_tokens",
        "actual_output_tokens",
        "actual_total_tokens",
        "latency_ms",
        "candidate_execution_complete"
      ],
      "properties": {
        "passed_runs": {"type": "integer", "minimum": 0, "maximum": 3},
        "failed_runs": {"type": "integer", "minimum": 0, "maximum": 3},
        "actual_input_tokens": {"type": "integer", "minimum": 0},
        "actual_cached_input_tokens": {"type": "integer", "minimum": 0},
        "actual_output_tokens": {"type": "integer", "minimum": 0},
        "actual_total_tokens": {"type": "integer", "minimum": 0},
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max", "mean"],
          "properties": {
            "min": {"type": "integer", "minimum": 0},
            "max": {"type": "integer", "minimum": 0},
            "mean": {"type": "number", "minimum": 0}
          }
        },
        "candidate_execution_complete": {"type": "boolean"}
      }
    }
  }
}
