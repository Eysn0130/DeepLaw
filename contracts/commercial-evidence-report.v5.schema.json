{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/commercial-evidence-report.v5.schema.json",
  "title": "DeepLaw machine-only commercial evidence report v5",
  "description": "Closed collection of machine-profile provenance-bound Gate Result v4 files. It cannot establish a human-attested or competitive claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "reference_provenance",
    "human_authenticity",
    "report_kind",
    "report_id",
    "qualification_run_id",
    "candidate_binding",
    "protocol_binding",
    "threshold_binding",
    "reference_binding",
    "corpora",
    "classification_binding",
    "gate_results",
    "machine_qualification_claim_eligible",
    "human_attested_claim_eligible",
    "competitive_claim_eligible",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.commercial-evidence-report/v5"},
    "profile": {"const": "machine_evaluated_no_human_attestation"},
    "reference_provenance": {"const": "agent_consensus"},
    "human_authenticity": {"const": "not_claimed"},
    "report_kind": {"const": "v013_machine_provenance_bound_gate_collection"},
    "report_id": {"$ref": "#/$defs/identifier"},
    "qualification_run_id": {"type": "integer", "minimum": 1},
    "candidate_binding": {"$ref": "#/$defs/candidateBinding"},
    "protocol_binding": {"$ref": "#/$defs/protocolBinding"},
    "threshold_binding": {"$ref": "#/$defs/thresholdBinding"},
    "reference_binding": {"$ref": "#/$defs/referenceBinding"},
    "corpora": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/corpus"}
    },
    "classification_binding": {"$ref": "#/$defs/classificationBinding"},
    "gate_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/gateResultReference"}
    },
    "machine_qualification_claim_eligible": {"type": "boolean"},
    "human_attested_claim_eligible": {"const": false},
    "competitive_claim_eligible": {"const": false},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,512}$"},
    "category": {"enum": ["Core", "Capability", "Competitive Claim"]},
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_commit", "candidate_tree", "candidate_wheel_sha256", "candidate_sdist_sha256"],
      "properties": {
        "candidate_commit": {"$ref": "#/$defs/git"},
        "candidate_tree": {"$ref": "#/$defs/git"},
        "candidate_wheel_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sdist_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protocolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "protocol_sha256", "frozen"],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/identifier"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "frozen": {"const": true}
      }
    },
    "thresholdBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold_id", "threshold_sha256", "frozen"],
      "properties": {
        "threshold_id": {"$ref": "#/$defs/identifier"},
        "threshold_sha256": {"$ref": "#/$defs/sha256"},
        "frozen": {"const": true}
      }
    },
    "referenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_reference_sha256",
        "agent_roster_sha256",
        "agent_consensus_sha256",
        "agent_isolation_sha256",
        "scorer_panel_sha256",
        "arbiter_sha256",
        "frozen"
      ],
      "properties": {
        "semantic_reference_sha256": {"$ref": "#/$defs/sha256"},
        "agent_roster_sha256": {"$ref": "#/$defs/sha256"},
        "agent_consensus_sha256": {"$ref": "#/$defs/sha256"},
        "agent_isolation_sha256": {"$ref": "#/$defs/sha256"},
        "scorer_panel_sha256": {"$ref": "#/$defs/sha256"},
        "arbiter_sha256": {"$ref": "#/$defs/sha256"},
        "frozen": {"const": true}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "source", "sha256", "frozen"],
      "properties": {
        "role": {"enum": ["candidate_full", "development", "qualification_holdout", "final_blind"]},
        "source": {"enum": ["repository", "repository_external"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "frozen": {"const": true}
      }
    },
    "classificationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification_id", "classification_schema_version", "classification_sha256"],
      "properties": {
        "classification_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
        "classification_schema_version": {"const": "deeplaw.v013-release-gate-classification/v8"},
        "classification_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "gateResultReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "category", "result"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/identifier"},
        "category": {"$ref": "#/$defs/category"},
        "result": {"$ref": "#/$defs/resultArtifact"}
      }
    },
    "resultArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "byte_size", "file_sha256", "schema_version", "record_sha256", "artifact_kind"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "byte_size": {"type": "integer", "minimum": 1, "maximum": 100000000000},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "deeplaw.provenance-bound-gate-result/v4"},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_kind": {"const": "provenance-bound-gate-result"}
      }
    }
  }
}
