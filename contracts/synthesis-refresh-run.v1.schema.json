{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/synthesis-refresh-run.v1.schema.json",
  "title": "DeepLaw Synthesis Refresh Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "synthesis_refresh_run_id", "refresh_task_id",
    "target_semantic_key", "target_knowledge_id", "expected_revision_id",
    "input_set_sha256", "triggering_freshness_event_ids", "transaction"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.synthesis-refresh-run/v1"},
    "synthesis_refresh_run_id": {"type": "string", "pattern": "^synthesisrefresh_[0-9a-f]{24}$"},
    "refresh_task_id": {"type": "string", "pattern": "^synthesisrefreshtask_[0-9a-f]{24}$"},
    "target_semantic_key": {"type": "string", "minLength": 1, "maxLength": 300},
    "target_knowledge_id": {"type": "string", "pattern": "^knowledge_[0-9a-f]{24}$"},
    "expected_revision_id": {"type": "string", "pattern": "^knowledgerev_[0-9a-f]{24}$"},
    "input_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "triggering_freshness_event_ids": {
      "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^freshness_[0-9a-f]{24}$"}
    },
    "transaction": {"type": "object"}
  }
}
