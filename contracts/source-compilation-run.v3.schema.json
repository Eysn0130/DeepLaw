{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/source-compilation-run.v3.schema.json",
  "title": "DeepLaw Source Compilation Run v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "transaction", "semantic_status",
    "observation_packet_count", "observed_packet_count", "observation_count",
    "inventory_sha256", "publication_plan_sha256", "source_summary_revision_id",
    "quality_receipt_sha256", "duty_reports", "gaps", "freshness", "verification"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.source-compilation-run/v3"},
    "transaction": {"type": "object"},
    "semantic_status": {"enum": ["complete", "partial", "blocked", "unknown"]},
    "observation_packet_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "observed_packet_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "observation_count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "inventory_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "publication_plan_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source_summary_revision_id": {"type": ["string", "null"], "pattern": "^knowledgerev_[0-9a-f]{24}$"},
    "quality_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "duty_reports": {"type": "array", "maxItems": 15, "items": {"type": "object"}},
    "gaps": {
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": {
        "enum": [
          "partial_compilation", "semantic_duty_unresolved", "source_summary_missing",
          "identity_resolution_pending", "synthesis_refresh_pending"
        ]
      }
    },
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "source_status", "dependency_counts"],
      "properties": {
        "state": {"enum": ["fresh", "unknown", "stale", "invalidated"]},
        "source_status": {"enum": ["active", "pending", "superseded", "removed", "unknown"]},
        "dependency_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["fresh", "unknown", "stale", "invalidated"],
          "properties": {
            "fresh": {"type": "integer", "minimum": 0},
            "unknown": {"type": "integer", "minimum": 0},
            "stale": {"type": "integer", "minimum": 0},
            "invalidated": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "valid", "failure_count", "audit_head"],
      "properties": {
        "status": {"enum": ["verified", "invalid"]},
        "valid": {"type": "boolean"},
        "failure_count": {"type": "integer", "minimum": 0},
        "audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
