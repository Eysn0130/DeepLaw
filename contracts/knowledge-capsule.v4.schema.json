{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/knowledge-capsule.v4.schema.json",
  "title": "DeepLaw Autonomous Knowledge Capsule v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vault_id",
    "task",
    "goal",
    "task_binding",
    "as_of",
    "purpose",
    "policy_id",
    "query_plan",
    "query_plan_sha256",
    "statements",
    "evidence",
    "contradictions",
    "gaps",
    "receipt_id",
    "budget",
    "audit",
    "audit_head",
    "created_at",
    "write_performed",
    "provider_capsule",
    "capsule_id",
    "capsule_digest",
    "knowledge_revisions"
  ],
  "properties": {
    "schema_version": {
      "const": "deeplaw.knowledge-capsule/v4"
    },
    "vault_id": {
      "type": "string",
      "pattern": "^vault_[0-9a-f]{24}$"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "goal": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "task_binding": {
      "oneOf": [
        {
          "$ref": "task-context-binding.v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "purpose": {
      "enum": [
        "answer",
        "verify",
        "quote",
        "historical",
        "legal",
        "debug",
        "freshness_check"
      ]
    },
    "policy_id": {
      "enum": [
        "compiled-first-v1",
        "evidence-first-v1",
        "balanced-v1"
      ]
    },
    "query_plan": {
      "$ref": "knowledge-query-plan.v7.schema.json"
    },
    "query_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "statements": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object"
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object"
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object"
      }
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^queryreceipt_[0-9a-f]{24}$"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "audit": {
      "$ref": "#/$defs/audit"
    },
    "audit_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "write_performed": {
      "const": false
    },
    "provider_capsule": {
      "$ref": "provider-knowledge-capsule.v3.schema.json"
    },
    "capsule_id": {
      "type": "string",
      "pattern": "^capsule_[0-9a-f]{24}$"
    },
    "capsule_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "knowledge_revisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_id",
          "revision_id",
          "kind",
          "title",
          "content",
          "content_sha256",
          "content_truncated",
          "origin",
          "authority",
          "legal_authority",
          "source_free",
          "source_refs",
          "epistemic_state",
          "verification",
          "lifecycle",
          "directive_mode",
          "valid_from",
          "valid_to",
          "expires_at",
          "selection_reason",
          "freshness"
        ],
        "properties": {
          "knowledge_id": {
            "type": "string",
            "pattern": "^knowledge_[0-9a-f]{24}$"
          },
          "revision_id": {
            "type": "string",
            "pattern": "^knowledgerev_[0-9a-f]{24}$"
          },
          "kind": {
            "type": "string",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "content": {
            "type": "string",
            "maxLength": 2000
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_truncated": {
            "type": "boolean"
          },
          "origin": {
            "const": "agent_derived"
          },
          "authority": {
            "const": "agent_derived"
          },
          "legal_authority": {
            "const": false
          },
          "source_free": {
            "const": true
          },
          "source_refs": {
            "type": "array",
            "maxItems": 0
          },
          "epistemic_state": {
            "const": "tentative"
          },
          "verification": {
            "enum": [
              "unverified",
              "run_bound"
            ]
          },
          "lifecycle": {
            "const": "active"
          },
          "directive_mode": {
            "const": "data_only"
          },
          "valid_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "selection_reason": {
            "const": "admitted_governed_revision"
          },
          "freshness": {
            "const": "unknown"
          }
        }
      }
    }
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_items",
        "selected_items",
        "max_characters",
        "selected_characters",
        "max_tokens",
        "max_provider_characters",
        "provider_payload_bytes",
        "local_payload_hard_limit_bytes",
        "selected_tokens",
        "token_count_mode"
      ],
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "selected_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 52
        },
        "max_characters": {
          "type": "integer",
          "minimum": 200,
          "maximum": 20000
        },
        "selected_characters": {
          "type": "integer",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32000
        },
        "max_provider_characters": {
          "const": 65536
        },
        "provider_payload_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "local_payload_hard_limit_bytes": {
          "const": 262144
        },
        "selected_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32000
        },
        "token_count_mode": {
          "const": "estimated"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "receipt_id",
        "query_plan_sha256",
        "query_sha256",
        "input_audit_head",
        "input_legacy_audit_head",
        "ranking_authority_changed",
        "write_performed",
        "receipt_sha256",
        "selection_entries",
        "selection_sha256",
        "discovery_exhaustive",
        "selection_truncated",
        "scope"
      ],
      "properties": {
        "schema_version": {
          "const": "deeplaw.query-audit-receipt/v2"
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^queryreceipt_[0-9a-f]{24}$"
        },
        "query_plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "query_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_audit_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_legacy_audit_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ranking_authority_changed": {
          "const": false
        },
        "write_performed": {
          "const": false
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selection_entries": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "kind",
              "state",
              "reason"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "kind": {
                "enum": [
                  "statement",
                  "knowledge_revision",
                  "evidence"
                ]
              },
              "state": {
                "enum": [
                  "selected",
                  "omitted"
                ]
              },
              "reason": {
                "enum": [
                  "selected",
                  "selection_budget",
                  "character_budget",
                  "token_budget",
                  "source_budget",
                  "source_only_purpose",
                  "relevance_floor",
                  "exact_source_passage_budget",
                  "duplicate_source_reference",
                  "represented_source_reference"
                ]
              }
            }
          }
        },
        "selection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "discovery_exhaustive": {
          "const": false
        },
        "selection_truncated": {
          "type": "boolean"
        },
        "scope": {
          "const": "bounded_admitted_candidates_only"
        }
      }
    },
    "provider_capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "purpose",
        "policy_id",
        "capsule",
        "receipt",
        "delivery"
      ],
      "properties": {
        "schema_version": {
          "const": "deeplaw.provider-knowledge-capsule/v2"
        },
        "purpose": {
          "enum": [
            "answer",
            "verify",
            "quote",
            "historical",
            "legal",
            "debug",
            "freshness_check"
          ]
        },
        "policy_id": {
          "enum": [
            "compiled-first-v1",
            "evidence-first-v1",
            "balanced-v1"
          ]
        },
        "capsule": {
          "type": "object"
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipt_id"
          ],
          "properties": {
            "receipt_id": {
              "type": "string",
              "pattern": "^queryreceipt_[0-9a-f]{24}$"
            }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hard_limit_bytes",
            "provider_content_bytes",
            "projection",
            "write_performed"
          ],
          "properties": {
            "hard_limit_bytes": {
              "const": 65536
            },
            "provider_content_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            },
            "projection": {
              "enum": [
                "compact",
                "standard"
              ]
            },
            "write_performed": {
              "const": false
            }
          }
        }
      }
    }
  }
}
