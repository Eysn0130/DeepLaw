{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/real-semantic-host-report.v2.schema.json",
  "title": "DeepLaw Phased Real Semantic Host Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "binding", "report_id", "status", "executed", "host", "host_version",
    "model_identity", "network_policy", "gold_id", "gold_status", "corpus_id",
    "fixture_manifest_sha256", "execution_prerequisites", "baseline_query_state",
    "command_sha256", "phases", "runs", "transitions",
    "vault_verification_valid", "elapsed_ms", "failure_class", "failure_summary",
    "recorded_at", "formal_release_evidence_ready", "competitive_claim_eligible"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.real-semantic-host-report/v2"},
    "binding": {"$ref": "#/$defs/binding"},
    "report_id": {"type": "string", "pattern": "^semantichostrun_[0-9a-f]{24}$"},
    "status": {"enum": ["not_executed", "passed", "failed"]},
    "executed": {"type": "boolean"},
    "host": {"enum": ["codex", "claude_code", "opencode"]},
    "host_version": {"type": "string", "minLength": 1, "maxLength": 500},
    "model_identity": {"type": "string", "minLength": 1, "maxLength": 500},
    "network_policy": {"enum": ["offline", "explicit_bounded"]},
    "gold_id": {"type": "string", "pattern": "^semanticgold_[0-9a-f]{24}$"},
    "gold_status": {
      "enum": [
        "maintainer_review_pending", "machine_review_pending",
        "maintainer_confirmed", "rejected"
      ]
    },
    "corpus_id": {"type": "string", "pattern": "^semanticcorpus_[0-9a-f]{24}$"},
    "fixture_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_prerequisites": {"$ref": "#/$defs/execution_prerequisites"},
    "baseline_query_state": {"$ref": "#/$defs/baseline_query_state"},
    "command_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "phases": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/phase"}, {"$ref": "#/$defs/phase"}
      ],
      "items": false
    },
    "runs": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {"$ref": "#/$defs/run"}
    },
    "transitions": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/successor"}, {"$ref": "#/$defs/withdrawal"}
      ],
      "items": false
    },
    "vault_verification_valid": {"type": ["boolean", "null"]},
    "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
    "failure_class": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"},
    "failure_summary": {"type": ["string", "null"], "maxLength": 1000},
    "recorded_at": {"type": "string", "format": "date-time"},
    "formal_release_evidence_ready": {"type": "boolean"},
    "competitive_claim_eligible": {"const": false}
  },
  "$defs": {
    "execution_prerequisites": {
      "type": "object", "additionalProperties": false,
      "required": [
        "host_discovery", "authentication", "model_access", "external_model_execution"
      ],
      "properties": {
        "host_discovery": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "version_command", "observed_version"],
          "properties": {
            "status": {"enum": ["discovered", "not_found"]},
            "version_command": {"type": "string", "minLength": 1, "maxLength": 500},
            "observed_version": {"type": ["string", "null"], "maxLength": 500}
          }
        },
        "authentication": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "reason_code", "reason"],
          "properties": {
            "status": {"enum": ["available", "unavailable", "not_checked"]},
            "reason_code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"},
            "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        },
        "model_access": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "reason_code", "reason"],
          "properties": {
            "status": {"enum": ["available", "unavailable", "not_checked"]},
            "reason_code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"},
            "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        },
        "external_model_execution": {"enum": ["executed", "not_executed"]}
      }
    },
    "baseline_query_state": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_sha256", "audit_head", "verified"],
      "properties": {
        "snapshot_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "audit_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "verified": {"type": ["boolean", "null"]}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "commit", "tree", "package_version", "lock_sha256", "pyproject_sha256",
        "contracts_inventory_sha256", "migrations_inventory_sha256", "worktree_clean"
      ],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pyproject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contracts_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "migrations_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "worktree_clean": {"type": "boolean"}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_key", "source_revision_id", "compilation_run_id", "transaction_status",
        "semantic_status", "quality_receipt_sha256", "source_summary_revision_id",
        "projection_manifest_sha256"
      ],
      "properties": {
        "source_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"},
        "source_revision_id": {"type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"},
        "compilation_run_id": {"type": ["string", "null"], "pattern": "^compilationrun_[0-9a-f]{24}$"},
        "transaction_status": {"type": ["string", "null"], "enum": [null, "planned", "staging", "validating", "ready_to_commit", "committed", "projection_pending", "succeeded", "failed", "aborted"]},
        "semantic_status": {"type": ["string", "null"], "enum": [null, "complete", "partial", "blocked", "unknown"]},
        "quality_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "source_summary_revision_id": {"type": ["string", "null"], "pattern": "^knowledgerev_[0-9a-f]{24}$"},
        "projection_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": [
        "phase", "prompt_sha256", "exit_code", "stdout_sha256", "stdout_bytes",
        "stderr_sha256", "stderr_bytes", "token_usage", "elapsed_ms", "failure_class"
      ],
      "properties": {
        "phase": {"enum": ["baseline", "successor"]},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exit_code": {"type": ["integer", "null"], "minimum": -255, "maximum": 255},
        "stdout_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "stdout_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "stderr_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "stderr_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "token_usage": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "input_tokens", "output_tokens", "total_tokens"],
          "properties": {
            "status": {"enum": ["provider_reported", "unreported"]},
            "input_tokens": {"type": ["integer", "null"], "minimum": 0},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0},
            "total_tokens": {"type": ["integer", "null"], "minimum": 0}
          },
          "allOf": [{
            "if": {"properties": {"status": {"const": "provider_reported"}}},
            "then": {"properties": {"input_tokens": {"type": "integer"}, "output_tokens": {"type": "integer"}, "total_tokens": {"type": "integer"}}},
            "else": {"properties": {"input_tokens": {"const": null}, "output_tokens": {"const": null}, "total_tokens": {"const": null}}}
          }]
        },
        "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
        "failure_class": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"}
      }
    },
    "successor": {
      "type": "object", "additionalProperties": false,
      "required": [
        "operation", "status", "predecessor_source_revision_id",
        "successor_source_revision_id", "review_receipt_sha256",
        "freshness_report_sha256"
      ],
      "properties": {
        "operation": {"const": "activate_successor"},
        "status": {"enum": ["not_executed", "passed", "failed"]},
        "predecessor_source_revision_id": {"type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"},
        "successor_source_revision_id": {"type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"},
        "review_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "freshness_report_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "withdrawal": {
      "type": "object", "additionalProperties": false,
      "required": [
        "operation", "status", "source_revision_id", "removal_audit_head",
        "freshness_report_sha256"
      ],
      "properties": {
        "operation": {"const": "withdraw_source"},
        "status": {"enum": ["not_executed", "passed", "failed"]},
        "source_revision_id": {"type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"},
        "removal_audit_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "freshness_report_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "passed"}}},
      "then": {
        "properties": {
          "executed": {"const": true}, "vault_verification_valid": {"const": true},
          "execution_prerequisites": {
            "properties": {
              "host_discovery": {"properties": {"status": {"const": "discovered"}}},
              "authentication": {"properties": {"status": {"const": "available"}}},
              "model_access": {"properties": {"status": {"const": "available"}}},
              "external_model_execution": {"const": "executed"}
            }
          },
          "baseline_query_state": {
            "properties": {
              "snapshot_sha256": {"type": "string"},
              "audit_head": {"type": "string"},
              "verified": {"const": true}
            }
          },
          "failure_class": {"const": null}, "failure_summary": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"formal_release_evidence_ready": {"const": true}}},
      "then": {
        "properties": {
          "status": {"const": "passed"}, "gold_status": {"const": "maintainer_confirmed"},
          "binding": {"properties": {"worktree_clean": {"const": true}}}
        }
      }
    }
  ]
}
