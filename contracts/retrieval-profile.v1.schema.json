{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/retrieval-profile.v1.schema.json",
  "title": "DeepLaw local ranking-only retrieval profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "vault_id",
    "trained_at_revision",
    "trained_at_audit_head",
    "created_at",
    "parent_profile_id",
    "training_feedback_ids",
    "training_feedback_receipts_sha256",
    "channel_weights",
    "source_diversity_weight",
    "type_priority",
    "reranker_profile",
    "authority_effect",
    "profile_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.retrieval-profile/v1"},
    "profile_id": {"type": "string", "pattern": "^retrievalprofile_[0-9a-f]{24}$"},
    "vault_id": {"type": "string", "pattern": "^vault_[0-9a-f]{24}$"},
    "trained_at_revision": {"type": "integer", "minimum": 0},
    "trained_at_audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "parent_profile_id": {
      "type": ["string", "null"],
      "pattern": "^retrievalprofile_[0-9a-f]{24}$"
    },
    "training_feedback_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^feedback_[0-9a-f]{24}$"}
    },
    "training_feedback_receipts_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "channel_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_id", "knowledge_key", "semantic_key", "exact_phrase", "lexical",
        "dense", "tree", "graph", "temporal", "feedback"
      ],
      "properties": {
        "exact_id": {"type": "number", "minimum": 0.1, "maximum": 8},
        "knowledge_key": {"type": "number", "minimum": 0.1, "maximum": 8},
        "semantic_key": {"type": "number", "minimum": 0.1, "maximum": 8},
        "exact_phrase": {"type": "number", "minimum": 0.1, "maximum": 8},
        "lexical": {"type": "number", "minimum": 0.1, "maximum": 8},
        "dense": {"type": "number", "minimum": 0.1, "maximum": 8},
        "tree": {"type": "number", "minimum": 0.1, "maximum": 8},
        "graph": {"type": "number", "minimum": 0.1, "maximum": 8},
        "temporal": {"type": "number", "minimum": 0.1, "maximum": 8},
        "feedback": {"type": "number", "minimum": 0.1, "maximum": 8}
      }
    },
    "source_diversity_weight": {"type": "number", "minimum": 0, "maximum": 4},
    "type_priority": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0.5, "maximum": 2}
    },
    "reranker_profile": {"const": "off"},
    "authority_effect": {"const": "ranking-only"},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
