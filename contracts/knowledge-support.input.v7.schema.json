{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/knowledge-support.input.v7.schema.json",
  "title": "DeepLaw Knowledge Support Provider Input v7",
  "description": "Compact advertised Provider surface. Historical v1-v6 inputs remain internal compatibility contracts.",
  "oneOf": [
    {"$ref": "#/$defs/query"},
    {"$ref": "#/$defs/context"},
    {"$ref": "#/$defs/explain"}
  ],
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "query"],
      "properties": {
        "operation": {"const": "query"},
        "query": {"$ref": "#/$defs/queryText"},
        "query_plan_version": {"const": "6"},
        "host_route": {"$ref": "#/$defs/hostRoute"},
        "purpose": {"$ref": "#/$defs/purpose"},
        "policy": {"$ref": "#/$defs/policy"},
        "scope": {"$ref": "#/$defs/scope"},
        "max_sensitivity": {"$ref": "#/$defs/sensitivity"},
        "limit": {"$ref": "#/$defs/limit"},
        "max_chars": {"$ref": "#/$defs/maxChars"},
        "max_tokens": {"$ref": "#/$defs/maxTokens"},
        "max_sources": {"$ref": "#/$defs/maxSources"},
        "graph_hops": {"$ref": "#/$defs/graphHops"},
        "retrieval_mode": {"$ref": "#/$defs/retrievalMode"},
        "as_of": {"$ref": "#/$defs/asOf"},
        "kinds": {"$ref": "#/$defs/kinds"},
        "query_target": {"$ref": "#/$defs/queryTarget"},
        "applicable_duties": {"$ref": "#/$defs/duties"},
        "capsule_projection": {"$ref": "#/$defs/projection"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "task", "confirm_no_case_data"],
      "properties": {
        "operation": {"const": "context"},
        "task": {"$ref": "#/$defs/queryText"},
        "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
        "confirm_no_case_data": {"const": true},
        "query_plan_version": {"const": "6"},
        "host_route": {"$ref": "#/$defs/hostRoute"},
        "purpose": {"$ref": "#/$defs/purpose"},
        "policy": {"$ref": "#/$defs/policy"},
        "scope": {"$ref": "#/$defs/scope"},
        "max_sensitivity": {"$ref": "#/$defs/sensitivity"},
        "limit": {"$ref": "#/$defs/limit"},
        "max_chars": {"$ref": "#/$defs/maxChars"},
        "max_tokens": {"$ref": "#/$defs/maxTokens"},
        "max_sources": {"$ref": "#/$defs/maxSources"},
        "graph_hops": {"$ref": "#/$defs/graphHops"},
        "retrieval_mode": {"$ref": "#/$defs/retrievalMode"},
        "as_of": {"$ref": "#/$defs/asOf"},
        "kinds": {"$ref": "#/$defs/kinds"},
        "query_target": {"$ref": "#/$defs/queryTarget"},
        "applicable_duties": {"$ref": "#/$defs/duties"},
        "capsule_projection": {"$ref": "#/$defs/projection"}
      }
    },
    "explain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "receipt_id"],
      "properties": {
        "operation": {"const": "explain"},
        "receipt_id": {"type": "string", "pattern": "^queryreceipt_[0-9a-f]{24}$"}
      }
    },
    "queryText": {"type": "string", "minLength": 1, "maxLength": 5000},
    "purpose": {
      "enum": ["answer", "verify", "quote", "historical", "legal", "debug", "freshness_check"]
    },
    "policy": {"enum": ["compiled-first-v1", "evidence-first-v1", "balanced-v1"]},
    "scope": {"enum": ["personal", "project", "domain"]},
    "sensitivity": {"enum": ["public", "internal", "private"]},
    "limit": {"type": "integer", "minimum": 1, "maximum": 20},
    "maxChars": {"type": "integer", "minimum": 200, "maximum": 20000},
    "maxTokens": {"type": "integer", "minimum": 128, "maximum": 32000},
    "maxSources": {"type": "integer", "minimum": 1, "maximum": 32},
    "graphHops": {"type": "integer", "minimum": 0, "maximum": 2},
    "retrievalMode": {"enum": ["exact", "lexical", "dense", "graph", "hybrid"]},
    "asOf": {"type": "string", "format": "date-time"},
    "projection": {"enum": ["compact", "standard", "audit"]},
    "kinds": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/kind"}
    },
    "kind": {
      "enum": [
        "claim", "comparison", "concept", "decision", "entity", "event",
        "experience", "memory", "preference", "procedure", "skill", "synthesis"
      ]
    },
    "queryTarget": {
      "oneOf": [
        {"$ref": "#/$defs/queryText"},
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "text": {"$ref": "#/$defs/queryText"},
            "semantic_key": {"type": "string", "minLength": 1, "maxLength": 500},
            "knowledge_id": {"type": "string", "pattern": "^knowledge_[0-9a-f]{24}$"},
            "revision_id": {"type": "string", "pattern": "^knowledgerev_[0-9a-f]{24}$"},
            "kind": {"$ref": "#/$defs/kind"}
          }
        }
      ]
    },
    "duties": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "primary_answer", "identity", "definition", "current_state",
          "temporal_freshness", "procedure", "exception", "contradiction",
          "applicability", "limitation", "source_evidence", "unresolved_gap"
        ]
      }
    },
    "hostRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "session_sha256"],
      "properties": {
        "host": {"enum": ["codex", "opencode"]},
        "session_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
