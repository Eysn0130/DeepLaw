{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/host-continuity-qualification.v2.schema.json",
  "title": "DeepLaw Native Host Continuity Receipt v2",
  "description": "Current Host receipt. Common task semantics, transport requests, native observations, lineage, Provider accounting, and claim eligibility are separate fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "execution_mode", "qualification_status", "evidence_class",
    "host", "status", "package_version", "release_ready", "claim_eligible",
    "binding", "environment", "host_attestation", "tool_schema", "lifecycle",
    "security", "runs", "aggregate", "not_executed"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.host-continuity-qualification/v2"},
    "execution_mode": {"enum": ["qualification", "diagnostic"]},
    "qualification_status": {"enum": ["passed", "failed", "partial", "not_applicable"]},
    "evidence_class": {"enum": ["qualification_holdout", "development_diagnostic"]},
    "host": {"enum": ["codex", "opencode"]},
    "status": {"enum": ["executed", "partial", "failed"]},
    "package_version": {"const": "0.12.0"},
    "release_ready": {"const": false},
    "claim_eligible": {"const": false},
    "binding": {"$ref": "#/$defs/binding"},
    "environment": {"$ref": "#/$defs/environment"},
    "host_attestation": {"$ref": "#/$defs/hostAttestation"},
    "tool_schema": {"$ref": "#/$defs/toolSchema"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "security": {"$ref": "#/$defs/security"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/run"}
    },
    "aggregate": {"$ref": "#/$defs/aggregate"},
    "not_executed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"execution_mode": {"const": "diagnostic"}},
        "required": ["execution_mode"]
      },
      "then": {
        "properties": {
          "qualification_status": {"const": "not_applicable"},
          "evidence_class": {"const": "development_diagnostic"},
          "runs": {"minItems": 1, "maxItems": 1},
          "environment": {
            "properties": {
              "isolation": {
                "oneOf": [
                  {"$ref": "#/$defs/closedIsolation"},
                  {"$ref": "#/$defs/codexKeyringBridgeIsolation"},
                  {"$ref": "#/$defs/codexExistingLoginDiagnosticIsolation"}
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evidence_class": {"const": "qualification_holdout"},
          "qualification_status": {"enum": ["passed", "failed", "partial"]},
          "runs": {"minItems": 3, "maxItems": 3},
          "environment": {
            "properties": {
              "isolation": {
                "oneOf": [
                  {"$ref": "#/$defs/closedIsolation"},
                  {"$ref": "#/$defs/codexKeyringBridgeIsolation"}
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"host": {"const": "opencode"}},
        "required": ["host"]
      },
      "then": {
        "properties": {
          "environment": {
            "properties": {
              "isolation": {"$ref": "#/$defs/closedIsolation"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "tokenValue": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"const": "unreported"}
      ]
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pluginReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_relative", "source_sha256", "source_bytes",
        "installed_relative", "installed_sha256", "installed_bytes", "exact_match"
      ],
      "properties": {
        "source_relative": {
          "const": "deeplaw/opencode_adapter/plugins/deeplaw-native.ts"
        },
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_bytes": {"type": "integer", "minimum": 1},
        "installed_relative": {"const": ".opencode/plugins/deeplaw-native.ts"},
        "installed_sha256": {"$ref": "#/$defs/sha256"},
        "installed_bytes": {"type": "integer", "minimum": 1},
        "exact_match": {"const": true}
      }
    },
    "routeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation", "status", "session_sha256", "parent_session_sha256",
        "request_sha256", "response_sha256", "gap_codes"
      ],
      "properties": {
        "operation": {"enum": ["wrong_worktree", "fork"]},
        "status": {"enum": ["gap", "forked"]},
        "session_sha256": {"$ref": "#/$defs/sha256"},
        "parent_session_sha256": {"$ref": "#/$defs/nullableSha256"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "response_sha256": {"$ref": "#/$defs/sha256"},
        "gap_codes": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,99}$"}
        }
      }
    },
    "continuityObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "status", "marker_presence"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1400},
        "status": {"enum": ["admitted", "gap"]},
        "delivery_source": {
          "enum": ["codex_hook_completed", "opencode_project_plugin"]
        },
        "delivery_sha256": {"$ref": "#/$defs/sha256"},
        "provider_sha256": {"$ref": "#/$defs/sha256"},
        "provider_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "marker_presence": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,99}$"},
          "additionalProperties": {"type": "boolean"}
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit", "tree", "worktree_clean", "wheel_name", "wheel_sha256",
        "wheel_bytes", "runtime_executable_sha256", "import_path_class",
        "contract_digests"
      ],
      "properties": {
        "commit": {"$ref": "#/$defs/gitOid"},
        "tree": {"$ref": "#/$defs/gitOid"},
        "worktree_clean": {"const": true},
        "wheel_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.whl$"},
        "wheel_sha256": {"$ref": "#/$defs/sha256"},
        "wheel_bytes": {"type": "integer", "minimum": 1},
        "runtime_executable_sha256": {"$ref": "#/$defs/sha256"},
        "import_path_class": {"const": "isolated_site_packages"},
        "contract_digests": {
          "type": "object",
          "minProperties": 3,
          "maxProperties": 24,
          "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.schema\\.json$"},
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating_system", "architecture", "python_version", "isolation"],
      "properties": {
        "operating_system": {"type": "string", "minLength": 1, "maxLength": 100},
        "architecture": {"type": "string", "minLength": 1, "maxLength": 100},
        "python_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "isolation": {"$ref": "#/$defs/isolation"}
      }
    },
    "isolation": {
      "oneOf": [
        {"$ref": "#/$defs/closedIsolation"},
        {"$ref": "#/$defs/codexKeyringBridgeIsolation"},
        {"$ref": "#/$defs/codexExistingLoginDiagnosticIsolation"}
      ]
    },
    "closedIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_kind", "home_isolated", "codex_home_isolated",
        "xdg_config_home_isolated", "xdg_data_home_isolated",
        "ambient_host_state_inherited", "ambient_plugins_inherited",
        "ambient_apps_inherited", "ambient_hooks_inherited",
        "secret_values_retained", "auth_class"
      ],
      "properties": {
        "profile_kind": {"const": "temporary_closed"},
        "home_isolated": {"const": true},
        "codex_home_isolated": {"type": "boolean"},
        "xdg_config_home_isolated": {"const": true},
        "xdg_data_home_isolated": {"const": true},
        "ambient_host_state_inherited": {"const": false},
        "ambient_plugins_inherited": {"const": false},
        "ambient_apps_inherited": {"const": false},
        "ambient_hooks_inherited": {"const": false},
        "secret_values_retained": {"const": false},
        "auth_class": {"enum": ["chatgpt_login", "deepseek_api_key"]}
      }
    },
    "codexKeyringBridgeIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_kind", "home_isolated", "codex_home_isolated",
        "xdg_config_home_isolated", "xdg_data_home_isolated",
        "ambient_host_state_inherited", "ambient_plugins_inherited",
        "ambient_apps_inherited", "ambient_hooks_inherited",
        "secret_values_retained", "auth_class"
      ],
      "properties": {
        "profile_kind": {"const": "temporary_closed_with_keyring_bridge"},
        "home_isolated": {"const": false},
        "codex_home_isolated": {"const": true},
        "xdg_config_home_isolated": {"const": true},
        "xdg_data_home_isolated": {"const": true},
        "ambient_host_state_inherited": {"const": true},
        "ambient_plugins_inherited": {"const": false},
        "ambient_apps_inherited": {"const": false},
        "ambient_hooks_inherited": {"const": false},
        "secret_values_retained": {"const": false},
        "auth_class": {"const": "chatgpt_login"}
      }
    },
    "codexExistingLoginDiagnosticIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_kind", "home_isolated", "codex_home_isolated",
        "xdg_config_home_isolated", "xdg_data_home_isolated",
        "ambient_host_state_inherited", "ambient_plugins_inherited",
        "ambient_apps_inherited", "ambient_hooks_inherited",
        "secret_values_retained", "auth_class"
      ],
      "properties": {
        "profile_kind": {"const": "temporary_closed_with_existing_login"},
        "home_isolated": {"const": false},
        "codex_home_isolated": {"const": false},
        "xdg_config_home_isolated": {"const": true},
        "xdg_data_home_isolated": {"const": true},
        "ambient_host_state_inherited": {"const": true},
        "ambient_plugins_inherited": {"const": false},
        "ambient_apps_inherited": {"const": false},
        "ambient_hooks_inherited": {"const": false},
        "secret_values_retained": {"const": false},
        "auth_class": {"const": "chatgpt_login"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "selected_present", "raw_sha256", "raw_bytes"],
      "properties": {
        "checked": {"type": "boolean"},
        "selected_present": {"type": "boolean"},
        "raw_sha256": {"$ref": "#/$defs/nullableSha256"},
        "raw_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "raw_sha256", "raw_bytes", "elapsed_ms", "input_tokens",
        "cached_input_tokens", "cache_write_input_tokens", "output_tokens",
        "reasoning_output_tokens", "total_tokens"
      ],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "raw_bytes": {"type": "integer", "minimum": 0},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "input_tokens": {"$ref": "#/$defs/tokenValue"},
        "cached_input_tokens": {"$ref": "#/$defs/tokenValue"},
        "cache_write_input_tokens": {"$ref": "#/$defs/tokenValue"},
        "output_tokens": {"$ref": "#/$defs/tokenValue"},
        "reasoning_output_tokens": {"$ref": "#/$defs/tokenValue"},
        "total_tokens": {"$ref": "#/$defs/tokenValue"}
      }
    },
    "hostAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary_name", "binary_sha256", "version", "model", "reasoning_effort",
        "authentication", "model_inventory", "mcp_inventory"
      ],
      "properties": {
        "binary_name": {"enum": ["codex", "opencode"]},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "model": {"enum": ["gpt-5.6-luna", "deepseek/deepseek-v4-flash"]},
        "reasoning_effort": {"const": "max"},
        "actual_response_provider_id": {
          "enum": ["deepseek", "unreported"]
        },
        "actual_response_model_id": {
          "enum": ["deepseek-v4-flash", "unreported"]
        },
        "model_identity_semantics": {
          "const": "request_pin_and_returned_runtime_id_not_weight_identity"
        },
        "credential_broker_launcher_sha256": {"$ref": "#/$defs/sha256"},
        "credential_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runner_secret_received", "runner_dotenv_path_received",
            "host_secret_injected_by", "external_process_receipt_required"
          ],
          "properties": {
            "runner_secret_received": {"const": false},
            "runner_dotenv_path_received": {"const": false},
            "host_secret_injected_by": {"const": "owner_credential_broker"},
            "external_process_receipt_required": {"const": true}
          }
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source", "auth_file_read", "checked", "raw_sha256", "raw_bytes"],
          "properties": {
            "status": {"enum": ["existing_login_confirmed", "provider_available"]},
            "source": {
              "enum": [
                "existing_codex_login", "process_environment", "owner_credential_broker"
              ]
            },
            "auth_file_read": {"const": false},
            "checked": {"type": "boolean"},
            "raw_sha256": {"$ref": "#/$defs/nullableSha256"},
            "raw_bytes": {"type": "integer", "minimum": 0}
          }
        },
        "model_inventory": {"$ref": "#/$defs/inventory"},
        "mcp_inventory": {"$ref": "#/$defs/inventory"},
        "availability": {"$ref": "#/$defs/availability"}
      }
    },
    "toolSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools_list_observed", "tool_name", "input_schema_bytes",
        "input_schema_sha256", "operation_count", "operations",
        "measurement_kind", "provider_observed_schema_tokens"
      ],
      "properties": {
        "tools_list_observed": {"const": true},
        "tool_name": {"const": "knowledge_support"},
        "input_schema_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
        "input_schema_sha256": {"$ref": "#/$defs/sha256"},
        "operation_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "operations": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "contains": {"const": "context"},
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$"}
        },
        "measurement_kind": {"const": "canonical_utf8_bytes_not_tokens"},
        "provider_observed_schema_tokens": {"type": "null"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_owns_threads", "common_task_families", "transport_seams",
        "requested_operations", "methods_observed", "deeplaw_session_store_created"
      ],
      "properties": {
        "host_owns_threads": {"const": true},
        "common_task_families": {
          "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
          "items": {"enum": ["cold_start", "resume_fork", "compaction_forget", "development_diagnostic"]}
        },
        "transport_seams": {
          "type": "array", "maxItems": 4, "uniqueItems": true,
          "items": {"enum": ["codex_app_server_jsonrpc", "codex_plugin_hook", "opencode_cli", "opencode_loopback_http", "opencode_project_plugin"]}
        },
        "requested_operations": {
          "type": "array", "maxItems": 20, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        },
        "methods_observed": {
          "type": "array", "maxItems": 40, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        },
        "deeplaw_session_store_created": {"const": false}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcp_child_closed_environment", "only_knowledge_support_enabled",
        "absolute_path_leak", "secret_leak", "raw_transcript_retained",
        "hidden_reasoning_retained", "authentication_material_retained", "cleanup_complete"
      ],
      "properties": {
        "mcp_child_closed_environment": {"type": "boolean"},
        "only_knowledge_support_enabled": {"type": "boolean"},
        "absolute_path_leak": {"type": "boolean"},
        "secret_leak": {"type": "boolean"},
        "raw_transcript_retained": {"const": false},
        "hidden_reasoning_retained": {"const": false},
        "authentication_material_retained": {"const": false},
        "cleanup_complete": {"type": "boolean"}
      }
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens", "cached_input_tokens", "cache_write_input_tokens",
        "output_tokens", "reasoning_output_tokens", "total_tokens"
      ],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/tokenValue"},
        "cached_input_tokens": {"$ref": "#/$defs/tokenValue"},
        "cache_write_input_tokens": {"$ref": "#/$defs/tokenValue"},
        "output_tokens": {"$ref": "#/$defs/tokenValue"},
        "reasoning_output_tokens": {"$ref": "#/$defs/tokenValue"},
        "total_tokens": {"$ref": "#/$defs/tokenValue"}
      }
    },
    "providerPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation", "provider_bytes", "provider_sha256", "structured_output_bytes",
        "structured_output_sha256", "delivery_match", "write_performed",
        "statement_count", "gap_count", "gap_codes", "relevant_chars",
        "context_chars", "relevant_chars_context_chars", "evidence_count",
        "duplicate_evidence_count", "duplicate_evidence_rate"
      ],
      "properties": {
        "operation": {"enum": ["context", "query", "resolve-host-continuity"]},
        "provider_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "provider_sha256": {"$ref": "#/$defs/sha256"},
        "structured_output_bytes": {
          "type": ["integer", "null"], "minimum": 1, "maximum": 262144
        },
        "structured_output_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "delivery_match": {"const": true},
        "write_performed": {"const": false},
        "statement_count": {"type": "integer", "minimum": 0},
        "gap_count": {"type": "integer", "minimum": 0},
        "gap_codes": {
          "type": "array", "maxItems": 20, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,99}$"}
        },
        "relevant_chars": {"type": "integer", "minimum": 0},
        "context_chars": {"type": "integer", "minimum": 0},
        "relevant_chars_context_chars": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence_count": {"type": "integer", "minimum": 0},
        "duplicate_evidence_count": {"type": "integer", "minimum": 0},
        "duplicate_evidence_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "conflict_count": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "safeRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_count", "first_call_valid", "bounded_retry_used", "safe_read_operations", "provider_payloads"],
      "properties": {
        "call_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "first_call_valid": {"type": "boolean"},
        "bounded_retry_used": {"type": "boolean"},
        "safe_read_operations": {
          "type": "array", "maxItems": 2,
          "items": {"enum": ["context", "query", "resolve-host-continuity"]}
        },
        "provider_payloads": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/providerPayload"}}
      }
    },
    "identityLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_sha256", "parent_sha256", "root_sha256", "relation"],
      "properties": {
        "current_sha256": {"$ref": "#/$defs/sha256"},
        "parent_sha256": {"$ref": "#/$defs/nullableSha256"},
        "root_sha256": {"$ref": "#/$defs/sha256"},
        "relation": {"enum": ["new", "resume", "fork", "same_session"]}
      }
    },
    "nativeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_task_family", "transport", "request_seam", "requested_operation",
        "sanitized_request", "observation_kind", "methods_observed",
        "sanitized_raw_observation",
        "identity_lineage", "actual_provider_usage", "claim_eligible"
      ],
      "properties": {
        "semantic_task_family": {"enum": ["cold_start", "resume_fork", "compaction_forget", "development_diagnostic"]},
        "transport": {"enum": ["codex_app_server_jsonrpc", "codex_plugin_hook", "opencode_cli", "opencode_loopback_http", "opencode_project_plugin"]},
        "request_seam": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/{} -]{0,199}$"},
        "requested_operation": {"type": "string", "minLength": 1, "maxLength": 100},
        "sanitized_request": {"$ref": "#/$defs/digest"},
        "observation_kind": {
          "enum": ["native_response", "native_event", "cli_json_record"]
        },
        "methods_observed": {
          "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        },
        "sanitized_raw_observation": {"$ref": "#/$defs/digest"},
        "identity_lineage": {"$ref": "#/$defs/identityLineage"},
        "actual_provider_usage": {
          "oneOf": [
            {"$ref": "#/$defs/tokenUsage"},
            {"type": "null"}
          ]
        },
        "claim_eligible": {"const": false}
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "passed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "ledger_unchanged": {"const": true},
              "safe_read": {
                "properties": {
                  "call_count": {"minimum": 0},
                  "first_call_valid": {"const": true},
                  "safe_read_operations": {"minItems": 1},
                  "provider_payloads": {"minItems": 1}
                }
              }
            }
          }
        }
      ],
      "required": [
        "status", "lifecycle_method", "thread_id_sha256", "turn_id_sha256",
        "prompt_sha256", "final_response_sha256", "final_response_bytes",
        "host_elapsed_ms", "usage", "ledger_audit_head_before",
        "ledger_audit_head_after", "ledger_unchanged", "safe_read", "sanitized_events"
      ],
      "properties": {
        "status": {"enum": ["passed", "failed"]},
        "lifecycle_method": {"type": "string", "minLength": 1, "maxLength": 100},
        "thread_id_sha256": {"$ref": "#/$defs/nullableSha256"},
        "turn_id_sha256": {"$ref": "#/$defs/nullableSha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "final_response_sha256": {"$ref": "#/$defs/nullableSha256"},
        "final_response_bytes": {"type": "integer", "minimum": 0},
        "host_elapsed_ms": {"type": "integer", "minimum": 0},
        "usage": {"$ref": "#/$defs/tokenUsage"},
        "actual_response_provider_id": {
          "type": ["string", "null"], "minLength": 1, "maxLength": 100
        },
        "actual_response_model_id": {
          "type": ["string", "null"], "minLength": 1, "maxLength": 200
        },
        "actual_response_model_receipt": {"$ref": "#/$defs/digest"},
        "host_continuity_capsule": {
          "oneOf": [
            {"$ref": "#/$defs/continuityObservation"},
            {"type": "null"}
          ]
        },
        "ledger_audit_head_before": {"$ref": "#/$defs/sha256"},
        "ledger_audit_head_after": {"$ref": "#/$defs/sha256"},
        "ledger_unchanged": {"type": "boolean"},
        "safe_read": {"$ref": "#/$defs/safeRead"},
        "sanitized_events": {"$ref": "#/$defs/artifact"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_correct_action", "decision_preservation", "wrong_state_admission",
        "stale_state_rejected", "forgotten_state_admission", "gap_observed",
        "projection_state_correct", "retention_wording_correct",
        "provider_boundary_correct", "evidence_sha256"
      ],
      "properties": {
        "first_correct_action": {"type": ["boolean", "null"]},
        "decision_preservation": {"type": ["boolean", "null"]},
        "wrong_state_admission": {"type": ["integer", "null"], "minimum": 0},
        "stale_state_rejected": {"type": ["boolean", "null"]},
        "forgotten_state_admission": {"type": ["integer", "null"], "minimum": 0},
        "gap_observed": {"type": ["boolean", "null"]},
        "projection_state_correct": {"type": ["boolean", "null"]},
        "retention_wording_correct": {"type": ["boolean", "null"]},
        "provider_boundary_correct": {"type": ["boolean", "null"]},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mutationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "owner_enabled", "read_mcp_write_performed", "audit_changed",
        "audit_head_before", "audit_head_after", "receipt_sha256", "target_sha256"
      ],
      "properties": {
        "kind": {"enum": ["none", "seed_checkpoint", "forget"]},
        "owner_enabled": {"type": "boolean"},
        "read_mcp_write_performed": {"const": false},
        "audit_changed": {"type": "boolean"},
        "audit_head_before": {"$ref": "#/$defs/sha256"},
        "audit_head_after": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
        "target_sha256": {"$ref": "#/$defs/nullableSha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "none"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "owner_enabled": {"const": false},
              "audit_changed": {"const": false},
              "receipt_sha256": {"type": "null"},
              "target_sha256": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "owner_enabled": {"const": true},
              "audit_changed": {"const": true},
              "receipt_sha256": {"$ref": "#/$defs/sha256"},
              "target_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "passed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "methods_observed": {"minItems": 1},
              "native_receipts": {"minItems": 1}
            }
          }
        }
      ],
      "required": [
        "run_index", "scenario", "task_family", "status", "failure_codes",
        "task_sha256", "new_thread", "methods_observed", "native_receipts",
        "turns", "metrics", "mutation_boundaries"
      ],
      "properties": {
        "run_index": {"type": "integer", "minimum": 1, "maximum": 3},
        "scenario": {"enum": ["cold_start", "resume_fork", "compaction_forget", "development_diagnostic"]},
        "task_family": {"enum": ["cold_start", "resume_fork", "compaction_forget", "development_diagnostic"]},
        "status": {"enum": ["passed", "failed"]},
        "failure_codes": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        },
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "new_thread": {"type": "boolean"},
        "methods_observed": {
          "type": "array", "maxItems": 40, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        },
        "native_receipts": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/nativeReceipt"}},
        "plugin_receipt": {"$ref": "#/$defs/pluginReceipt"},
        "route_receipts": {
          "type": "array", "maxItems": 4,
          "items": {"$ref": "#/$defs/routeReceipt"}
        },
        "turns": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/turn"}},
        "metrics": {"$ref": "#/$defs/metrics"},
        "mutation_boundaries": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/mutationBoundary"}}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed_runs", "failed_runs", "first_call_valid_runs", "bounded_retry_runs",
        "provider_bytes", "input_tokens", "cached_input_tokens",
        "cache_write_input_tokens", "output_tokens", "reasoning_output_tokens",
        "total_tokens", "host_elapsed_ms"
      ],
      "properties": {
        "passed_runs": {"type": "integer", "minimum": 0, "maximum": 3},
        "failed_runs": {"type": "integer", "minimum": 0, "maximum": 3},
        "first_call_valid_runs": {"type": "integer", "minimum": 0, "maximum": 3},
        "bounded_retry_runs": {"type": "integer", "minimum": 0, "maximum": 3},
        "provider_bytes": {"type": "integer", "minimum": 0},
        "input_tokens": {"$ref": "#/$defs/tokenValue"},
        "cached_input_tokens": {"$ref": "#/$defs/tokenValue"},
        "cache_write_input_tokens": {"$ref": "#/$defs/tokenValue"},
        "output_tokens": {"$ref": "#/$defs/tokenValue"},
        "reasoning_output_tokens": {"$ref": "#/$defs/tokenValue"},
        "total_tokens": {"$ref": "#/$defs/tokenValue"},
        "host_elapsed_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
