{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/living-wiki-quality-comparison-failure.v1.schema.json",
  "title": "DeepLaw Living Wiki failed comparison receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "failure_code",
    "inputs",
    "functional_comparisons",
    "performance_comparisons",
    "quality_regression",
    "performance_regression",
    "passed",
    "competitive_claim_eligible",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "deeplaw.living-wiki-quality-comparison-failure/v1"
    },
    "failure_code": {
      "enum": [
        "candidate_gate_incomplete",
        "frozen_experiment_mismatch",
        "functional_quality_regression",
        "performance_regression",
        "source_inventory_invalid",
        "source_inventory_missing"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "$ref": "#/$defs/baseline_input" },
        { "$ref": "#/$defs/candidate_input" }
      ],
      "items": false
    },
    "functional_comparisons": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/comparison" }
    },
    "performance_comparisons": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/comparison" }
    },
    "quality_regression": { "type": "boolean" },
    "performance_regression": { "type": "boolean" },
    "passed": { "const": false },
    "competitive_claim_eligible": { "const": false },
    "record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "relative_path",
        "byte_size",
        "file_sha256",
        "report_record_sha256"
      ],
      "properties": {
        "role": { "enum": ["baseline", "candidate"] },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\]+$"
        },
        "byte_size": { "type": "integer", "minimum": 1 },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "report_record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "baseline_input": {
      "allOf": [
        { "$ref": "#/$defs/input" },
        { "properties": { "role": { "const": "baseline" } } }
      ]
    },
    "candidate_input": {
      "allOf": [
        { "$ref": "#/$defs/input" },
        { "properties": { "role": { "const": "candidate" } } }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "baseline",
        "candidate",
        "direction",
        "tolerance",
        "passed"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "baseline": { "type": "number" },
        "candidate": { "type": "number" },
        "direction": {
          "enum": ["higher_or_equal", "lower_or_equal"]
        },
        "tolerance": { "type": "number", "minimum": 0 },
        "passed": { "type": "boolean" }
      }
    }
  }
}
