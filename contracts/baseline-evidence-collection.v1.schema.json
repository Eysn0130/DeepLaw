{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/baseline-evidence-collection.v1.schema.json",
  "title": "DeepLaw official-baseline evidence collection manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "collection_id", "registry_sha256", "runs", "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.baseline-evidence-collection/v1"},
    "collection_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "runs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system_id", "plan_path", "receipt_path"],
        "properties": {
          "system_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "plan_path": {"$ref": "#/$defs/path"},
          "receipt_path": {"$ref": "#/$defs/path"}
        }
      }
    },
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096}
  }
}
