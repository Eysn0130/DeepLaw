{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/synthesis-query-evidence-receipt.v1.schema.json",
  "title": "DeepLaw Provider-Visible Synthesis Evidence Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "synthesis_revision_id", "input_set_sha256",
    "source_revision_ids", "source_refs", "complete", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.synthesis-query-evidence-receipt/v1"},
    "synthesis_revision_id": {
      "type": "string", "pattern": "^knowledgerev_[0-9a-f]{24}$"
    },
    "input_set_sha256": {"$ref": "#/$defs/sha256"},
    "source_revision_ids": {
      "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"}
    },
    "source_refs": {
      "type": "array", "maxItems": 8, "uniqueItems": true,
      "items": {"$ref": "#/$defs/source_ref"}
    },
    "complete": {"type": "boolean"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision_id", "locator", "quote_sha256"],
      "properties": {
        "source_revision_id": {
          "type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"
        },
        "fragment_id": {
          "type": "string", "pattern": "^fragment_[0-9a-f]{24}$"
        },
        "fragment_revision_id": {
          "type": "string", "pattern": "^irfragment_[0-9a-f]{24}$"
        },
        "locator": {"type": "string", "minLength": 1, "maxLength": 2000},
        "quote_sha256": {"$ref": "#/$defs/sha256"},
        "reference_sha256": {"$ref": "#/$defs/sha256"},
        "metadata_omitted": {"type": "boolean"}
      },
      "oneOf": [
        {"required": ["fragment_id"], "not": {"required": ["fragment_revision_id"]}},
        {"required": ["fragment_revision_id"], "not": {"required": ["fragment_id"]}}
      ]
    }
  }
}
