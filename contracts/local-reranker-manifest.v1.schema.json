{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/local-reranker-manifest.v1.schema.json",
  "title": "DeepLaw closed offline local reranker manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "implementation_revision", "model_identity", "model_revision",
    "model_files", "command", "network_policy", "max_candidates", "max_input_chars",
    "max_output_bytes", "timeout_seconds"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.local-reranker-manifest/v1"},
    "implementation_revision": {"type": "string", "minLength": 1, "maxLength": 500},
    "model_identity": {"type": "string", "minLength": 1, "maxLength": 500},
    "model_revision": {"type": "string", "minLength": 1, "maxLength": 500},
    "model_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 2000},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "network_policy": {"const": "offline"},
    "max_candidates": {"type": "integer", "minimum": 1, "maximum": 100},
    "max_input_chars": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
  }
}
