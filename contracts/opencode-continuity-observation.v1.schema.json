{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/opencode-continuity-observation.v1.schema.json",
  "title": "DeepLaw OpenCode Continuity Candidate Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "release_ready",
    "claim_eligible",
    "binding",
    "environment",
    "candidate",
    "host",
    "security",
    "host_preflight",
    "capsule_preflight",
    "runs",
    "aggregate",
    "not_executed"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.opencode-continuity-observation/v1"},
    "status": {"enum": ["executed", "failed"]},
    "release_ready": {"const": false},
    "claim_eligible": {"const": false},
    "binding": {"$ref": "#/$defs/binding"},
    "environment": {"$ref": "#/$defs/environment"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "host": {"$ref": "#/$defs/host"},
    "security": {"$ref": "#/$defs/security"},
    "host_preflight": {"$ref": "#/$defs/hostPreflight"},
    "capsule_preflight": {"type": "object", "minProperties": 10, "maxProperties": 24},
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/run"}
    },
    "aggregate": {"$ref": "#/$defs/aggregate"},
    "not_executed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "package_version",
        "worktree_clean",
        "candidate_wheel_name",
        "candidate_wheel_sha256"
      ],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package_version": {"const": "0.12.0"},
        "worktree_clean": {"const": true},
        "candidate_wheel_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\.whl$"
        },
        "candidate_wheel_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating_system", "architecture", "python_version"],
      "properties": {
        "operating_system": {"type": "string", "minLength": 1, "maxLength": 100},
        "architecture": {"type": "string", "minLength": 1, "maxLength": 100},
        "python_version": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "configuration_sha256",
        "case_id",
        "task_sha256",
        "task_binding_sha256"
      ],
      "properties": {
        "name": {"const": "continuity-task-suite-v1.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "case_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "task_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source",
        "auth_store_read",
        "credential_value_recorded"
      ],
      "properties": {
        "status": {"const": "environment_only"},
        "source": {"const": "isolated_dotenv_parser"},
        "auth_store_read": {"const": false},
        "credential_value_recorded": {"const": false}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary_name",
        "binary_sha256",
        "version",
        "package_name",
        "package_tarball_sha256",
        "package_tarball_sha1",
        "registry_tarball",
        "official_source",
        "source_commit",
        "model",
        "variant",
        "authentication",
        "argv",
        "argv_sha256",
        "mcp_argv",
        "enabled_tools",
        "host_environment_names"
      ],
      "properties": {
        "binary_name": {"const": "opencode"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "version": {"const": "1.18.16"},
        "package_name": {"const": "opencode-ai"},
        "package_tarball_sha256": {"const": "1e0ac00a7dafd5e7c22d468ce7e088ae329dc02abb48b52581cf1c63fb2c3ffd"},
        "package_tarball_sha1": {"const": "303d2f3f307d55716a2a203633fab24635468b63"},
        "registry_tarball": {"const": "https://registry.npmjs.org/opencode-ai/-/opencode-ai-1.18.16.tgz"},
        "official_source": {"const": "https://github.com/anomalyco/opencode"},
        "source_commit": {"const": "a3647eb025c7615159d417dcc49fc39fdaeba65b"},
        "model": {"const": "deepseek/deepseek-v4-flash"},
        "variant": {"const": "max"},
        "authentication": {"$ref": "#/$defs/authentication"},
        "argv": {
          "type": "array",
          "minItems": 10,
          "maxItems": 30,
          "items": {"type": "string", "maxLength": 200}
        },
        "argv_sha256": {"$ref": "#/$defs/sha256"},
        "mcp_argv": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {"type": "string", "maxLength": 200}
        },
        "enabled_tools": {"const": ["knowledge_support"]},
        "host_environment_names": {
          "type": "array",
          "minItems": 14,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "share_disabled",
        "snapshot_disabled",
        "autoupdate_disabled",
        "plugins_disabled",
        "subagents_disabled",
        "host_state_removed",
        "host_closed_environment",
        "mcp_child_closed_environment",
        "provider_capsule_clean",
        "provider_internal_surface_leak",
        "event_receipts_clean",
        "report_clean",
        "absolute_path_leak",
        "secret_leak",
        "credential_path_forwarded",
        "mcp_wrapper_sha256"
      ],
      "properties": {
        "share_disabled": {"const": true},
        "snapshot_disabled": {"const": true},
        "autoupdate_disabled": {"const": true},
        "plugins_disabled": {"const": true},
        "subagents_disabled": {"const": true},
        "host_state_removed": {"const": true},
        "host_closed_environment": {"type": "boolean"},
        "mcp_child_closed_environment": {"type": "boolean"},
        "provider_capsule_clean": {"type": "boolean"},
        "provider_internal_surface_leak": {"type": "boolean"},
        "event_receipts_clean": {"type": "boolean"},
        "report_clean": {"const": true},
        "absolute_path_leak": {"type": "boolean"},
        "secret_leak": {"type": "boolean"},
        "credential_path_forwarded": {"type": "boolean"},
        "mcp_wrapper_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "hostPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "version",
        "model",
        "variant",
        "managed_config_loaded",
        "user_global_config_loaded",
        "organization_config_loaded",
        "external_plugins_loaded",
        "resolved_configuration_sha256"
      ],
      "properties": {
        "status": {"const": "passed"},
        "version": {"const": "1.18.16"},
        "model": {"const": "deepseek/deepseek-v4-flash"},
        "variant": {"const": "max"},
        "managed_config_loaded": {"const": false},
        "user_global_config_loaded": {"const": false},
        "organization_config_loaded": {"const": false},
        "external_plugins_loaded": {"const": false},
        "resolved_configuration_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "input_tokens",
        "cached_input_tokens",
        "cache_write_tokens",
        "output_tokens",
        "reasoning_tokens",
        "total_tokens",
        "cost_usd"
      ],
      "properties": {
        "status": {"enum": ["provider_reported", "unreported"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_index",
        "status",
        "exit_status",
        "latency_ms",
        "prompt_sha256",
        "actual_event_receipt",
        "usage",
        "environment_receipt",
        "host_output",
        "provider_capsule",
        "provider_internal_surface_leak",
        "provider_bytes",
        "ledger_audit_head_before",
        "ledger_audit_head_after",
        "ledger_unchanged",
        "secret_leak",
        "absolute_path_leak",
        "failure_class",
        "failure_summary"
      ],
      "properties": {
        "run_index": {"const": 1},
        "status": {"enum": ["passed", "failed"]},
        "exit_status": {"type": ["integer", "null"]},
        "latency_ms": {"type": "integer", "minimum": 0},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "actual_event_receipt": {"type": "object", "minProperties": 8, "maxProperties": 16},
        "usage": {"$ref": "#/$defs/usage"},
        "environment_receipt": {"type": ["object", "null"], "maxProperties": 12},
        "host_output": {"type": ["object", "null"], "maxProperties": 8},
        "provider_capsule": {"type": ["object", "null"], "maxProperties": 16},
        "provider_internal_surface_leak": {"type": "boolean"},
        "provider_bytes": {"type": "integer", "minimum": 0, "maximum": 4194304},
        "ledger_audit_head_before": {"$ref": "#/$defs/sha256"},
        "ledger_audit_head_after": {"$ref": "#/$defs/sha256"},
        "ledger_unchanged": {"type": "boolean"},
        "secret_leak": {"type": "boolean"},
        "absolute_path_leak": {"type": "boolean"},
        "failure_class": {"type": ["string", "null"], "maxLength": 100},
        "failure_summary": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed_runs",
        "failed_runs",
        "actual_input_tokens",
        "actual_cached_input_tokens",
        "actual_cache_write_tokens",
        "actual_output_tokens",
        "actual_reasoning_tokens",
        "actual_total_tokens",
        "actual_cost_usd",
        "latency_ms",
        "candidate_execution_complete"
      ],
      "properties": {
        "passed_runs": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed_runs": {"type": "integer", "minimum": 0, "maximum": 1},
        "actual_input_tokens": {"type": "integer", "minimum": 0},
        "actual_cached_input_tokens": {"type": "integer", "minimum": 0},
        "actual_cache_write_tokens": {"type": "integer", "minimum": 0},
        "actual_output_tokens": {"type": "integer", "minimum": 0},
        "actual_reasoning_tokens": {"type": "integer", "minimum": 0},
        "actual_total_tokens": {"type": "integer", "minimum": 0},
        "actual_cost_usd": {"type": "number", "minimum": 0},
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max", "mean"],
          "properties": {
            "min": {"type": "integer", "minimum": 0},
            "max": {"type": "integer", "minimum": 0},
            "mean": {"type": "number", "minimum": 0}
          }
        },
        "candidate_execution_complete": {"type": "boolean"}
      }
    }
  }
}
