{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/provenance-bound-gate-result.v3.schema.json",
  "title": "DeepLaw current provenance-bound commercial Gate Result v3",
  "description": "Current-only Gate receipt bound to the canonical v7 classification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "qualification_run_id", "gate_id", "category", "validator_id", "validator_version",
    "validator_source", "validator_executable", "classification_binding",
    "candidate_binding", "protocol_binding", "threshold_binding", "gold_binding",
    "corpus", "status", "executions", "run_ids", "metrics",
    "hard_failures", "inputs", "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.provenance-bound-gate-result/v3"},
    "qualification_run_id": {"type": "integer", "minimum": 1},
    "gate_id": {"$ref": "#/$defs/identifier"},
    "category": {"$ref": "#/$defs/category"},
    "validator_id": {"$ref": "#/$defs/identifier"},
    "validator_version": {"$ref": "#/$defs/version"},
    "validator_source": {"$ref": "#/$defs/validatorFileBinding"},
    "validator_executable": {"$ref": "#/$defs/validatorFileBinding"},
    "classification_binding": {"$ref": "#/$defs/classificationBinding"},
    "candidate_binding": {"$ref": "#/$defs/candidateBinding"},
    "protocol_binding": {"$ref": "#/$defs/protocolBinding"},
    "threshold_binding": {"$ref": "#/$defs/thresholdBinding"},
    "gold_binding": {"$ref": "#/$defs/goldBinding"},
    "corpus": {"$ref": "#/$defs/corpus"},
    "status": {"$ref": "#/$defs/status"},
    "executions": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/execution"}},
    "run_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "metrics": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/metric"}},
    "hard_failures": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/hardFailure"}},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/inputProvenance"}},
    "result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,512}$"},
    "category": {"type": "string", "enum": ["Core", "Capability", "Competitive Claim"]},
    "status": {"enum": ["passed", "failed", "not_applicable", "not_executed", "not_claimed"]},
    "classificationBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["classification_id", "classification_schema_version", "classification_sha256"],
      "properties": {
        "classification_id": {"const": "deeplaw-v013-commercial-gates-v7"},
        "classification_schema_version": {"const": "deeplaw.v013-release-gate-classification/v7"},
        "classification_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_commit", "candidate_tree", "candidate_wheel_sha256", "candidate_sdist_sha256"],
      "properties": {
        "candidate_commit": {"$ref": "#/$defs/git"},
        "candidate_tree": {"$ref": "#/$defs/git"},
        "candidate_wheel_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sdist_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protocolBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_id", "protocol_sha256", "frozen"],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/identifier"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "frozen": {"const": true}
      }
    },
    "thresholdBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["threshold_id", "threshold_sha256", "frozen"],
      "properties": {
        "threshold_id": {"$ref": "#/$defs/identifier"},
        "threshold_sha256": {"$ref": "#/$defs/sha256"},
        "frozen": {"const": true}
      }
    },
    "goldBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["gold_sha256", "role", "source", "frozen"],
      "properties": {
        "gold_sha256": {"$ref": "#/$defs/sha256"},
        "role": {"enum": ["development_gold", "qualification_gold", "final_blind_gold"]},
        "source": {"enum": ["repository", "repository_external"]},
        "frozen": {"const": true}
      }
    },
    "corpus": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "source", "sha256", "frozen"],
      "properties": {
        "role": {"enum": ["candidate_full", "development", "qualification_holdout", "final_blind"]},
        "source": {"enum": ["repository", "repository_external"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "frozen": {"const": true}
      }
    },
    "validatorFileBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "byte_size", "file_sha256"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "byte_size": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "workflow_run_id", "input_refs", "evidence_kind"],
      "properties": {
        "run_id": {"$ref": "#/$defs/identifier"},
        "workflow_run_id": {"type": "integer", "minimum": 1},
        "input_refs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "evidence_kind": {"$ref": "#/$defs/typedEvidenceKind"}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "observed", "input_refs"],
      "properties": {
        "metric": {"$ref": "#/$defs/identifier"},
        "observed": {},
        "input_refs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "hardFailure": {
      "type": "object", "additionalProperties": false,
      "required": ["failure_id", "count", "maximum_allowed", "input_refs"],
      "properties": {
        "failure_id": {"$ref": "#/$defs/identifier"}, "count": {"type": "integer", "minimum": 0},
        "maximum_allowed": {"const": 0}, "input_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "typedEvidenceKind": {
      "enum": [
        "candidate_full_junit", "candidate_platform_receipt", "host_event_sequence",
        "exact_wheel_execution", "human_gold_scorer", "legal_rows", "wiki_journey_rows",
        "context_capsule_selection_usage", "scale_report", "retained_supply_chain"
      ]
    },
    "inputProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["input_id", "relative_path", "byte_size", "file_sha256", "schema_version", "record_sha256", "artifact_kind", "evidence_kind", "derived_record_sha256"],
      "properties": {
        "input_id": {"$ref": "#/$defs/identifier"}, "relative_path": {"$ref": "#/$defs/relativePath"},
        "byte_size": {"type": "integer", "minimum": 1, "maximum": 67108864}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "deeplaw.typed-qualification-evidence/v1"},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_kind": {"const": "typed-qualification-evidence"},
        "evidence_kind": {"$ref": "#/$defs/typedEvidenceKind"},
        "derived_record_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
