{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/knowledge-capsule.v3.schema.json",
  "title": "DeepLaw Autonomous Knowledge Capsule v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "vault_id", "task", "goal", "task_binding", "as_of", "purpose", "policy_id",
    "query_plan", "query_plan_sha256", "statements", "evidence", "contradictions",
    "gaps", "receipt_id", "budget", "audit", "audit_head", "created_at",
    "write_performed", "provider_capsule", "capsule_id", "capsule_digest"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.knowledge-capsule/v3"},
    "vault_id": {"type": "string", "pattern": "^vault_[0-9a-f]{24}$"},
    "task": {"type": "string", "minLength": 1, "maxLength": 5000},
    "goal": {"type": ["string", "null"], "maxLength": 2000},
    "task_binding": {
      "oneOf": [
        {"$ref": "task-context-binding.v1.schema.json"},
        {"type": "null"}
      ]
    },
    "as_of": {"type": ["string", "null"], "format": "date-time"},
    "purpose": {
      "enum": ["answer", "verify", "quote", "historical", "legal", "debug", "freshness_check"]
    },
    "policy_id": {
      "enum": ["compiled-first-v1", "evidence-first-v1", "balanced-v1"]
    },
    "query_plan": {
      "type": "object",
      "required": ["schema_version", "receipt_id"],
      "properties": {
        "schema_version": {"const": "deeplaw.knowledge-query-plan/v6"},
        "receipt_id": {"type": "string", "pattern": "^queryreceipt_[0-9a-f]{24}$"}
      }
    },
    "query_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "statements": {"type": "array", "maxItems": 20, "items": {"type": "object"}},
    "evidence": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
    "contradictions": {"type": "array", "maxItems": 20, "items": {"type": "object"}},
    "gaps": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
    "receipt_id": {"type": "string", "pattern": "^queryreceipt_[0-9a-f]{24}$"},
    "budget": {"$ref": "#/$defs/budget"},
    "audit": {"$ref": "#/$defs/audit"},
    "audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "write_performed": {"const": false},
    "provider_capsule": {"$ref": "#/$defs/provider_capsule"},
    "capsule_id": {"type": "string", "pattern": "^capsule_[0-9a-f]{24}$"},
    "capsule_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_items", "selected_items", "max_characters", "selected_characters",
        "max_tokens", "max_provider_characters", "provider_payload_bytes",
        "local_payload_hard_limit_bytes"
      ],
      "properties": {
        "max_items": {"type": "integer", "minimum": 1, "maximum": 20},
        "selected_items": {"type": "integer", "minimum": 0, "maximum": 52},
        "max_characters": {"type": "integer", "minimum": 200, "maximum": 20000},
        "selected_characters": {"type": "integer", "minimum": 0},
        "max_tokens": {"type": "integer", "minimum": 128, "maximum": 32000},
        "max_provider_characters": {"const": 65536},
        "provider_payload_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "local_payload_hard_limit_bytes": {"const": 262144}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "receipt_id", "query_plan_sha256", "query_sha256",
        "input_audit_head", "input_legacy_audit_head", "candidate_count",
        "admitted_statement_count", "selected_statement_ids", "fallback_count",
        "deduplication_count", "suppression_count", "rejection_count",
        "residual_gap_ids", "ranking_authority_changed", "write_performed"
      ],
      "properties": {
        "schema_version": {"const": "deeplaw.query-audit-summary/v1"},
        "receipt_id": {"type": "string", "pattern": "^queryreceipt_[0-9a-f]{24}$"},
        "query_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_legacy_audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_count": {"type": "integer", "minimum": 0},
        "admitted_statement_count": {"type": "integer", "minimum": 0, "maximum": 512},
        "selected_statement_ids": {
          "type": "array", "maxItems": 20, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "fallback_count": {"type": "integer", "minimum": 0, "maximum": 12},
        "deduplication_count": {"type": "integer", "minimum": 0},
        "suppression_count": {"type": "integer", "minimum": 0},
        "rejection_count": {"type": "integer", "minimum": 0},
        "residual_gap_ids": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "ranking_authority_changed": {"const": false},
        "write_performed": {"const": false}
      }
    },
    "provider_capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "purpose", "policy_id", "capsule", "receipt", "delivery"],
      "properties": {
        "schema_version": {"const": "deeplaw.provider-knowledge-capsule/v2"},
        "purpose": {
          "enum": ["answer", "verify", "quote", "historical", "legal", "debug", "freshness_check"]
        },
        "policy_id": {"enum": ["compiled-first-v1", "evidence-first-v1", "balanced-v1"]},
        "capsule": {"type": "object"},
        "receipt": {
          "type": "object", "additionalProperties": false,
          "required": ["receipt_id"],
          "properties": {
            "receipt_id": {"type": "string", "pattern": "^queryreceipt_[0-9a-f]{24}$"}
          }
        },
        "delivery": {
          "type": "object", "additionalProperties": false,
          "required": ["hard_limit_bytes", "provider_content_bytes", "projection", "write_performed"],
          "properties": {
            "hard_limit_bytes": {"const": 65536},
            "provider_content_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
            "projection": {"enum": ["compact", "standard"]},
            "write_performed": {"const": false}
          }
        }
      }
    }
  }
}
