{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/source-knowledge-status.v1.schema.json",
  "title": "DeepLaw Source Knowledge Status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "state", "source_registered", "compilation_required",
    "compiled", "canonical_knowledge_committed", "canonical_knowledge_admissible",
    "wiki_projection_status", "wiki_projection_pending", "wiki_projection_ready",
    "stale_or_blocked", "gap", "source_revision_ids",
    "latest_compilation_attempts", "successful_compilation_run_ids",
    "projection_pending_compilation_run_ids"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.source-knowledge-status/v1"},
    "state": {
      "enum": ["compilation_required", "compiled", "stale_or_blocked", "gap"]
    },
    "source_registered": {"type": "boolean"},
    "compilation_required": {"type": "boolean"},
    "compiled": {"type": "boolean"},
    "canonical_knowledge_committed": {"type": "boolean"},
    "canonical_knowledge_admissible": {"type": "boolean"},
    "wiki_projection_status": {
      "enum": ["unavailable", "not_started", "pending", "ready", "blocked"]
    },
    "wiki_projection_pending": {"type": "boolean"},
    "wiki_projection_ready": {"type": "boolean"},
    "stale_or_blocked": {"type": "boolean"},
    "gap": {"type": "boolean"},
    "source_revision_ids": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"}
    },
    "latest_compilation_attempts": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_revision_id", "compilation_run_id", "status"],
        "properties": {
          "source_revision_id": {
            "type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"
          },
          "compilation_run_id": {
            "type": "string", "pattern": "^compilationrun_[0-9a-f]{24}$"
          },
          "status": {
            "enum": [
              "planned", "staging", "validating", "ready_to_commit",
              "committed", "projection_pending", "succeeded", "failed", "aborted"
            ]
          }
        }
      }
    },
    "successful_compilation_run_ids": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^compilationrun_[0-9a-f]{24}$"}
    },
    "projection_pending_compilation_run_ids": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^compilationrun_[0-9a-f]{24}$"}
    }
  }
}
