{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/semantic-quality-report.v1.schema.json",
  "title": "DeepLaw Semantic Quality Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "gold_id", "gold_sha256", "host_report_id",
    "host_report_sha256", "host", "host_version", "model_identity", "evaluated_at",
    "metrics", "thresholds", "hard_failures", "case_results", "failure_cases",
    "manual_review", "passed", "formal_release_eligible", "competitive_claim_eligible",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.semantic-quality-report/v1"},
    "report_id": {"type": "string", "pattern": "^semanticquality_[0-9a-f]{24}$"},
    "gold_id": {"type": "string", "pattern": "^semanticgold_[0-9a-f]{24}$"},
    "gold_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "host_report_id": {"type": "string", "pattern": "^semantichostrun_[0-9a-f]{24}$"},
    "host_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "host": {"enum": ["codex", "claude_code", "opencode"]},
    "host_version": {"type": "string", "minLength": 1, "maxLength": 500},
    "model_identity": {"type": "string", "minLength": 1, "maxLength": 500},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "hard_failures": {"$ref": "#/$defs/hard_failures"},
    "case_results": {
      "type": "array", "minItems": 15, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "task_type", "status", "matched_label_ids", "missing_label_ids", "notes"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^semantic-case-[0-9]{2}$"},
          "task_type": {"type": "string", "minLength": 1, "maxLength": 100},
          "status": {"enum": ["passed", "failed", "not_measurable"]},
          "matched_label_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^label-[a-z0-9-]+$"}},
          "missing_label_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^label-[a-z0-9-]+$"}},
          "notes": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    },
    "failure_cases": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "manual_review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "correction_count", "correction_time_seconds", "reviewer_id"],
      "properties": {
        "status": {"enum": ["recorded", "not_recorded"]},
        "correction_count": {"type": ["integer", "null"], "minimum": 0},
        "correction_time_seconds": {"type": ["number", "null"], "minimum": 0},
        "reviewer_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200}
      }
    },
    "passed": {"type": "boolean"},
    "formal_release_eligible": {"type": "boolean"},
    "competitive_claim_eligible": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
  },
  "$defs": {
    "ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": [
        "entity_canonicalization_precision", "entity_recall", "wrong_merge_count",
        "duplicate_identity_count", "concept_fusion_precision", "concept_fusion_recall",
        "source_summary_supported_claim_rate", "unsupported_claim_rate",
        "claim_evidence_binding_accuracy", "contradiction_precision", "contradiction_recall",
        "procedure_step_fidelity", "event_temporal_fidelity", "source_coverage",
        "cross_packet_consistency", "synthesis_groundedness",
        "update_propagation_correctness", "stale_withdrawal_prevention",
        "failure_recovery_rate", "build_tokens", "query_tokens"
      ],
      "properties": {
        "entity_canonicalization_precision": {"$ref": "#/$defs/ratio"},
        "entity_recall": {"$ref": "#/$defs/ratio"},
        "wrong_merge_count": {"type": "integer", "minimum": 0},
        "duplicate_identity_count": {"type": "integer", "minimum": 0},
        "concept_fusion_precision": {"$ref": "#/$defs/ratio"},
        "concept_fusion_recall": {"$ref": "#/$defs/ratio"},
        "source_summary_supported_claim_rate": {"$ref": "#/$defs/ratio"},
        "unsupported_claim_rate": {"$ref": "#/$defs/ratio"},
        "claim_evidence_binding_accuracy": {"$ref": "#/$defs/ratio"},
        "contradiction_precision": {"$ref": "#/$defs/ratio"},
        "contradiction_recall": {"$ref": "#/$defs/ratio"},
        "procedure_step_fidelity": {"$ref": "#/$defs/ratio"},
        "event_temporal_fidelity": {"$ref": "#/$defs/ratio"},
        "source_coverage": {"$ref": "#/$defs/ratio"},
        "cross_packet_consistency": {"$ref": "#/$defs/ratio"},
        "synthesis_groundedness": {"$ref": "#/$defs/ratio"},
        "update_propagation_correctness": {"$ref": "#/$defs/ratio"},
        "stale_withdrawal_prevention": {"$ref": "#/$defs/ratio"},
        "failure_recovery_rate": {"$ref": "#/$defs/ratio"},
        "build_tokens": {"type": ["integer", "null"], "minimum": 0},
        "query_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": [
        "entity_canonicalization_precision", "entity_recall", "concept_fusion_precision",
        "concept_fusion_recall", "source_summary_supported_claim_rate",
        "unsupported_claim_rate_max", "claim_evidence_binding_accuracy",
        "contradiction_precision", "contradiction_recall", "source_coverage",
        "stale_withdrawal_prevention"
      ],
      "properties": {
        "entity_canonicalization_precision": {"const": 0.95},
        "entity_recall": {"const": 0.85},
        "concept_fusion_precision": {"const": 0.9},
        "concept_fusion_recall": {"const": 0.8},
        "source_summary_supported_claim_rate": {"const": 1.0},
        "unsupported_claim_rate_max": {"const": 0.0},
        "claim_evidence_binding_accuracy": {"const": 1.0},
        "contradiction_precision": {"const": 0.95},
        "contradiction_recall": {"const": 0.8},
        "source_coverage": {"const": 0.95},
        "stale_withdrawal_prevention": {"const": 1.0}
      }
    },
    "hard_failures": {
      "type": "object", "additionalProperties": false,
      "required": [
        "wrong_entity_merge", "invented_source_revision", "invalid_locator",
        "invalid_quote_hash", "unsupported_authoritative_claim", "authority_elevation",
        "unauthorized_mutation", "stale_prohibited_selection", "withdrawn_content_admission",
        "restricted_disclosure", "silent_fallback", "partial_publication_reported_complete",
        "unrecoverable_run"
      ],
      "properties": {
        "wrong_entity_merge": {"type": "integer", "minimum": 0},
        "invented_source_revision": {"type": "integer", "minimum": 0},
        "invalid_locator": {"type": "integer", "minimum": 0},
        "invalid_quote_hash": {"type": "integer", "minimum": 0},
        "unsupported_authoritative_claim": {"type": "integer", "minimum": 0},
        "authority_elevation": {"type": "integer", "minimum": 0},
        "unauthorized_mutation": {"type": "integer", "minimum": 0},
        "stale_prohibited_selection": {"type": "integer", "minimum": 0},
        "withdrawn_content_admission": {"type": "integer", "minimum": 0},
        "restricted_disclosure": {"type": "integer", "minimum": 0},
        "silent_fallback": {"type": "integer", "minimum": 0},
        "partial_publication_reported_complete": {"type": "integer", "minimum": 0},
        "unrecoverable_run": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"formal_release_eligible": {"const": true}}},
      "then": {"properties": {"passed": {"const": true}, "manual_review": {"properties": {"status": {"const": "recorded"}}}}}
    }
  ]
}
