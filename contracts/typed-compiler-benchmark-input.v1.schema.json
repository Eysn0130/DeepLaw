{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.local/contracts/typed-compiler-benchmark-input.v1.schema.json",
  "title": "DeepLaw typed compiler benchmark input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "candidate_line",
    "compiler_identity",
    "claim_eligible",
    "limitations",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.typed-compiler-benchmark-input/v1"},
    "suite_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "candidate_line": {"type": "string", "minLength": 1, "maxLength": 100},
    "compiler_identity": {"type": "string", "minLength": 1, "maxLength": 500},
    "claim_eligible": {"const": false},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceRefIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "source_refs", "gold_claims", "predicted_claims"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref_id", "source_id", "locator", "text_sha256"],
            "properties": {
              "ref_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "source_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "locator": {"type": "string", "minLength": 1, "maxLength": 2000},
              "text_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "gold_claims": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "kind", "statement", "source_ref_ids", "cross_document"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "kind": {"type": "string", "minLength": 1, "maxLength": 80},
              "statement": {"type": "string", "minLength": 1, "maxLength": 20000},
              "source_ref_ids": {"$ref": "#/$defs/sourceRefIds"},
              "cross_document": {"type": "boolean"}
            }
          }
        },
        "predicted_claims": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prediction_id",
              "kind",
              "statement",
              "source_ref_ids",
              "matched_gold_claim_id",
              "claim_equivalent",
              "support_label",
              "review_decision",
              "cross_document"
            ],
            "properties": {
              "prediction_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "kind": {"type": "string", "minLength": 1, "maxLength": 80},
              "statement": {"type": "string", "minLength": 1, "maxLength": 20000},
              "source_ref_ids": {"$ref": "#/$defs/sourceRefIds"},
              "matched_gold_claim_id": {
                "oneOf": [
                  {"type": "string", "minLength": 1, "maxLength": 200},
                  {"type": "null"}
                ]
              },
              "claim_equivalent": {"type": "boolean"},
              "support_label": {
                "enum": ["supported", "unsupported", "hallucinated"]
              },
              "review_decision": {"enum": ["accept", "reject", "not_reviewed"]},
              "cross_document": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
