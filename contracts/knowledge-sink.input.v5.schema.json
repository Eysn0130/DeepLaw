{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/knowledge-sink.input.v5.schema.json",
  "title": "DeepLaw Knowledge Sink Input v5",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation": {},
    "idempotency_key": {},
    "confirm_no_case_data": {},
    "title": {},
    "body": {},
    "kind": {},
    "knowledge_id": {},
    "knowledge_ids": {},
    "expected_revision_id": {},
    "scope": {},
    "sensitivity": {},
    "epistemic_state": {},
    "source_refs": {},
    "run_id": {},
    "model_id": {},
    "tool_id": {},
    "generation_activity_id": {},
    "tags": {},
    "semantic_key": {},
    "aliases": {},
    "relation_hints": {},
    "assertion": {},
    "valid_from": {},
    "valid_to": {},
    "expires_at": {},
    "memory_type": {},
    "preference_basis": {},
    "requested_origin": {},
    "requested_authority": {},
    "skill_manifest": {},
    "subject_knowledge_id": {},
    "predicate": {},
    "object_knowledge_id": {},
    "object_knowledge_ids": {},
    "action": {},
    "expected_relation_revision_id": {},
    "evidence_refs": {},
    "reason": {},
    "outcome": {},
    "evaluator_type": {},
    "feedback_note": {},
    "task": {},
    "host_id": {},
    "status": {},
    "input_sha256": {},
    "output_sha256": {},
    "tool_results_sha256": {},
    "started_at": {},
    "ended_at": {},
    "run_metadata": {},
    "items": {},
    "compilation_run_id": {},
    "compiler_profile": {},
    "compiler_profile_version": {},
    "host_identity": {},
    "model_identity": {},
    "prompt_template_id": {},
    "prompt_config_sha256": {},
    "plan_configuration_sha256": {},
    "packet_max_fragments": {},
    "plan": {},
    "query": {},
    "durable": {},
    "reusable": {},
    "novel": {},
    "non_duplicate": {},
    "contains_case_data": {},
    "source_free": {},
    "draft_id": {},
    "evaluator_id": {},
    "evaluation_reason": {},
    "replacement_source_revision_id": {},
    "source_revision_id": {},
    "project": {},
    "refresh_task_id": {},
    "source_revision_ids": {},
    "knowledge_revision_ids": {},
    "relation_revision_ids": {},
    "profile_id": {},
    "prompt_sha256": {},
    "config_sha256": {},
    "synthesis_refresh_run_id": {}
  },
  "oneOf": [
    {"$ref": "knowledge-sink.input.v4.schema.json"},
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation", "idempotency_key", "confirm_no_case_data",
        "task", "host_id", "status", "run_metadata"
      ],
      "properties": {
        "operation": {"const": "record_run"},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200},
        "confirm_no_case_data": {"const": true},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "task": {"type": "string", "minLength": 1, "maxLength": 5000},
        "host_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "model_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "status": {"enum": ["succeeded", "failed", "partial", "aborted"]},
        "scope": {"enum": ["personal", "project", "domain"]},
        "sensitivity": {"enum": ["public", "internal", "private", "restricted"]},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tool_results_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "run_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_binding"],
          "properties": {
            "task_kind": {"type": "string", "maxLength": 500},
            "tool_ids": {
              "type": "array", "maxItems": 100,
              "items": {"type": "string", "maxLength": 500}
            },
            "artifact_ids": {
              "type": "array", "maxItems": 100,
              "items": {"type": "string", "maxLength": 500}
            },
            "notes_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "task_binding": {"$ref": "task-context-binding.v1.schema.json"}
          }
        }
      }
    }
  ]
}
