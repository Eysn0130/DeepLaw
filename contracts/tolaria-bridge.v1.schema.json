{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/tolaria-bridge.v1.schema.json",
  "title": "DeepLaw Tolaria Bridge Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "frontend", "context_contract", "writable_roots",
    "readonly_roots", "recommended_mcp_processes",
    "deep_law_owns_canonical_mutation", "ephemeral_context_default"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.tolaria-bridge/v1"},
    "frontend": {"const": "tolaria"},
    "context_contract": {"const": "deeplaw.editor-context-envelope/v1"},
    "writable_roots": {"const": ["drafts", "notes"]},
    "readonly_roots": {
      "const": [
        ".deeplaw", "canvas", "knowledge", "memory", "sources", "wiki"
      ]
    },
    "recommended_mcp_processes": {
      "const": [
        "tolaria", "knowledge_support", "knowledge_sink", "law_support"
      ]
    },
    "deep_law_owns_canonical_mutation": {"const": true},
    "ephemeral_context_default": {"const": true}
  }
}
