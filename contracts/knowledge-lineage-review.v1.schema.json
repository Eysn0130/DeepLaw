{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.local/contracts/knowledge-lineage-review.v1.schema.json",
  "title": "DeepLaw reviewed Knowledge Lineage mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vault_id",
    "review_id",
    "status",
    "from_assets",
    "to_assets",
    "knowledge_keys",
    "source_revision_ids",
    "transition_ids",
    "reviewer_id",
    "reason",
    "reviewed_at",
    "approval_inherited",
    "replayed"
  ],
  "properties": {
    "schema_version": {
      "const": "deeplaw.knowledge-lineage-review/v1"
    },
    "vault_id": {
      "type": "string",
      "pattern": "^vault_[0-9a-f]{24}$"
    },
    "review_id": {
      "type": "string",
      "pattern": "^lineagereview_[0-9a-f]{24}$"
    },
    "status": {
      "enum": ["split", "merged", "ambiguous"]
    },
    "from_assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/asset" }
    },
    "to_assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/asset" }
    },
    "knowledge_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^knowledge_[0-9a-f]{24}$"
      }
    },
    "source_revision_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sourcerev_[0-9a-f]{24}$"
      }
    },
    "transition_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^lineage_[0-9a-f]{24}$"
      }
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_inherited": { "const": false },
    "replayed": { "type": "boolean" }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_revision_id",
        "knowledge_key",
        "title",
        "status",
        "source_revision_ids",
        "source_refs"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^asset_[0-9a-f]{24}$"
        },
        "asset_revision_id": {
          "type": "string",
          "pattern": "^assetrev_[0-9a-f]{24}$"
        },
        "knowledge_key": {
          "type": "string",
          "pattern": "^knowledge_[0-9a-f]{24}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "enum": ["proposed", "active", "superseded", "revoked", "quarantined"]
        },
        "source_revision_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sourcerev_[0-9a-f]{24}$"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/source_ref" }
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision_id",
        "fragment_revision_id",
        "locator",
        "quote_sha256"
      ],
      "properties": {
        "source_revision_id": {
          "type": "string",
          "pattern": "^sourcerev_[0-9a-f]{24}$"
        },
        "fragment_revision_id": {
          "type": "string",
          "pattern": "^irfragment_[0-9a-f]{24}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "quote_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
