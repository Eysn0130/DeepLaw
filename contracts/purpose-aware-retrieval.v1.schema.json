{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/purpose-aware-retrieval.v1.schema.json",
  "title": "DeepLaw purpose-aware retrieval result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "vault_id", "purpose", "policy_id", "query",
    "query_plan", "query_plan_sha256", "compiled", "evidence",
    "contradictions", "gaps", "metrics", "budget", "audit_head",
    "authority_changed_by_ranking", "write_performed"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.purpose-aware-retrieval/v1"},
    "vault_id": {
      "type": "string",
      "pattern": "^(vault_[0-9a-f]{24})?$"
    },
    "purpose": {
      "enum": ["answer", "verify", "quote", "historical", "legal", "debug", "freshness_check"]
    },
    "policy_id": {
      "enum": ["compiled-first-v1", "evidence-first-v1", "balanced-v1"]
    },
    "query": {"type": "string", "minLength": 1, "maxLength": 5000},
    "query_plan": {
      "type": "object",
      "required": ["schema_version", "purpose", "policy_id", "fallback"],
      "properties": {
        "schema_version": {"const": "deeplaw.knowledge-query-plan/v4"},
        "purpose": {
          "enum": ["answer", "verify", "quote", "historical", "legal", "debug", "freshness_check"]
        },
        "policy_id": {
          "enum": ["compiled-first-v1", "evidence-first-v1", "balanced-v1"]
        },
        "fallback": {"type": "object"}
      }
    },
    "query_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiled": {"type": "array", "maxItems": 20, "items": {"type": "object"}},
    "evidence": {"type": "array", "maxItems": 20, "items": {"type": "object"}},
    "contradictions": {"type": "array", "maxItems": 20, "items": {"type": "object"}},
    "gaps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1, "maxLength": 100},
          "message": {"type": "string", "minLength": 1, "maxLength": 500},
          "count": {"type": "integer", "minimum": 0},
          "knowledge_revision_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "freshness": {"enum": ["fresh", "stale", "invalidated", "unknown"]},
          "source_revision_ids": {
            "type": "array", "maxItems": 16, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 200}
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiled_hit", "source_fallback_used", "uncompiled_source_count",
        "stale_selection_prevented_count", "evidence_attachment_count",
        "repeated_query_reused_compilation"
      ],
      "properties": {
        "compiled_hit": {"type": "boolean"},
        "source_fallback_used": {"type": "boolean"},
        "uncompiled_source_count": {"type": "integer", "minimum": 0},
        "stale_selection_prevented_count": {"type": "integer", "minimum": 0},
        "evidence_attachment_count": {"type": "integer", "minimum": 0},
        "repeated_query_reused_compilation": {"type": "boolean"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_items", "selected_items", "max_characters",
        "selected_characters", "max_tokens", "max_provider_characters"
      ],
      "properties": {
        "max_items": {"type": "integer", "minimum": 1, "maximum": 20},
        "selected_items": {"type": "integer", "minimum": 0, "maximum": 40},
        "max_characters": {"type": "integer", "minimum": 200, "maximum": 20000},
        "selected_characters": {"type": "integer", "minimum": 0, "maximum": 20000},
        "max_tokens": {"type": "integer", "minimum": 128, "maximum": 32000},
        "max_provider_characters": {"const": 65536}
      }
    },
    "audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_changed_by_ranking": {"const": false},
    "write_performed": {"const": false}
  }
}
