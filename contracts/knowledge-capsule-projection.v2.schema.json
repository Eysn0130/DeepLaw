{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/knowledge-capsule-projection.v2.schema.json",
  "title": "DeepLaw bounded Knowledge Capsule projection v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection",
    "receipt_id",
    "hard_limit_bytes",
    "statements",
    "gaps",
    "selected_statement_count",
    "selected_source_count",
    "knowledge_revisions",
    "selection_explanation"
  ],
  "properties": {
    "schema_version": {
      "const": "deeplaw.knowledge-capsule-projection/v2"
    },
    "projection": {
      "enum": [
        "compact",
        "standard",
        "audit"
      ]
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^queryreceipt_[0-9a-f]{24}$"
    },
    "hard_limit_bytes": {
      "const": 65536
    },
    "statements": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/statement"
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/queryGap"
      }
    },
    "selected_statement_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "selected_source_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "citations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/sourceReference"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/sourceEvidence"
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object"
      }
    },
    "audit": {
      "type": "object"
    },
    "knowledge_revisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_id",
          "revision_id",
          "kind",
          "title",
          "content",
          "content_sha256",
          "content_truncated",
          "origin",
          "authority",
          "legal_authority",
          "source_free",
          "source_refs",
          "epistemic_state",
          "verification",
          "lifecycle",
          "directive_mode",
          "valid_from",
          "valid_to",
          "expires_at",
          "selection_reason",
          "freshness"
        ],
        "properties": {
          "knowledge_id": {
            "type": "string",
            "pattern": "^knowledge_[0-9a-f]{24}$"
          },
          "revision_id": {
            "type": "string",
            "pattern": "^knowledgerev_[0-9a-f]{24}$"
          },
          "kind": {
            "type": "string",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "content": {
            "type": "string",
            "maxLength": 2000
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_truncated": {
            "type": "boolean"
          },
          "origin": {
            "const": "agent_derived"
          },
          "authority": {
            "const": "agent_derived"
          },
          "legal_authority": {
            "const": false
          },
          "source_free": {
            "const": true
          },
          "source_refs": {
            "type": "array",
            "maxItems": 0
          },
          "epistemic_state": {
            "const": "tentative"
          },
          "verification": {
            "enum": [
              "unverified",
              "run_bound"
            ]
          },
          "lifecycle": {
            "const": "active"
          },
          "directive_mode": {
            "const": "data_only"
          },
          "valid_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "selection_reason": {
            "const": "admitted_governed_revision"
          },
          "freshness": {
            "const": "unknown"
          }
        }
      }
    },
    "selection_explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_exhaustive",
        "selected_revision_ids",
        "omitted_revisions",
        "scope",
        "truncated",
        "selection_entries",
        "selection_truncated",
        "selection_sha256",
        "continuation_operation"
      ],
      "properties": {
        "discovery_exhaustive": {
          "const": false
        },
        "selected_revision_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        },
        "omitted_revisions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revision_id",
              "reason"
            ],
            "properties": {
              "revision_id": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "selection_budget",
                  "character_budget",
                  "source_only_purpose",
                  "token_budget"
                ]
              }
            }
          }
        },
        "scope": {
          "const": "bounded_admitted_candidates_only"
        },
        "truncated": {
          "type": "boolean"
        },
        "selection_entries": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "kind",
              "state",
              "reason"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "kind": {
                "enum": [
                  "statement",
                  "knowledge_revision",
                  "evidence"
                ]
              },
              "state": {
                "enum": [
                  "selected",
                  "omitted"
                ]
              },
              "reason": {
                "enum": [
                  "selected",
                  "selection_budget",
                  "character_budget",
                  "token_budget",
                  "source_budget",
                  "source_only_purpose",
                  "relevance_floor",
                  "exact_source_passage_budget",
                  "duplicate_source_reference",
                  "represented_source_reference"
                ]
              }
            }
          }
        },
        "selection_truncated": {
          "type": "boolean"
        },
        "selection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "continuation_operation": {
          "const": "explain"
        }
      }
    }
  },
  "$defs": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_id",
        "statement_text",
        "statement_type",
        "support_status",
        "current_supported",
        "freshness",
        "origin",
        "authority",
        "verification",
        "legal_authority",
        "source_refs"
      ],
      "properties": {
        "statement_id": {
          "type": "string"
        },
        "statement_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "statement_type": {
          "enum": [
            "factual",
            "interpretation",
            "limitation",
            "unresolved"
          ]
        },
        "support_status": {
          "enum": [
            "supported",
            "contested",
            "unsupported",
            "not_applicable"
          ]
        },
        "current_supported": {
          "type": "boolean"
        },
        "freshness": {
          "enum": [
            "fresh",
            "unknown",
            "stale",
            "invalidated"
          ]
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "legal_authority": {
          "const": false
        },
        "source_refs": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "knowledge_revision_id": {
          "type": "string"
        },
        "knowledge_id": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitation": {
          "type": [
            "string",
            "null"
          ]
        },
        "partition": {
          "type": "string"
        },
        "object_summary": {
          "type": "object"
        },
        "support_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision_id",
        "fragment_id",
        "locator",
        "quote_sha256"
      ],
      "properties": {
        "source_revision_id": {
          "type": "string",
          "pattern": "^sourcerev_[0-9a-f]{24}$"
        },
        "fragment_id": {
          "type": "string",
          "pattern": "^fragment_[0-9a-f]{24}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "quote_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_revision_id",
        "fragment_id",
        "excerpt",
        "content_sha256",
        "source_refs",
        "selection_reason",
        "verification"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^queryevidence_[0-9a-f]{24}$"
        },
        "source_revision_id": {
          "type": "string",
          "pattern": "^sourcerev_[0-9a-f]{24}$"
        },
        "fragment_id": {
          "type": "string",
          "pattern": "^fragment_[0-9a-f]{24}$"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "selection_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "verification": {
          "const": "verified_source"
        }
      }
    },
    "queryGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "code",
        "duty",
        "message"
      ],
      "properties": {
        "gap_id": {
          "type": "string",
          "pattern": "^querygap_[0-9a-f]{24}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "duty": {
          "enum": [
            "primary_answer",
            "identity",
            "definition",
            "current_state",
            "temporal_freshness",
            "procedure",
            "exception",
            "contradiction",
            "applicability",
            "limitation",
            "source_evidence",
            "unresolved_gap"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "source_revision_ids": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^sourcerev_[0-9a-f]{24}$"
          }
        },
        "knowledge_revision_id": {
          "type": "string",
          "pattern": "^knowledgerev_[0-9a-f]{24}$"
        },
        "freshness": {
          "enum": [
            "fresh",
            "unknown",
            "stale",
            "invalidated"
          ]
        }
      }
    }
  }
}
