{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/purpose-aware-retrieval.v2.schema.json",
  "title": "DeepLaw purpose-aware retrieval result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "vault_id", "purpose", "policy_id", "query",
    "query_plan", "query_plan_sha256", "compiled", "evidence", "contradictions",
    "gaps", "metrics", "budget", "delivery", "audit_head", "authority_changed_by_ranking",
    "write_performed"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.purpose-aware-retrieval/v2"},
    "vault_id": {"type": "string", "pattern": "^(vault_[0-9a-f]{24})?$"},
    "purpose": {"enum": ["answer", "verify", "quote", "historical", "legal", "debug", "freshness_check"]},
    "policy_id": {"enum": ["compiled-first-v1", "evidence-first-v1", "balanced-v1"]},
    "query": {"type": "string", "minLength": 1, "maxLength": 5000},
    "query_plan": {"type": "object"},
    "query_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiled": {"type": "array", "maxItems": 20, "items": {"type": "object"}},
    "evidence": {"type": "array", "maxItems": 20, "items": {"type": "object"}},
    "contradictions": {"type": "array", "maxItems": 20, "items": {"type": "object"}},
    "gaps": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
    "metrics": {"type": "object"},
    "budget": {"type": "object"},
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface", "provider_visible_bytes", "hard_limit_bytes",
        "selected_object_count", "deduplicated_object_count",
        "suppressed_candidate_count", "raw_fragment_baseline_bytes",
        "provider_content_bytes", "context_bytes_saved", "estimated_tokens_saved", "content_truncated",
        "continuation_available", "internal_discovery_receipt_sha256"
      ],
      "properties": {
        "surface": {"const": "provider_visible_knowledge_capsule"},
        "provider_visible_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "hard_limit_bytes": {"const": 65536},
        "selected_object_count": {"type": "integer", "minimum": 0, "maximum": 40},
        "deduplicated_object_count": {"type": "integer", "minimum": 0},
        "suppressed_candidate_count": {"type": "integer", "minimum": 0},
        "raw_fragment_baseline_bytes": {"type": "integer", "minimum": 0},
        "provider_content_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "context_bytes_saved": {"type": "integer", "minimum": 0},
        "estimated_tokens_saved": {"type": "integer", "minimum": 0},
        "content_truncated": {"type": "boolean"},
        "continuation_available": {"type": "boolean"},
        "internal_discovery_receipt_sha256": {
          "type": "string", "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_changed_by_ranking": {"const": false},
    "write_performed": {"const": false}
  }
}
