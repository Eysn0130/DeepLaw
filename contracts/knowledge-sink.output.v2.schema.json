{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/knowledge-sink.output.v2.schema.json",
  "title": "DeepLaw Knowledge Sink Output v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "boundary", "result"],
  "properties": {
    "schema_version": {"const": "deeplaw.knowledge-sink-output/v2"},
    "operation": {"enum": [
      "remember", "reflect", "save_synthesis", "upsert_concept", "upsert_entity",
      "record_event", "save_claim", "save_comparison", "add_relation", "expire",
      "forget", "save_skill", "record_feedback", "record_run", "capture",
      "resolve_identity", "consolidate_memory"
    ]},
    "boundary": {"$ref": "#/$defs/boundary"},
    "result": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"enum": [
        "remember", "reflect", "save_synthesis", "upsert_concept", "upsert_entity",
        "record_event", "save_claim", "save_comparison", "expire", "forget", "save_skill"
      ]}}, "required": ["operation"]},
      "then": {"properties": {"result": {"$ref": "#/$defs/knowledge_revision"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "add_relation"}}, "required": ["operation"]},
      "then": {"properties": {"result": {"$ref": "#/$defs/relation"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "record_feedback"}}, "required": ["operation"]},
      "then": {"properties": {"result": {"$ref": "#/$defs/feedback"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "record_run"}}, "required": ["operation"]},
      "then": {"properties": {"result": {"$ref": "#/$defs/run"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "capture"}}, "required": ["operation"]},
      "then": {"properties": {"result": {"$ref": "#/$defs/capture"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "resolve_identity"}}, "required": ["operation"]},
      "then": {"properties": {"result": {"$ref": "#/$defs/identity_resolution"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "consolidate_memory"}}, "required": ["operation"]},
      "then": {"properties": {"result": {"$ref": "#/$defs/consolidation"}}}
    }
  ],
  "$defs": {
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "legal_authority", "official_or_private_legal_mutation", "authority_elevation",
        "audit_deletion", "arbitrary_paths", "case_data_allowed", "scope_bound"
      ],
      "properties": {
        "legal_authority": {"const": false},
        "official_or_private_legal_mutation": {"const": false},
        "authority_elevation": {"const": false},
        "audit_deletion": {"const": false},
        "arbitrary_paths": {"const": false},
        "case_data_allowed": {"const": false},
        "scope_bound": {"const": true}
      }
    },
    "knowledge_revision": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "knowledge_id", "revision_id", "parent_revision_id",
        "markdown_sha256", "workspace_path", "kind", "origin", "authority",
        "legal_authority", "mutability", "writer_scope", "activation_policy",
        "verification", "lifecycle", "epistemic_state", "scope", "sensitivity",
        "source_free", "quarantine_reasons", "recorded_at",
        "idempotent_replay", "current_revision_id", "audit_head"
      ],
      "properties": {
        "schema_version": {"const": "deeplaw.knowledge-revision/v2"},
        "knowledge_id": {"type": "string", "pattern": "^knowledge_[0-9a-f]{24}$"},
        "revision_id": {"type": "string", "pattern": "^knowledgerev_[0-9a-f]{24}$"},
        "parent_revision_id": {"type": ["string", "null"], "pattern": "^knowledgerev_[0-9a-f]{24}$"},
        "markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "workspace_path": {"type": "string", "minLength": 1, "maxLength": 2000},
        "kind": {"enum": [
          "claim", "concept", "entity", "event", "decision", "procedure", "experience",
          "preference", "synthesis", "comparison", "skill", "memory"
        ]},
        "origin": {"const": "agent_derived"}, "authority": {"const": "agent_derived"},
        "legal_authority": {"const": false},
        "mutability": {"const": "revision_only"},
        "writer_scope": {"enum": ["personal", "project", "domain"]},
        "activation_policy": {"const": "deeplaw.autonomous-activation/v1"},
        "verification": {"enum": ["unverified", "source_bound", "run_bound"]},
        "lifecycle": {"enum": [
          "active", "superseded", "revoked", "expired", "forgotten", "archived", "quarantined"
        ]},
        "epistemic_state": {"enum": ["supported", "tentative", "contested", "unknown"]},
        "scope": {"enum": ["personal", "project", "domain"]},
        "sensitivity": {"enum": ["public", "internal", "private", "restricted"]},
        "source_free": {"type": "boolean"},
        "quarantine_reasons": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string"}},
        "recorded_at": {"type": "string", "format": "date-time"},
        "idempotent_replay": {"type": "boolean"},
        "current_revision_id": {"type": ["string", "null"], "pattern": "^knowledgerev_[0-9a-f]{24}$"},
        "audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deduplicated": {"type": "boolean"},
        "deduplicated_to": {"type": ["string", "null"], "pattern": "^knowledge_[0-9a-f]{24}$"},
        "deduplication_id": {"type": "string", "pattern": "^deduplication_[0-9a-f]{24}$"}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "relation_key", "relation_revision_id", "parent_revision_id",
        "subject_knowledge_id", "predicate", "object_knowledge_id", "origin", "authority",
        "legal_authority", "source_free", "lifecycle", "scope", "sensitivity",
        "valid_from", "valid_to", "recorded_at", "idempotent_replay", "audit_head"
      ],
      "properties": {
        "schema_version": {"const": "deeplaw.knowledge-relation/v3"},
        "relation_key": {"type": "string", "pattern": "^relationkey_[0-9a-f]{24}$"},
        "relation_revision_id": {"type": "string", "pattern": "^relationrev_[0-9a-f]{24}$"},
        "parent_revision_id": {"type": ["string", "null"], "pattern": "^relationrev_[0-9a-f]{24}$"},
        "subject_knowledge_id": {"type": "string", "pattern": "^knowledge_[0-9a-f]{24}$"},
        "predicate": {"type": "string"},
        "object_knowledge_id": {"type": "string", "pattern": "^knowledge_[0-9a-f]{24}$"},
        "origin": {"const": "agent_derived"}, "authority": {"const": "agent_derived"},
        "legal_authority": {"const": false}, "source_free": {"type": "boolean"},
        "lifecycle": {"const": "active"},
        "scope": {"enum": ["personal", "project", "domain"]},
        "sensitivity": {"enum": ["public", "internal", "private", "restricted"]},
        "valid_from": {"type": ["string", "null"], "format": "date-time"},
        "valid_to": {"type": ["string", "null"], "format": "date-time"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "idempotent_replay": {"type": "boolean"},
        "audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "feedback": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "feedback_id", "knowledge_id", "revision_id", "run_id",
        "outcome", "evaluator_type", "feedback_note_sha256", "task_success_authority",
        "recorded_at", "idempotent_replay", "audit_head"
      ],
      "properties": {
        "schema_version": {"const": "deeplaw.knowledge-feedback/v1"},
        "feedback_id": {"type": "string"}, "knowledge_id": {"type": "string"},
        "revision_id": {"type": "string"}, "run_id": {"type": "string"},
        "outcome": {"enum": ["helpful", "neutral", "noisy", "harmful"]},
        "evaluator_type": {"enum": ["user", "external_check", "agent_self_report"]},
        "feedback_note_sha256": {"type": ["string", "null"]},
        "task_success_authority": {"enum": ["external_evidence", "self_report_only"]},
        "recorded_at": {"type": "string", "format": "date-time"},
        "idempotent_replay": {"type": "boolean"}, "audit_head": {"type": "string"}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "writer_id", "host_id", "model_id", "task_sha256",
        "input_sha256", "output_sha256", "tool_results_sha256", "scope", "sensitivity",
        "status", "started_at", "ended_at", "metadata", "recorded_at", "receipt_sha256",
        "idempotent_replay", "audit_head"
      ],
      "properties": {
        "schema_version": {"const": "deeplaw.knowledge-run-record/v1"},
        "run_id": {"type": "string"}, "writer_id": {"type": "string"},
        "host_id": {"type": "string"}, "model_id": {"type": ["string", "null"]},
        "task_sha256": {"type": "string"}, "input_sha256": {"type": ["string", "null"]},
        "output_sha256": {"type": ["string", "null"]},
        "tool_results_sha256": {"type": ["string", "null"]},
        "scope": {"enum": ["personal", "project", "domain"]},
        "sensitivity": {"enum": ["public", "internal", "private", "restricted"]},
        "status": {"enum": ["succeeded", "failed", "partial", "aborted"]},
        "started_at": {"type": "string"}, "ended_at": {"type": "string"},
        "metadata": {"type": "object"}, "recorded_at": {"type": "string"},
        "receipt_sha256": {"type": "string"}, "idempotent_replay": {"type": "boolean"},
        "audit_head": {"type": "string"}
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "capture_id", "run_id", "committed", "rejected", "recorded_at",
        "idempotent_replay", "audit_head"
      ],
      "properties": {
        "schema_version": {"const": "deeplaw.knowledge-capture/v1"},
        "capture_id": {"type": "string"}, "run_id": {"type": "string"},
        "committed": {"type": "array", "items": {"type": "object"}},
        "rejected": {"type": "array", "items": {"type": "object"}},
        "recorded_at": {"type": "string"}, "idempotent_replay": {"type": "boolean"},
        "audit_head": {"type": "string"}
      }
    },
    "identity_resolution": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "resolution_id", "action", "subject_knowledge_id",
        "object_knowledge_ids", "evidence_refs_sha256", "run_id", "writer_id",
        "recorded_at", "idempotent_replay", "audit_head"
      ],
      "properties": {
        "schema_version": {"const": "deeplaw.knowledge-identity-resolution/v1"},
        "resolution_id": {"type": "string"}, "action": {"type": "string"},
        "subject_knowledge_id": {"type": "string"},
        "object_knowledge_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_refs_sha256": {"type": "string"}, "run_id": {"type": ["string", "null"]},
        "writer_id": {"type": "string"}, "recorded_at": {"type": "string"},
        "idempotent_replay": {"type": "boolean"}, "audit_head": {"type": "string"}
      }
    },
    "consolidation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "consolidation_id", "run_id", "input_revision_ids",
        "output_knowledge_id", "output_revision_id", "archived", "recorded_at",
        "idempotent_replay", "audit_head"
      ],
      "properties": {
        "schema_version": {"const": "deeplaw.knowledge-consolidation/v1"},
        "consolidation_id": {"type": "string"}, "run_id": {"type": "string"},
        "input_revision_ids": {"type": "array", "items": {"type": "string"}},
        "output_knowledge_id": {"type": "string"}, "output_revision_id": {"type": "string"},
        "archived": {"type": "array", "items": {"type": "object"}},
        "recorded_at": {"type": "string"}, "idempotent_replay": {"type": "boolean"},
        "audit_head": {"type": "string"}
      }
    }
  }
}
