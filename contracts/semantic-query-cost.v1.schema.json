{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/semantic-query-cost.v1.schema.json",
  "title": "DeepLaw Frozen Semantic Query Cost v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gold_id", "host_report_id", "query_set_sha256", "first_party_command", "query_count", "total_query_tokens", "total_context_bytes", "raw_fragment_baseline_bytes", "measurement_method", "budget", "measured_at"],
  "properties": {
    "schema_version": {"const": "deeplaw.semantic-query-cost/v1"},
    "gold_id": {"type": "string", "pattern": "^semanticgold_[0-9a-f]{24}$"},
    "host_report_id": {"type": "string", "pattern": "^semantichostrun_[0-9a-f]{24}$"},
    "query_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "first_party_command": {"const": "deeplaw knowledge query"},
    "query_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "total_query_tokens": {"type": "integer", "minimum": 0},
    "total_context_bytes": {"type": "integer", "minimum": 0},
    "raw_fragment_baseline_bytes": {"type": "integer", "minimum": 0},
    "measurement_method": {"enum": ["provider_reported", "tokenizer_exact", "utf8_bytes_proxy"]},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_items", "max_sources", "max_chars", "max_tokens", "max_sensitivity", "cold_or_warm"],
      "properties": {
        "max_items": {"type": "integer", "minimum": 1},
        "max_sources": {"type": "integer", "minimum": 1},
        "max_chars": {"type": "integer", "minimum": 1},
        "max_tokens": {"type": "integer", "minimum": 1},
        "max_sensitivity": {"enum": ["public", "private", "restricted"]},
        "cold_or_warm": {"enum": ["cold", "warm"]}
      }
    },
    "measured_at": {"type": "string", "format": "date-time"}
  }
}
