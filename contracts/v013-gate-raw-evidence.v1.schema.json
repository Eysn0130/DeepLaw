{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/v013-gate-raw-evidence.v1.schema.json",
  "title": "DeepLaw v0.13 reusable raw Gate execution evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "candidate_version",
    "candidate_binding",
    "protocol_binding",
    "gold_binding",
    "corpus",
    "isolation",
    "gate_ids",
    "executions",
    "metric_samples",
    "hard_failure_samples",
    "redaction",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.v013-gate-raw-evidence/v1"},
    "artifact_kind": {"const": "v013-reusable-raw-gate-execution"},
    "candidate_version": {"$ref": "#/$defs/semver"},
    "candidate_binding": {"$ref": "#/$defs/candidateBinding"},
    "protocol_binding": {"$ref": "#/$defs/protocolBinding"},
    "gold_binding": {"$ref": "#/$defs/goldBinding"},
    "corpus": {"$ref": "#/$defs/corpus"},
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "source_mount_read_only",
        "compiler_gold_visible",
        "compiler_scorer_visible",
        "scorer_process_separate",
        "repository_source_visible",
        "ambient_credentials_visible"
      ],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_mount_read_only": {"const": true},
        "compiler_gold_visible": {"const": false},
        "compiler_scorer_visible": {"const": false},
        "scorer_process_separate": {"const": true},
        "repository_source_visible": {"const": false},
        "ambient_credentials_visible": {"const": false}
      }
    },
    "gate_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/execution"}
    },
    "metric_samples": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/metricSample"}
    },
    "hard_failure_samples": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/hardFailureSample"}
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_canary_count",
        "private_path_count",
        "raw_transcript_retained",
        "hidden_reasoning_retained",
        "authentication_material_retained"
      ],
      "properties": {
        "secret_canary_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "private_path_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "raw_transcript_retained": {"const": false},
        "hidden_reasoning_retained": {"const": false},
        "authentication_material_retained": {"const": false}
      }
    },
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 32
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "lock_sha256", "wheel_sha256", "sdist_sha256"],
      "properties": {
        "commit": {"$ref": "#/$defs/git"},
        "tree": {"$ref": "#/$defs/git"},
        "lock_sha256": {"$ref": "#/$defs/sha256"},
        "wheel_sha256": {"$ref": "#/$defs/sha256"},
        "sdist_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protocolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "protocol_sha256", "active_qualification_sha256"],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/identifier"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "active_qualification_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "goldBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "role", "source", "independent"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "role": {"enum": ["development", "qualification_holdout", "final_blind"]},
        "source": {"enum": ["repository", "repository_external"]},
        "independent": {"type": "boolean"}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "role", "source", "read_only"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"enum": ["development", "qualification_holdout", "final_blind"]},
        "source": {"enum": ["repository", "repository_external"]},
        "read_only": {"const": true}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "argv",
        "exit_code",
        "os_name",
        "python_version",
        "tool_name",
        "tool_version",
        "model_id",
        "reasoning_effort",
        "dimensions",
        "provider_bytes",
        "input_tokens",
        "output_tokens",
        "cache_tokens",
        "reasoning_tokens",
        "latency_ms",
        "rss_peak_bytes"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/identifier"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "os_name": {"enum": ["linux", "macos", "windows"]},
        "python_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
        "tool_name": {"type": "string", "minLength": 1, "maxLength": 100},
        "tool_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "model_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "reasoning_effort": {
          "anyOf": [
            {"type": "null"},
            {"enum": ["low", "medium", "high", "xhigh", "max"]}
          ]
        },
        "dimensions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "provider_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "latency_ms": {"type": "number", "minimum": 0},
        "rss_peak_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "metricSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "run_id", "metric", "numerator", "denominator"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/identifier"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "metric": {"$ref": "#/$defs/identifier"},
        "numerator": {"type": "number", "minimum": 0},
        "denominator": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "hardFailureSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "run_id", "failure_id", "count"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/identifier"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "failure_id": {"$ref": "#/$defs/identifier"},
        "count": {"type": "integer", "minimum": 0, "maximum": 1000000000}
      }
    }
  }
}
