{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/knowledge-support.input.v1.schema.json",
  "title": "DeepLaw Knowledge Support Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation"],
  "properties": {
    "operation": {
      "type": "string",
      "enum": ["search", "get", "context", "verify", "inspect"],
      "default": "search"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "confirm_no_case_data": {
      "const": true
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "asset_id": {
      "type": "string",
      "pattern": "^asset_[0-9a-f]{24}$"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 5
    },
    "max_chars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12000,
      "default": 5000
    },
    "kinds": {
      "type": "array",
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "constraint",
          "decision",
          "fact",
          "procedure",
          "rule",
          "experience",
          "lesson",
          "question",
          "exception",
          "definition",
          "requirement",
          "risk",
          "assumption",
          "reference"
        ]
      }
    },
    "memory_tiers": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["working", "project", "experience", "wisdom", "domain"]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {"const": "search"}
        },
        "required": ["operation"]
      },
      "then": {
        "required": ["query"]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {"const": "context"}
        },
        "required": ["operation"]
      },
      "then": {
        "required": ["task", "confirm_no_case_data"]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {"enum": ["get", "verify"]}
        },
        "required": ["operation"]
      },
      "then": {
        "required": ["asset_id"]
      }
    }
  ]
}
