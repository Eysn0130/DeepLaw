{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/query-expansion-profile.v2.schema.json",
  "title": "DeepLaw Query Expansion Profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "compatibility_profile",
    "lexicon_sha256",
    "max_terms",
    "match_policy",
    "rules",
    "profile_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.query-expansion-profile/v2"},
    "profile_id": {"const": "deeplaw-deterministic-query-expansion/2"},
    "compatibility_profile": {"const": "deeplaw-deterministic-query-expansion/1"},
    "lexicon_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "max_terms": {"type": "integer", "minimum": 1, "maximum": 64},
    "match_policy": {"const": "normalized-casefold-substring"},
    "rules": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule_id", "rationale", "locale", "direction"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 500},
          "locale": {"type": "string", "minLength": 1, "maxLength": 100},
          "direction": {"enum": ["bidirectional", "zh-to-en", "within-language"]}
        }
      }
    },
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
