{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/knowledge-ingest-job.v2.schema.json",
  "title": "DeepLaw resumable local or connector-snapshot ingest job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "vault_id", "state", "created_at", "updated_at", "configuration", "registration", "cancel_requested", "items", "summary", "record_sha256"],
  "properties": {
    "schema_version": {"const": "deeplaw.knowledge-ingest-job/v2"},
    "job_id": {"type": "string", "pattern": "^ingestjob_[0-9a-f]{24}$"},
    "vault_id": {"type": "string", "pattern": "^vault_[0-9a-f]{24}$"},
    "state": {"enum": ["planned", "running", "completed", "partial", "cancelled", "interrupted"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "configuration": {"$ref": "#/$defs/configuration"},
    "registration": {"$ref": "#/$defs/registration"},
    "cancel_requested": {"type": "boolean"},
    "items": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/item"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "running", "succeeded", "failed", "cancelled"],
      "properties": {
        "pending": {"type": "integer", "minimum": 0},
        "running": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "cancelled": {"type": "integer", "minimum": 0}
      }
    },
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "trust", "sensitivity", "pdf_fallback", "typed_extraction", "typed_extractor_manifest_hint", "confirm_external_disclosure", "reference_proposals"],
      "properties": {
        "source_kind": {"enum": ["document", "conversation", "tool_result", "code", "web", "database", "manual", "package"]},
        "trust": {"enum": ["untrusted", "user_provided"]},
        "sensitivity": {"enum": ["public", "internal", "private", "restricted"]},
        "pdf_fallback": {"enum": ["off", "vision-consensus", "document-engine"]},
        "typed_extraction": {"enum": ["off", "deterministic-v1", "deterministic-v2", "local-model-v1", "external-model-explicit"]},
        "typed_extractor_manifest_hint": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "confirm_external_disclosure": {"type": "boolean"},
        "reference_proposals": {"type": "boolean"}
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "root_path_hint", "single_file", "recursive", "include", "exclude"],
      "properties": {
        "enabled": {"type": "boolean"},
        "root_path_hint": {"type": "string", "minLength": 1, "maxLength": 4096},
        "single_file": {"type": "boolean"},
        "recursive": {"type": "boolean"},
        "include": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "exclude": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "action", "path_hint", "logical_path", "source_key", "collection_id", "origin_uri", "snapshot_id", "planned_sha256", "planned_byte_size", "state", "attempts", "source_id", "error"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^jobitem_[0-9a-f]{24}$"},
        "action": {"enum": ["add", "update", "move"]},
        "path_hint": {"type": "string", "minLength": 1, "maxLength": 4096},
        "logical_path": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source_key": {"type": "string", "pattern": "^sourcekey_[0-9a-f]{24}$"},
        "collection_id": {"type": "string", "pattern": "^collection_[0-9a-f]{24}$"},
        "origin_uri": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
        "snapshot_id": {"type": ["string", "null"], "pattern": "^sourcesnapshot_[0-9a-f]{24}$"},
        "planned_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "planned_byte_size": {"type": "integer", "minimum": 0},
        "state": {"enum": ["pending", "running", "succeeded", "failed", "cancelled"]},
        "attempts": {"type": "integer", "minimum": 0, "maximum": 10},
        "source_id": {"type": ["string", "null"], "pattern": "^source_[0-9a-f]{24}$"},
        "error": {"type": ["string", "null"], "maxLength": 2000}
      }
    }
  }
}
