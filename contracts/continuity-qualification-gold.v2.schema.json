{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/continuity-qualification-gold.v2.schema.json",
  "title": "DeepLaw Pass 12 Continuity Qualification Gold v2",
  "description": "Evaluator-only structural Gold. It is never candidate-visible and never binds Pass 11 evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gold_id",
    "status",
    "claim_eligible",
    "candidate_visible_when_frozen",
    "case_id",
    "expected_statement_ids",
    "forbidden_statement_ids",
    "expected_action",
    "expected_release_state",
    "required_gap_codes",
    "acceptable_gap_codes",
    "required_duties",
    "human_rubric",
    "historical_evidence_binding"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.continuity-qualification-gold/v2"},
    "gold_id": {"type": "string", "pattern": "^continuitygold_[0-9a-f]{24}$"},
    "status": {"const": "development_evaluator_only"},
    "claim_eligible": {"const": false},
    "candidate_visible_when_frozen": {"const": false},
    "case_id": {"$ref": "#/$defs/id"},
    "expected_statement_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "forbidden_statement_ids": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "expected_action": {"enum": ["preserve_release_hold", "verify_current_state"]},
    "expected_release_state": {"$ref": "#/$defs/release_state"},
    "required_gap_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/code"}
    },
    "acceptable_gap_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/code"}
    },
    "required_duties": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/required_duty"}
    },
    "human_rubric": {"$ref": "#/$defs/human_rubric"},
    "historical_evidence_binding": {
      "type": "array",
      "maxItems": 0,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
    },
    "release_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_version", "release_ready", "claim_eligible"],
      "properties": {
        "package_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "release_ready": {"const": false},
        "claim_eligible": {"const": false}
      }
    },
    "human_rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": {"$ref": "#/$defs/rubric_language"},
        "zh": {"$ref": "#/$defs/rubric_language"}
      }
    },
    "rubric_language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_ids", "criteria", "pass_condition"],
      "properties": {
        "criterion_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/code"}
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "pass_condition": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "required_duty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duty_label", "required_statement_ids", "required_gap_codes"],
      "properties": {
        "duty_label": {"$ref": "#/$defs/code"},
        "required_statement_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "required_gap_codes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/code"}
        }
      },
      "anyOf": [
        {"properties": {"required_statement_ids": {"minItems": 1}}},
        {"properties": {"required_gap_codes": {"minItems": 1}}}
      ]
    }
  }
}
