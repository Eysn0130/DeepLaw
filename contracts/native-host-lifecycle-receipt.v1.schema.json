{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/native-host-lifecycle-receipt.v1.schema.json",
  "title": "DeepLaw native Host lifecycle receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "host", "host_version", "event", "operation", "status",
    "native_seam_received", "host_hint_observed", "vault_rebound",
    "project_task_rebound", "repository_worktree_rebound",
    "task_continuity_result_schema", "task_handle_sha256", "project_sha256",
    "task_lineage_sha256", "parent_task_lineage_sha256", "write_performed",
    "transcript_copied", "host_memory_read", "authentication_material_read",
    "raw_log_retained", "claim_eligible", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.native-host-lifecycle-receipt/v1"},
    "host": {"enum": ["codex", "opencode"]},
    "host_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "event": {
      "enum": [
        "thread/start", "thread/resume", "thread/fork", "thread/compact/start",
        "cli.run", "cli.run.session", "cli.run.fork", "session/summarize",
        "session.compacted"
      ]
    },
    "operation": {"enum": ["start", "resume", "fork", "compaction"]},
    "status": {"type": "string", "minLength": 1, "maxLength": 100},
    "native_seam_received": {"const": true},
    "host_hint_observed": {"type": "boolean"},
    "vault_rebound": {"const": true},
    "project_task_rebound": {"const": true},
    "repository_worktree_rebound": {"const": true},
    "task_continuity_result_schema": {"const": "deeplaw.task-continuity-result/v2"},
    "task_handle_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "project_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "task_lineage_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "parent_task_lineage_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "write_performed": {"const": false},
    "transcript_copied": {"const": false},
    "host_memory_read": {"const": false},
    "authentication_material_read": {"const": false},
    "raw_log_retained": {"const": false},
    "claim_eligible": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
