{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.local/contracts/typed-compiler-quality-report.v1.schema.json",
  "title": "DeepLaw deterministic Typed Compiler quality report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "suite_sha256",
    "compiler_identity",
    "network_policy",
    "source_count",
    "case_count",
    "scorer_report",
    "quality_gate",
    "public_benchmark",
    "comparative_superiority_claim_eligible",
    "limitations",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.typed-compiler-quality-report/v1"},
    "suite_id": {"const": "deeplaw-public-typed-compiler-gold-v1"},
    "suite_sha256": {"$ref": "#/$defs/sha256"},
    "compiler_identity": {"const": "deeplaw-deterministic/v2"},
    "network_policy": {"const": "offline"},
    "source_count": {"type": "integer", "minimum": 2, "maximum": 20},
    "case_count": {"type": "integer", "minimum": 2, "maximum": 20},
    "scorer_report": {
      "$ref": "typed-compiler-benchmark.v1.schema.json"
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thresholds", "checks", "passed"],
      "properties": {
        "thresholds": {"type": "object"},
        "checks": {
          "type": "object",
          "additionalProperties": {"type": "boolean"},
          "minProperties": 7,
          "maxProperties": 7
        },
        "passed": {"type": "boolean"}
      }
    },
    "public_benchmark": {"const": true},
    "comparative_superiority_claim_eligible": {"const": false},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
