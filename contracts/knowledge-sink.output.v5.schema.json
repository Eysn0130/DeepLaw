                            "repository_sha256": {
                              "type": "string"
                            },
                            "worktree_sha256": {
                              "type": "string"
                            },
                            "base_revision": {
                              "type": "string"
                            },
                            "dirty_state_sha256": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    ]
                  },
                  "action_state": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "$id": "https://deeplaw.dev/contracts/task-action-state.v1.schema.json",
