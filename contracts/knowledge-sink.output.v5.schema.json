                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "worktree_sha256": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^[0-9a-f]{64}$"
