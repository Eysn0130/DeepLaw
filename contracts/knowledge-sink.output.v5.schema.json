                            "worktree_sha256": {
                              "type": "null"
                            },
                            "base_revision": {
                              "type": "null"
                            },
                            "dirty_state_sha256": {
                              "type": "null"
                            }
                          },
                          "required": [
                            "repository_sha256",
                            "worktree_sha256",
                            "base_revision",
                            "dirty_state_sha256"
