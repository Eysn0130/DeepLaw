              "tool_results_sha256",
              "scope",
              "sensitivity",
              "status",
              "started_at",
              "ended_at",
              "metadata",
              "recorded_at",
              "receipt_sha256",
              "idempotent_replay",
              "audit_head"
            ],
            "properties": {
