                    "properties": {
                      "schema_version": {
                        "const": "deeplaw.task-context-binding/v1"
                      },
                      "project_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "task_lineage_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
