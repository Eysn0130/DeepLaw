        "promote_knowledge_draft",
        "propose_knowledge_backfill",
        "refresh_compilation",
        "resume_compilation",
        "stage_compilation_batch",
        "validate_compilation",
        "stage_semantic_observations",
        "freeze_semantic_inventory",
