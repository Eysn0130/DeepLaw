{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/commercial-release-manifest.v8.schema.json",
  "title": "DeepLaw machine-only commercial release manifest v8",
  "description": "Release provenance for the machine_evaluated_no_human_attestation profile. release_ready authorizes the pre-public state; public_release_verified is a separate post-public state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "reference_provenance",
    "human_authenticity",
    "environment",
    "release",
    "run_ids",
    "candidate_binding",
    "artifact_binding",
    "external_bindings",
    "pre_publish_artifact_gate",
    "machine_evidence",
    "release_ready",
    "public_release_verified",
    "post_public_verification",
    "machine_qualification_claim_eligible",
    "human_attested_claim_eligible",
    "competitive_claim_eligible",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.commercial-release-manifest/v8"},
    "profile": {"const": "machine_evaluated_no_human_attestation"},
    "reference_provenance": {"const": "agent_consensus"},
    "human_authenticity": {"const": "not_claimed"},
    "environment": {"$ref": "#/$defs/environment"},
    "release": {"$ref": "#/$defs/release"},
    "run_ids": {"$ref": "#/$defs/runIds"},
    "candidate_binding": {"$ref": "#/$defs/candidateBinding"},
    "artifact_binding": {"$ref": "#/$defs/artifactBinding"},
    "external_bindings": {"$ref": "#/$defs/externalBindings"},
    "pre_publish_artifact_gate": {"$ref": "#/$defs/prePublishReceipt"},
    "machine_evidence": {"$ref": "#/$defs/machineEvidence"},
    "release_ready": {"type": "boolean"},
    "public_release_verified": {"type": "boolean"},
    "post_public_verification": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/postPublicReceipt"}]
    },
    "machine_qualification_claim_eligible": {"type": "boolean"},
    "human_attested_claim_eligible": {"const": false},
    "competitive_claim_eligible": {"const": false},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"release_ready": {"const": true}}, "required": ["release_ready"]},
      "then": {
        "properties": {
          "machine_evidence": {"$ref": "#/$defs/passedMachineEvidence"},
          "machine_qualification_claim_eligible": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"release_ready": {"const": false}}, "required": ["release_ready"]},
      "then": {"properties": {"machine_qualification_claim_eligible": {"const": false}}}
    },
    {
      "if": {"properties": {"public_release_verified": {"const": true}}, "required": ["public_release_verified"]},
      "then": {"properties": {"post_public_verification": {"$ref": "#/$defs/postPublicReceipt"}}}
    },
    {
      "if": {"properties": {"public_release_verified": {"const": false}}, "required": ["public_release_verified"]},
      "then": {"properties": {"post_public_verification": {"type": "null"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!\\\\)(?![A-Za-z]:)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000]+$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_system",
        "platform_release",
        "platform_version",
        "machine",
        "python_implementation",
        "python_version",
        "python_executable_name",
        "uv_version",
        "ci",
        "github_actions",
        "github_runner_os",
        "github_runner_arch"
      ],
      "properties": {
        "platform_system": {"type": "string", "minLength": 1, "maxLength": 100},
        "platform_release": {"type": "string", "minLength": 1, "maxLength": 200},
        "platform_version": {"type": "string", "minLength": 1, "maxLength": 200},
        "machine": {"type": "string", "minLength": 1, "maxLength": 100},
        "python_implementation": {"type": "string", "minLength": 1, "maxLength": 100},
        "python_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "python_executable_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "uv_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "ci": {"type": "boolean"},
        "github_actions": {"type": "boolean"},
        "github_runner_os": {"type": ["string", "null"], "maxLength": 100},
        "github_runner_arch": {"type": ["string", "null"], "maxLength": 100}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "tag", "commit", "tree"],
      "properties": {
        "repository": {"const": "Eysn0130/DeepLaw"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commit": {"$ref": "#/$defs/git"},
        "tree": {"$ref": "#/$defs/git"}
      }
    },
    "runIds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_run_id", "evidence_run_id", "qualification_run_id"],
      "properties": {
        "candidate_run_id": {"type": "integer", "minimum": 1},
        "evidence_run_id": {"type": "integer", "minimum": 1},
        "qualification_run_id": {"type": "integer", "minimum": 1}
      }
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "lock_sha256", "wheel_sha256", "sdist_sha256", "version"],
      "properties": {
        "commit": {"$ref": "#/$defs/git"},
        "tree": {"$ref": "#/$defs/git"},
        "lock_sha256": {"$ref": "#/$defs/sha256"},
        "wheel_sha256": {"$ref": "#/$defs/sha256"},
        "sdist_sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_size"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 1}
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wheel", "sdist", "retained_manifest_sha256"],
      "properties": {
        "wheel": {"$ref": "#/$defs/artifact"},
        "sdist": {"$ref": "#/$defs/artifact"},
        "retained_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "externalBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_reference_sha256",
        "machine_binding_sha256",
        "holdout_sha256",
        "blind_sha256",
        "agent_roster_sha256",
        "agent_consensus_sha256",
        "agent_isolation_sha256",
        "scorer_panel_sha256",
        "arbiter_sha256",
        "runner_sha256",
        "isolation_sha256"
      ],
      "properties": {
        "semantic_reference_sha256": {"$ref": "#/$defs/sha256"},
        "machine_binding_sha256": {"$ref": "#/$defs/sha256"},
        "holdout_sha256": {"$ref": "#/$defs/sha256"},
        "blind_sha256": {"$ref": "#/$defs/sha256"},
        "agent_roster_sha256": {"$ref": "#/$defs/sha256"},
        "agent_consensus_sha256": {"$ref": "#/$defs/sha256"},
        "agent_isolation_sha256": {"$ref": "#/$defs/sha256"},
        "scorer_panel_sha256": {"$ref": "#/$defs/sha256"},
        "arbiter_sha256": {"$ref": "#/$defs/sha256"},
        "runner_sha256": {"$ref": "#/$defs/sha256"},
        "isolation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "prePublishReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "receipt_sha256", "status"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "pre_publish_passed"}
      }
    },
    "referenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_reference_sha256",
        "agent_roster_sha256",
        "agent_consensus_sha256",
        "agent_isolation_sha256",
        "scorer_panel_sha256",
        "arbiter_sha256",
        "frozen"
      ],
      "properties": {
        "semantic_reference_sha256": {"$ref": "#/$defs/sha256"},
        "agent_roster_sha256": {"$ref": "#/$defs/sha256"},
        "agent_consensus_sha256": {"$ref": "#/$defs/sha256"},
        "agent_isolation_sha256": {"$ref": "#/$defs/sha256"},
        "scorer_panel_sha256": {"$ref": "#/$defs/sha256"},
        "arbiter_sha256": {"$ref": "#/$defs/sha256"},
        "frozen": {"const": true}
      }
    },
    "machineEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_path", "report_sha256", "record_sha256", "status", "hard_zero", "core_gates_passed", "reference_binding"],
      "properties": {
        "report_path": {"$ref": "#/$defs/safePath"},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["passed", "failed", "not_executed"]},
        "hard_zero": {"type": "boolean"},
        "core_gates_passed": {"type": "boolean"},
        "reference_binding": {"$ref": "#/$defs/referenceBinding"}
      }
    },
    "passedMachineEvidence": {
      "allOf": [
        {"$ref": "#/$defs/machineEvidence"},
        {"properties": {"status": {"const": "passed"}, "hard_zero": {"const": true}, "core_gates_passed": {"const": true}}}
      ]
    },
    "artifactHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wheel_sha256", "sdist_sha256"],
      "properties": {
        "wheel_sha256": {"$ref": "#/$defs/sha256"},
        "sdist_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "bundle_sha256", "verified"],
      "properties": {
        "identity": {"$ref": "#/$defs/identifier"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "verified": {"const": true}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "attestation_sha256", "verified"],
      "properties": {
        "identity": {"$ref": "#/$defs/identifier"},
        "attestation_sha256": {"$ref": "#/$defs/sha256"},
        "verified": {"const": true}
      }
    },
    "redownload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "source", "wheel_sha256", "sdist_sha256", "sha256_matches"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/identifier"},
        "source": {"const": "anonymous_public_redownload"},
        "wheel_sha256": {"$ref": "#/$defs/sha256"},
        "sdist_sha256": {"$ref": "#/$defs/sha256"},
        "sha256_matches": {"const": true}
      }
    },
    "postPublicReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "verified_at",
        "artifact_binding",
        "sigstore",
        "attestation",
        "anonymous_redownload",
        "public_sha256",
        "public_release_verified",
        "record_sha256"
      ],
      "properties": {
        "schema_version": {"const": "deeplaw.post-public-verification/v1"},
        "status": {"const": "post_public_verified"},
        "verified_at": {"type": "string", "format": "date-time"},
        "artifact_binding": {"$ref": "#/$defs/artifactHashes"},
        "sigstore": {"$ref": "#/$defs/verification"},
        "attestation": {"$ref": "#/$defs/attestation"},
        "anonymous_redownload": {"$ref": "#/$defs/redownload"},
        "public_sha256": {"$ref": "#/$defs/artifactHashes"},
        "public_release_verified": {"const": true},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
