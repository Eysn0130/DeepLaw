{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/purpose-aware-retrieval.v4.schema.json",
  "title": "DeepLaw purpose-aware statement-selective retrieval v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vault_id",
    "purpose",
    "policy_id",
    "query",
    "query_plan",
    "query_plan_sha256",
    "statements",
    "evidence",
    "contradictions",
    "gaps",
    "capsule",
    "projection",
    "receipt_id",
    "local_audit",
    "metrics",
    "budget",
    "audit_head",
    "authority_changed_by_ranking",
    "write_performed",
    "knowledge_revisions"
  ],
  "properties": {
    "schema_version": {
      "const": "deeplaw.purpose-aware-retrieval/v4"
    },
    "vault_id": {
      "type": "string",
      "pattern": "^(vault_[0-9a-f]{24})?$"
    },
    "purpose": {
      "enum": [
        "answer",
        "verify",
        "quote",
        "historical",
        "legal",
        "debug",
        "freshness_check"
      ]
    },
    "policy_id": {
      "enum": [
        "compiled-first-v1",
        "evidence-first-v1",
        "balanced-v1"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "query_plan": {
      "type": "object"
    },
    "query_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "statements": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object"
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object"
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object"
      }
    },
    "capsule": {
      "type": "object"
    },
    "projection": {
      "enum": [
        "compact",
        "standard",
        "audit"
      ]
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^queryreceipt_[0-9a-f]{24}$"
    },
    "local_audit": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "budget": {
      "type": "object",
      "required": [
        "selected_tokens",
        "token_count_mode"
      ],
      "properties": {
        "selected_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32000
        },
        "token_count_mode": {
          "const": "estimated"
        }
      }
    },
    "audit_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_changed_by_ranking": {
      "const": false
    },
    "write_performed": {
      "const": false
    },
    "knowledge_revisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_id",
          "revision_id",
          "kind",
          "title",
          "content",
          "content_sha256",
          "content_truncated",
          "origin",
          "authority",
          "legal_authority",
          "source_free",
          "source_refs",
          "epistemic_state",
          "verification",
          "lifecycle",
          "directive_mode",
          "valid_from",
          "valid_to",
          "expires_at",
          "selection_reason",
          "freshness"
        ],
        "properties": {
          "knowledge_id": {
            "type": "string",
            "pattern": "^knowledge_[0-9a-f]{24}$"
          },
          "revision_id": {
            "type": "string",
            "pattern": "^knowledgerev_[0-9a-f]{24}$"
          },
          "kind": {
            "type": "string",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "content": {
            "type": "string",
            "maxLength": 2000
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_truncated": {
            "type": "boolean"
          },
          "origin": {
            "const": "agent_derived"
          },
          "authority": {
            "const": "agent_derived"
          },
          "legal_authority": {
            "const": false
          },
          "source_free": {
            "const": true
          },
          "source_refs": {
            "type": "array",
            "maxItems": 0
          },
          "epistemic_state": {
            "const": "tentative"
          },
          "verification": {
            "enum": [
              "unverified",
              "run_bound"
            ]
          },
          "lifecycle": {
            "const": "active"
          },
          "directive_mode": {
            "const": "data_only"
          },
          "valid_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "selection_reason": {
            "const": "admitted_governed_revision"
          },
          "freshness": {
            "const": "unknown"
          }
        }
      }
    }
  }
}
