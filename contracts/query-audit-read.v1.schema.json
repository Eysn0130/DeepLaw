{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/query-audit-read.v1.schema.json",
  "title": "DeepLaw bounded local Query Audit Read v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "audit", "write_performed"],
  "properties": {
    "schema_version": {"const": "deeplaw.query-audit-read/v1"},
    "receipt_id": {"type": "string", "pattern": "^queryreceipt_[0-9a-f]{24}$"},
    "audit": {"$ref": "#/$defs/audit"},
    "write_performed": {"const": false}
  },
  "$defs": {
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "receipt_id", "query_plan_sha256", "query_sha256",
        "input_audit_head", "input_legacy_audit_head", "candidate_count",
        "admitted_statement_count", "selected_statement_ids", "fallback",
        "deduplications", "suppressions", "rejections", "residual_gap_ids",
        "ranking_authority_changed", "write_performed", "receipt_sha256"
      ],
      "properties": {
        "schema_version": {"const": "deeplaw.query-audit-receipt/v1"},
        "receipt_id": {"type": "string", "pattern": "^queryreceipt_[0-9a-f]{24}$"},
        "query_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_legacy_audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_count": {"type": "integer", "minimum": 0},
        "admitted_statement_count": {"type": "integer", "minimum": 0},
        "selected_statement_ids": {
          "type": "array", "maxItems": 20, "uniqueItems": true,
          "items": {"type": "string"}
        },
        "fallback": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/audit_item"}},
        "deduplications": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/audit_item"}},
        "suppressions": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/audit_item"}},
        "rejections": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/audit_item"}},
        "residual_gap_ids": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string"}
        },
        "ranking_authority_changed": {"const": false},
        "write_performed": {"const": false},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "audit_item": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "reason": {"type": "string", "minLength": 1, "maxLength": 128},
        "duty": {"type": "string", "minLength": 1, "maxLength": 128},
        "statement_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_key_sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {
              "type": "array",
              "maxItems": 16,
              "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          ]
        },
        "query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_count": {"type": "integer", "minimum": 0},
        "selected_source_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
