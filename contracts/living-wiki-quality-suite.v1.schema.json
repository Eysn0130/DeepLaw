{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/living-wiki-quality-suite.v1.schema.json",
  "title": "DeepLaw Living Wiki CLI quality suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "status",
    "frozen_at",
    "evaluator",
    "corpus",
    "configuration",
    "ranked_cases",
    "lifecycle_cases",
    "quality_gate",
    "competitive_claim_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "deeplaw.living-wiki-quality-suite/v1"
    },
    "suite_id": {
      "$ref": "#/$defs/identifier"
    },
    "status": {
      "const": "public_deterministic_gold"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "human_semantic_gold",
        "limitations"
      ],
      "properties": {
        "type": {
          "const": "deterministic_expected_identity_and_citation"
        },
        "human_semantic_gold": {
          "const": false
        },
        "limitations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "corpus": {
      "type": "object"
    },
    "configuration": {
      "type": "object"
    },
    "ranked_cases": {
      "type": "array",
      "minItems": 13,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "category",
          "query",
          "purpose",
          "expected_titles",
          "top_k"
        ],
        "properties": {
          "case_id": {
            "$ref": "#/$defs/identifier"
          },
          "category": {
            "$ref": "#/$defs/identifier"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "purpose": {
            "enum": [
              "answer",
              "verify",
              "quote",
              "historical",
              "legal",
              "debug",
              "freshness_check"
            ]
          },
          "expected_titles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    },
    "lifecycle_cases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "quality_gate": {
      "type": "object"
    },
    "competitive_claim_eligible": {
      "const": false
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"
    }
  }
}
