{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/official-baseline-resource-record.v1.schema.json",
  "title": "DeepLaw official-baseline resource and failure record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "system_id", "implementation_revision", "registry_sha256",
    "corpus_sha256", "queries_sha256", "query_case_ids_sha256",
    "evaluation_environment_record_sha256", "case_count", "build_seconds",
    "query_seconds", "peak_memory_bytes", "index_bytes", "workspace_bytes",
    "model_calls", "model_input_tokens", "model_output_tokens", "model_cost_usd",
    "failure_count", "failures", "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.official-baseline-resource-record/v1"},
    "system_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "implementation_revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_sha256": {"$ref": "#/$defs/sha256"},
    "queries_sha256": {"$ref": "#/$defs/sha256"},
    "query_case_ids_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_environment_record_sha256": {"$ref": "#/$defs/sha256"},
    "case_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "build_seconds": {"type": "number", "minimum": 0},
    "query_seconds": {"type": "number", "minimum": 0},
    "peak_memory_bytes": {"$ref": "#/$defs/nonnegative_integer"},
    "index_bytes": {"$ref": "#/$defs/nonnegative_integer"},
    "workspace_bytes": {"$ref": "#/$defs/nonnegative_integer"},
    "model_calls": {"$ref": "#/$defs/nonnegative_integer"},
    "model_input_tokens": {"$ref": "#/$defs/nonnegative_integer"},
    "model_output_tokens": {"$ref": "#/$defs/nonnegative_integer"},
    "model_cost_usd": {"type": "number", "minimum": 0},
    "failure_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "failures": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "phase", "kind", "message_sha256"],
        "properties": {
          "case_id": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 500
          },
          "phase": {"enum": ["setup", "build", "query", "teardown"]},
          "kind": {"enum": ["error", "timeout", "abstention", "retry"]},
          "message_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  }
}
