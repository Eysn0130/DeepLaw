{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.local/contracts/host-session-route-result.v2.schema.json",
  "title": "DeepLaw Host Session Route Result v2",
  "oneOf": [
    { "$ref": "#/$defs/bound" },
    { "$ref": "#/$defs/exact" },
    { "$ref": "#/$defs/gap" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "route_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_sha256",
        "task_lineage_sha256",
        "repository_sha256",
        "worktree_sha256",
        "session_sha256"
      ],
      "properties": {
        "project_sha256": { "$ref": "#/$defs/sha256" },
        "task_lineage_sha256": { "$ref": "#/$defs/sha256" },
        "repository_sha256": { "$ref": "#/$defs/sha256" },
        "worktree_sha256": { "$ref": "#/$defs/sha256" },
        "session_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "workspace_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_revision",
        "dirty_state_sha256",
        "snapshot_sha256"
      ],
      "properties": {
        "base_revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "dirty_state_sha256": { "$ref": "#/$defs/sha256" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "status",
        "host",
        "session_sha256",
        "task_handle",
        "task_handle_sha256",
        "repository_sha256",
        "worktree_sha256",
        "route_identity",
        "workspace_snapshot",
        "run_id",
        "write_performed",
        "transcript_copied",
        "idempotent_replay"
      ],
      "properties": {
        "schema_version": {
          "const": "deeplaw.host-session-route-result/v2"
        },
        "operation": { "const": "bind" },
        "status": { "const": "bound" },
        "host": { "enum": ["codex", "opencode"] },
        "session_sha256": { "$ref": "#/$defs/sha256" },
        "task_handle": {
          "type": "string",
          "pattern": "^taskh_[A-Za-z0-9_-]+$",
          "maxLength": 2048
        },
        "task_handle_sha256": { "$ref": "#/$defs/sha256" },
        "repository_sha256": { "$ref": "#/$defs/sha256" },
        "worktree_sha256": { "$ref": "#/$defs/sha256" },
        "route_identity": { "$ref": "#/$defs/route_identity" },
        "workspace_snapshot": { "$ref": "#/$defs/workspace_snapshot" },
        "run_id": {
          "type": "string",
          "pattern": "^hostroute_[0-9a-f]{24}$"
        },
        "write_performed": { "const": true },
        "transcript_copied": { "const": false },
        "idempotent_replay": { "type": "boolean" }
      }
    },
    "exact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "status",
        "host",
        "session_sha256",
        "task_handle",
        "task_handle_sha256",
        "repository_sha256",
        "worktree_sha256",
        "route_identity",
        "workspace_snapshot",
        "binding_sha256",
        "checkpoint_status",
        "write_performed",
        "transcript_copied"
      ],
      "properties": {
        "schema_version": {
          "const": "deeplaw.host-session-route-result/v2"
        },
        "operation": { "const": "resolve" },
        "status": { "const": "exact" },
        "host": { "enum": ["codex", "opencode"] },
        "session_sha256": { "$ref": "#/$defs/sha256" },
        "task_handle": {
          "type": "string",
          "pattern": "^taskh_[A-Za-z0-9_-]+$",
          "maxLength": 2048
        },
        "task_handle_sha256": { "$ref": "#/$defs/sha256" },
        "repository_sha256": { "$ref": "#/$defs/sha256" },
        "worktree_sha256": { "$ref": "#/$defs/sha256" },
        "route_identity": { "$ref": "#/$defs/route_identity" },
        "workspace_snapshot": { "$ref": "#/$defs/workspace_snapshot" },
        "binding_sha256": { "$ref": "#/$defs/sha256" },
        "checkpoint_status": {
          "enum": [
            "exact",
            "workspace_diverged",
            "forgotten",
            "ambiguous",
            "not_found",
            "index_unavailable"
          ]
        },
        "write_performed": { "const": false },
        "transcript_copied": { "const": false }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "status",
        "host",
        "session_sha256",
        "write_performed",
        "transcript_copied",
        "gap"
      ],
      "properties": {
        "schema_version": {
          "const": "deeplaw.host-session-route-result/v2"
        },
        "operation": { "const": "resolve" },
        "status": { "const": "gap" },
        "host": { "enum": ["codex", "opencode"] },
        "session_sha256": { "$ref": "#/$defs/sha256" },
        "write_performed": { "const": false },
        "transcript_copied": { "const": false },
        "gap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": {
              "enum": [
                "route_unbound",
                "route_ambiguous",
                "route_wrong_worktree",
                "route_stale",
                "route_forgotten",
                "workspace_snapshot_bound",
                "workspace_secret_unverifiable"
              ]
            },
            "candidate_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 101
            }
          }
        }
      }
    }
  }
}
