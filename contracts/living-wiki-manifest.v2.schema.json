{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/living-wiki-manifest.v2.schema.json",
  "title": "DeepLaw Living Wiki Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "input_audit_head", "legacy_audit_head", "generator",
    "generator_version", "configuration", "configuration_sha256",
    "knowledge_revision_count", "knowledge_revision_ids_sha256",
    "relation_revision_count", "relation_revision_ids_sha256",
    "source_revision_count", "community_count", "files", "canvas_manifests",
    "generated_at", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.living-wiki-manifest/v2"},
    "input_audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "legacy_audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generator": {"const": "deeplaw.living-wiki-projector/2"},
    "generator_version": {"const": "2"},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_profile", "projection_profile_sha256", "index_shard_size",
        "source_fragment_shard_size", "canvas_node_limit", "canvas_edge_limit",
        "page_kinds", "community_algorithm", "local_canvas_per_object",
        "compilation_state_sha256"
      ],
      "properties": {
        "projection_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version", "name", "version", "root_index", "overview",
            "source_pages", "core_object_pages", "recent_changes", "gaps",
            "kind_shards", "kind_indexes", "communities", "global_canvas",
            "kind_canvas", "community_canvas", "per_object_canvas",
            "local_canvas_per_object"
          ],
          "properties": {
            "schema_version": {"const": "deeplaw.projection-profile/v1"},
            "name": {"enum": ["minimal", "standard", "full"]},
            "version": {"enum": ["1", "2"]},
            "root_index": {"type": "boolean"},
            "overview": {"type": "boolean"},
            "source_pages": {"type": "boolean"},
            "core_object_pages": {"type": "boolean"},
            "recent_changes": {"type": "boolean"},
            "gaps": {"type": "boolean"},
            "kind_shards": {"type": "boolean"},
            "kind_indexes": {"type": "boolean"},
            "communities": {"type": "boolean"},
            "global_canvas": {"type": "boolean"},
            "kind_canvas": {"type": "boolean"},
            "community_canvas": {"type": "boolean"},
            "per_object_canvas": {"type": "boolean"},
            "local_canvas_per_object": {"type": "boolean"}
          }
        },
        "projection_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "index_shard_size": {"const": 200},
        "source_fragment_shard_size": {"const": 64},
        "canvas_node_limit": {"const": 200},
        "canvas_edge_limit": {"const": 400},
        "page_kinds": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {
            "enum": [
              "claim", "comparison", "concept", "decision", "entity", "event",
              "experience", "memory", "preference", "procedure", "skill", "synthesis"
            ]
          }
        },
        "community_algorithm": {
          "const": "weighted-label-propagation+semantic-bridges/1"
        },
        "local_canvas_per_object": {"type": "boolean"},
        "compilation_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "knowledge_revision_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "knowledge_revision_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relation_revision_count": {"type": "integer", "minimum": 0, "maximum": 2000000},
    "relation_revision_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "community_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "files": {
      "type": "array", "maxItems": 1000000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "byte_size", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 2000},
          "byte_size": {"type": "integer", "minimum": 0, "maximum": 262144},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "canvas_manifests": {
      "type": "array", "maxItems": 1000000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "name", "node_count", "edge_count", "truncated_nodes",
          "truncated_edges", "path", "sha256"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 512},
          "node_count": {"type": "integer", "minimum": 0, "maximum": 200},
          "edge_count": {"type": "integer", "minimum": 0, "maximum": 400},
          "truncated_nodes": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "truncated_edges": {"type": "integer", "minimum": 0, "maximum": 2000000},
          "path": {"type": "string", "pattern": "^canvas/.+\\.canvas$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
