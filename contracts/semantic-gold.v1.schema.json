{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/semantic-gold.v1.schema.json",
  "title": "DeepLaw Maintainer Semantic Gold v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gold_id", "status", "fixture_manifest_sha256",
    "created_at", "review", "scoring_policy", "sources", "cases",
    "security_challenges", "hard_failure_expectations", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.semantic-gold/v1"},
    "gold_id": {"type": "string", "pattern": "^semanticgold_[0-9a-f]{24}$"},
    "status": {
      "enum": ["maintainer_review_pending", "maintainer_confirmed", "rejected"]
    },
    "fixture_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "review": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["reviewer_id", "reviewed_at", "reason", "gold_sha256"],
          "properties": {
            "reviewer_id": {"type": "string", "minLength": 1, "maxLength": 200},
            "reviewed_at": {"type": "string", "format": "date-time"},
            "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
            "gold_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "scoring_policy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "entity_concept_annotation_scope", "extra_valid_objects_are_false_positive",
        "precision_definition", "extraction_completeness_definition",
        "source_coverage_definition", "source_coverage_metric",
        "retrieval_source_coverage_definition", "performance_comparison_definition",
        "performance_repetition_count", "performance_execution_order",
        "performance_pairing_definition", "performance_aggregation_definition",
        "performance_confidence_definition", "latency_definition",
        "peak_rss_definition", "performance_tolerance_fraction"
      ],
      "properties": {
        "entity_concept_annotation_scope": {"const": "target_scoped"},
        "extra_valid_objects_are_false_positive": {"const": false},
        "precision_definition": {
          "const": "For each labelled target within its frozen case source and claim scope, one stable Knowledge ID is a true positive and additional stable IDs matched to that same target are false positives; valid objects outside that source and claim scope are excluded from the denominator."
        },
        "extraction_completeness_definition": {
          "const": "Required labelled targets retrieved or compiled divided by all required labelled targets."
        },
        "source_coverage_definition": {
          "const": "Covered Source IR fragments divided by covered plus explicitly omitted fragments across the frozen sources."
        },
        "source_coverage_metric": {
          "const": "source_ir_fragment_coverage"
        },
        "retrieval_source_coverage_definition": {
          "const": "Distinct relevant Source Revisions selected by at least one frozen query divided by all distinct relevant Source Revisions referenced by the frozen query set."
        },
        "performance_comparison_definition": {
          "const": "Same-condition baseline and candidate reports use identical frozen query, budget, retrieval, source-revision, and execution-environment fields. Deterministic quality and normalized provider-byte metrics compare the median of three run-level values exactly. Latency and per-process peak RSS use the frozen paired bootstrap method with zero effect-size tolerance."
        },
        "performance_repetition_count": {
          "const": 3
        },
        "performance_execution_order": {
          "const": [
            "baseline", "candidate", "candidate", "baseline", "baseline", "candidate"
          ]
        },
        "performance_pairing_definition": {
          "const": "Adjacent alternating runs form three ordered pairs at zero-based report positions baseline/candidate (0,1), (3,2), and (4,5); every pair contains the same 15 case IDs and security-challenge inventory."
        },
        "performance_aggregation_definition": {
          "const": "Deterministic metrics use the median of three run-level values. Latency uses all 45 paired per-case observations for p50 and p95. RSS uses all paired cold, warm, and supported challenge-process observations and reports the maximum."
        },
        "performance_confidence_definition": {
          "const": "For each latency statistic and maximum per-process RSS, resample paired observations together 10000 times using a SHA-256 report-bound deterministic seed and a two-sided percentile 95% confidence interval for candidate-minus-baseline. A regression is detected only when the complete interval is greater than zero. The observed values, delta, interval, sample count, and every raw run report remain reviewable."
        },
        "latency_definition": {
          "const": "Cold is the first fresh CLI process after deterministic compilation with the DeepLaw query cache empty and OS page cache retained; warm is the immediate identical second query in a fresh CLI process over unchanged persisted state. Each run reports p50 and p95 across all 15 cases; the replicate gate uses all 45 paired observations."
        },
        "peak_rss_definition": {
          "const": "Maximum sampled resident set size of a first-party CLI query or adversarial-challenge process. Each process is paired by case and cold/warm phase or challenge ID; the replicate gate reports the maximum and its paired-bootstrap delta interval. Audit-helper and benchmark-orchestrator processes are excluded. Unsupported platforms report null."
        },
        "performance_tolerance_fraction": {
          "const": 0
        }
      }
    },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "source_key", "relative_path", "media_type", "bytes_sha256", "sensitivity"
        ],
        "properties": {
          "source_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"},
          "relative_path": {
            "type": "string", "pattern": "^benchmarks/semantic/fixtures/[A-Za-z0-9._-]+$"
          },
          "media_type": {"type": "string", "minLength": 1, "maxLength": 200},
          "bytes_sha256": {"$ref": "#/$defs/sha256"},
          "sensitivity": {"enum": ["public", "restricted"]}
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 15, "maxItems": 100,
      "items": {"$ref": "#/$defs/case"}
    },
    "security_challenges": {
      "type": "array", "minItems": 5, "maxItems": 20, "uniqueItems": true,
      "items": {"$ref": "#/$defs/security_challenge"}
    },
    "hard_failure_expectations": {
      "type": "object", "additionalProperties": false,
      "required": [
        "wrong_entity_merge", "invented_source_revision", "invalid_locator",
        "invalid_quote_hash", "unsupported_authoritative_claim", "authority_elevation",
        "unauthorized_mutation", "stale_prohibited_selection",
        "withdrawn_content_admission", "unauthorized_disclosure",
        "restricted_disclosure", "invalid_official_citation", "prompt_injection",
        "provider_hard_limit_violation", "silent_fallback",
        "partial_publication_reported_complete", "unrecoverable_run"
      ],
      "properties": {
        "wrong_entity_merge": {"const": 0},
        "invented_source_revision": {"const": 0},
        "invalid_locator": {"const": 0},
        "invalid_quote_hash": {"const": 0},
        "unsupported_authoritative_claim": {"const": 0},
        "authority_elevation": {"const": 0},
        "unauthorized_mutation": {"const": 0},
        "stale_prohibited_selection": {"const": 0},
        "withdrawn_content_admission": {"const": 0},
        "unauthorized_disclosure": {"const": 0},
        "restricted_disclosure": {"const": 0},
        "invalid_official_citation": {"const": 0},
        "prompt_injection": {"const": 0},
        "provider_hard_limit_violation": {"const": 0},
        "silent_fallback": {"const": 0},
        "partial_publication_reported_complete": {"const": 0},
        "unrecoverable_run": {"const": 0}
      }
    },
    "limitations": {
      "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case": {
      "type": "object", "additionalProperties": false,
      "required": [
        "case_id", "task_type", "query", "purpose", "source_keys", "expected_objects",
        "forbidden_merges", "required_outcomes", "query_phase", "notes"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^semantic-case-[0-9]{2}$"},
        "task_type": {
          "enum": [
            "long_document_cross_packet_entity", "same_name_distinct_entities",
            "entity_aliases", "cross_section_concept_fusion", "source_conflict",
            "source_summary", "procedure_extraction", "event_timeline",
            "source_successor_update", "source_withdrawal", "cross_source_synthesis",
            "overview_refresh", "unanswerable", "prompt_injection", "multi_format"
          ]
        },
        "query": {"type": "string", "minLength": 1, "maxLength": 1000},
        "purpose": {
          "enum": ["answer", "verify", "quote", "historical", "freshness_check"]
        },
        "query_phase": {"enum": ["baseline", "post_transition"]},
        "as_of": {"type": "string", "format": "date-time"},
        "source_keys": {
          "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"}
        },
        "expected_objects": {
          "type": "array", "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["label_id", "kind", "canonical_label", "aliases", "required"],
            "properties": {
              "label_id": {"type": "string", "pattern": "^label-[a-z0-9-]+$"},
              "kind": {
                "enum": ["claim", "concept", "entity", "event", "procedure", "synthesis"]
              },
              "canonical_label": {"type": "string", "minLength": 1, "maxLength": 500},
              "aliases": {
                "type": "array", "maxItems": 20, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 300}
              },
              "required": {"type": "boolean"},
              "stable_identity_group": {
                "type": "string", "pattern": "^identity-group-[a-z0-9-]+$"
              },
              "content_assertions": {
                "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
                "items": {"$ref": "#/$defs/content_assertion"}
              }
            },
            "allOf": [{
              "if": {"properties": {"kind": {"const": "synthesis"}}},
              "then": {"required": ["content_assertions"]}
            }]
          }
        },
        "forbidden_merges": {
          "type": "array", "maxItems": 100,
          "items": {
            "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^label-[a-z0-9-]+$"}
          }
        },
        "required_outcomes": {
          "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
          "items": {
            "enum": [
              "source_summary", "complete_coverage", "contradiction_preserved",
              "latest_revision_selected", "withdrawn_revision_rejected",
              "overview_revised", "explicit_gap", "authority_unchanged",
              "valid_evidence_bindings", "multi_format_consistency",
              "distinct_packet_observations", "stable_identity_merge"
            ]
          }
        },
        "expected_sequence": {
          "type": "array", "maxItems": 50,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "notes": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "content_assertion": {
      "type": "object", "additionalProperties": false,
      "required": [
        "claim_id", "statement", "required_terms", "source_keys",
        "expected_entailment", "evaluation_method"
      ],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^claim-gold-[a-z0-9-]+$"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
        "required_terms": {
          "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "source_keys": {
          "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"}
        },
        "expected_entailment": {"const": "entailed"},
        "evaluation_method": {"const": "deterministic_required_terms_and_human_review"}
      }
    },
    "security_challenge": {
      "type": "object", "additionalProperties": false,
      "required": [
        "challenge_id", "challenge_type", "query", "purpose", "source_keys",
        "max_sensitivity", "expected_outcome", "required_execution_count"
      ],
      "properties": {
        "challenge_id": {"type": "string", "pattern": "^security-challenge-[0-9]{2}$"},
        "challenge_type": {
          "enum": [
            "prompt_injection", "unsupported_authoritative_claim",
            "restricted_disclosure", "unauthorized_mutation", "silent_fallback"
          ]
        },
        "query": {"type": "string", "minLength": 1, "maxLength": 1000},
        "purpose": {"enum": ["answer", "verify", "quote", "historical", "freshness_check"]},
        "source_keys": {
          "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"}
        },
        "max_sensitivity": {"const": "public"},
        "expected_outcome": {
          "enum": [
            "authority_unchanged", "unsupported_authority_rejected",
            "restricted_source_not_disclosed", "mutation_rejected",
            "explicit_gap_without_silent_fallback"
          ]
        },
        "required_execution_count": {"const": 1}
      }
    }
  }
}
