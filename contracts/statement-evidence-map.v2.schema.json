{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/statement-evidence-map.v2.schema.json",
  "title": "DeepLaw Statement Evidence Map v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "statement_id",
    "knowledge_revision_id",
    "ordinal",
    "char_start",
    "char_end",
    "statement_text",
    "statement_sha256",
    "statement_type",
    "support_status",
    "valid_from",
    "valid_to",
    "limitation",
    "input_set_sha256",
    "source_refs",
    "knowledge_revision_refs",
    "relation_revision_refs",
    "gaps",
    "support_sets"
  ],
  "properties": {
    "schema_version": {
      "const": "deeplaw.statement-evidence-map/v2"
    },
    "statement_id": {
      "type": "string",
      "pattern": "^statement_[0-9a-f]{24}$"
    },
    "knowledge_revision_id": {
      "type": "string",
      "pattern": "^knowledgerev_[0-9a-f]{24}$"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "char_start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200000
    },
    "char_end": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200000
    },
    "statement_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "statement_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "statement_type": {
      "enum": [
        "factual",
        "interpretation",
        "limitation",
        "unresolved"
      ]
    },
    "support_status": {
      "enum": [
        "supported",
        "contested",
        "unsupported",
        "not_applicable"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "limitation": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4000
    },
    "input_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceReference"
      }
    },
    "knowledge_revision_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^knowledgerev_[0-9a-f]{24}$"
      }
    },
    "relation_revision_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^relationrev_[0-9a-f]{24}$"
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "support_sets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_refs",
          "knowledge_revision_refs",
          "relation_revision_refs"
        ],
        "properties": {
          "source_refs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/sourceReference"
            }
          },
          "knowledge_revision_refs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^knowledgerev_[0-9a-f]{24}$"
            }
          },
          "relation_revision_refs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^relationrev_[0-9a-f]{24}$"
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "source_refs": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "knowledge_revision_refs": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "relation_revision_refs": {
                "minItems": 1
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision_id",
        "fragment_id",
        "locator",
        "quote_sha256"
      ],
      "properties": {
        "source_revision_id": {
          "type": "string",
          "pattern": "^sourcerev_[0-9a-f]{24}$"
        },
        "fragment_id": {
          "type": "string",
          "pattern": "^fragment_[0-9a-f]{24}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "quote_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "reason"
      ],
      "properties": {
        "gap_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "support_status": {
            "const": "supported"
          }
        },
        "required": [
          "support_status"
        ]
      },
      "then": {
        "properties": {
          "support_sets": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
