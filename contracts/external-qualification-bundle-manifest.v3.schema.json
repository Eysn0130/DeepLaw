{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/external-qualification-bundle-manifest.v3.schema.json",
  "title": "DeepLaw current-only External Qualification Bundle Manifest v3",
  "description": "Closed, current-only inventory contract for typed qualification evidence and opaque retained artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_run_id",
    "evidence_run_id",
    "candidate_binding",
    "external_inputs",
    "trusted_human_approver_descriptor_sha256",
    "candidate_full_raw_inventory_sha256",
    "files",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "deeplaw.external-qualification-bundle-manifest/v3"
    },
    "candidate_run_id": {"type": "integer", "minimum": 1},
    "evidence_run_id": {"type": "integer", "minimum": 1},
    "candidate_binding": {"$ref": "#/$defs/candidateBinding"},
    "external_inputs": {"$ref": "#/$defs/externalInputs"},
    "trusted_human_approver_descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_full_raw_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/file"}
    },
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!\\\\)(?![A-Za-z]:)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "lock_sha256",
        "wheel_sha256",
        "sdist_sha256"
      ],
      "properties": {
        "commit": {"$ref": "#/$defs/git"},
        "tree": {"$ref": "#/$defs/git"},
        "lock_sha256": {"$ref": "#/$defs/sha256"},
        "wheel_sha256": {"$ref": "#/$defs/sha256"},
        "sdist_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "externalInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_gold_sha256",
        "candidate_gold_binding_sha256",
        "qualification_holdout_sha256",
        "final_blind_holdout_sha256",
        "runner_sha256",
        "scorer_sha256",
        "compiler_scorer_isolation_sha256"
      ],
      "properties": {
        "semantic_gold_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_gold_binding_sha256": {"$ref": "#/$defs/sha256"},
        "qualification_holdout_sha256": {"$ref": "#/$defs/sha256"},
        "final_blind_holdout_sha256": {"$ref": "#/$defs/sha256"},
        "runner_sha256": {"$ref": "#/$defs/sha256"},
        "scorer_sha256": {"$ref": "#/$defs/sha256"},
        "compiler_scorer_isolation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "byte_size",
        "sha256",
        "media_type",
        "evidence_kind"
      ],
      "properties": {
        "relative_path": {"$ref": "#/$defs/safePath"},
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {
          "enum": [
            "application/json",
            "application/xml",
            "application/pdf",
            "application/zip",
            "application/octet-stream",
            "application/gzip",
            "application/x-gzip",
            "application/x-tar",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "text/plain",
            "text/csv",
            "text/html",
            "text/markdown"
          ]
        },
        "evidence_kind": {
          "enum": [
            "typed_manifest",
            "typed_json",
            "typed_xml",
            "sanitized_text",
            "candidate_full_raw_inventory",
            "candidate_full_junit",
            "candidate_platform_receipt",
            "host_event_sequence",
            "exact_wheel_execution",
            "human_gold_scorer",
            "legal_rows",
            "wiki_journey_rows",
            "context_capsule_selection_usage",
            "scale_report",
            "retained_wheel",
            "retained_sdist",
            "sbom",
            "openvex",
            "licenses",
            "provenance",
            "gate_result",
            "gate_collection",
            "commercial_release_template",
            "post_build_gold_binding",
            "original_legal_pdf",
            "original_legal_docx",
            "original_legal_html",
            "original_legal_markdown",
            "sanitized_supporting_receipt"
          ]
        }
      }
    }
  }
}
