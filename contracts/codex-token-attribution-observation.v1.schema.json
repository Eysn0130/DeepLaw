{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/codex-token-attribution-observation.v1.schema.json",
  "title": "DeepLaw Codex token attribution observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "release_ready",
    "claim_eligible",
    "binding",
    "host",
    "design",
    "schemas",
    "conditions",
    "attribution",
    "security",
    "not_executed"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.codex-token-attribution-observation/v1"},
    "status": {"enum": ["executed", "partial", "failed", "not_executed"]},
    "release_ready": {"const": false},
    "claim_eligible": {"const": false},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "package_version", "worktree_clean", "candidate_wheel_name", "candidate_wheel_sha256", "runtime_executable_sha256", "closed_mcp_wrapper_sha256"],
      "properties": {
        "commit": {"$ref": "#/$defs/sha40"},
        "tree": {"$ref": "#/$defs/sha40"},
        "package_version": {"const": "0.12.0"},
        "worktree_clean": {"type": "boolean"},
        "candidate_wheel_name": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+\\.whl$", "maxLength": 200},
        "candidate_wheel_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_executable_sha256": {"$ref": "#/$defs/sha256"},
        "closed_mcp_wrapper_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "binary_name", "binary_sha256", "version", "model", "reasoning_effort", "authentication"],
      "properties": {
        "interface": {"const": "codex_app_server"},
        "binary_name": {"const": "codex"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "model": {"const": "gpt-5.6-luna"},
        "reasoning_effort": {"const": "max"},
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source", "auth_file_read"],
          "properties": {
            "status": {"const": "logged_in_using_chatgpt"},
            "source": {"const": "existing_codex_login"},
            "auth_file_read": {"const": false}
          }
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_count", "conditions", "controlled", "significance_threshold"],
      "properties": {
        "workflow_count": {"const": 1},
        "conditions": {
          "const": {
            "A": "Host without MCP or dynamic tools",
            "B": "Host with one context-only dynamic tool schema",
            "C": "Host with the current full knowledge_support dynamic input schema",
            "D": "Host with the exact candidate-wheel DeepLaw knowledge_support MCP task"
          }
        },
        "controlled": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt_sha256", "output_schema_sha256", "model", "reasoning_effort", "network", "hardware", "task_binding_sha256"],
          "properties": {
            "prompt_sha256": {"$ref": "#/$defs/sha256"},
            "output_schema_sha256": {"$ref": "#/$defs/sha256"},
            "model": {"const": "gpt-5.6-luna"},
            "reasoning_effort": {"const": "max"},
            "network": {"const": "provider_only"},
            "hardware": {"type": "string", "minLength": 1, "maxLength": 200},
            "task_binding_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "significance_threshold": {
          "const": {
            "schema_byte_delta_min": 8192,
            "input_token_delta_min": 512,
            "relative_input_token_delta_min": 0.05,
            "rule": "schema bytes threshold and either absolute or relative provider input-token threshold"
          }
        }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": {"$ref": "#/$defs/schemaReceipt"},
        "B": {"$ref": "#/$defs/schemaReceipt"},
        "C": {"$ref": "#/$defs/schemaReceipt"},
        "D": {"$ref": "#/$defs/schemaReceipt"}
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/condition"}
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["B_minus_A", "C_minus_A", "C_minus_B", "D_minus_C", "schema_overhead_significant", "profile_change_admitted"],
      "properties": {
        "B_minus_A": {"$ref": "#/$defs/tokenDelta"},
        "C_minus_A": {"$ref": "#/$defs/tokenDelta"},
        "C_minus_B": {"$ref": "#/$defs/tokenDelta"},
        "D_minus_C": {"$ref": "#/$defs/tokenDelta"},
        "schema_overhead_significant": {"type": "boolean"},
        "profile_change_admitted": {"type": "boolean"}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auth_file_read", "raw_host_output_persisted", "reasoning_persisted", "transcript_persisted", "absolute_path_leak", "secret_leak", "ledger_unchanged"],
      "properties": {
        "auth_file_read": {"const": false},
        "raw_host_output_persisted": {"const": false},
        "reasoning_persisted": {"const": false},
        "transcript_persisted": {"const": false},
        "absolute_path_leak": {"type": "boolean"},
        "secret_leak": {"type": "boolean"},
        "ledger_unchanged": {"type": "boolean"}
      }
    },
    "not_executed": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    }
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schemaReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "operation_count", "operations", "input_schema_bytes", "input_schema_sha256", "advertised_schema_bytes", "advertised_schema_sha256", "provider_observed_schema_tokens"],
      "properties": {
        "transport": {"enum": ["none", "dynamic_tool", "mcp"]},
        "operation_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "operations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
        "input_schema_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "input_schema_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "advertised_schema_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "advertised_schema_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "provider_observed_schema_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens"],
      "properties": {
        "status": {"enum": ["provider_reported", "unreported"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "status", "thread_id_sha256", "turn_id_sha256", "latency_ms", "peak_rss_bytes", "usage", "tool_calls", "provider_result_bytes", "host_output", "provider_capsule", "event_receipt", "mcp_environment_receipt", "relevant_chars", "context_chars", "relevant_chars_context_chars", "duplicate_evidence", "redundancy", "distractor_answer_delta", "failure_codes"],
      "properties": {
        "condition_id": {"enum": ["A", "B", "C", "D"]},
        "status": {"enum": ["passed", "failed", "not_executed"]},
        "thread_id_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "turn_id_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "latency_ms": {"type": ["integer", "null"], "minimum": 0},
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "usage": {"$ref": "#/$defs/usage"},
        "tool_calls": {"type": "integer", "minimum": 0, "maximum": 8},
        "provider_result_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "host_output": {"anyOf": [{"$ref": "#/$defs/hostOutput"}, {"type": "null"}]},
        "provider_capsule": {"type": ["object", "null"]},
        "event_receipt": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["name", "sha256", "bytes", "methods", "item_types", "stderr_sha256", "stderr_bytes"],
          "properties": {
            "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.jsonl$", "maxLength": 200},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 0, "maximum": 4194304},
            "methods": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
            "item_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
            "stderr_sha256": {"$ref": "#/$defs/sha256"},
            "stderr_bytes": {"type": "integer", "minimum": 0, "maximum": 4194304}
          }
        },
        "mcp_environment_receipt": {
          "anyOf": [
            {"$ref": "#/$defs/mcpEnvironmentReceipt"},
            {"type": "null"}
          ]
        },
        "relevant_chars": {"type": ["integer", "null"], "minimum": 0},
        "context_chars": {"type": ["integer", "null"], "minimum": 0},
        "relevant_chars_context_chars": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "duplicate_evidence": {"type": ["number", "null"], "minimum": 0},
        "redundancy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "distractor_answer_delta": {"type": ["number", "null"], "minimum": 0},
        "failure_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
      }
    },
    "tokenDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "total_tokens", "relative_input_tokens"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"]},
        "cached_input_tokens": {"type": ["integer", "null"]},
        "output_tokens": {"type": ["integer", "null"]},
        "total_tokens": {"type": ["integer", "null"]},
        "relative_input_tokens": {"type": ["number", "null"]}
      }
    },
    "mcpEnvironmentReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "closed", "home_isolated", "blocked_names_present", "environment_names", "child_argv"],
      "properties": {
        "schema_version": {"const": "deeplaw.closed-mcp-environment-receipt/v1"},
        "closed": {"const": true},
        "home_isolated": {"const": true},
        "blocked_names_present": {"const": []},
        "environment_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:[A-Z][A-Z0-9_]*|__CF_USER_TEXT_ENCODING)$", "maxLength": 100}
        },
        "child_argv": {
          "oneOf": [
            {
              "const": ["runtime/bin/python", "runtime/bin/deeplaw", "knowledge", "mcp", "--stdio", "--vault", "vault"]
            },
            {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "prefixItems": [
                {"const": "runtime/bin/deeplaw"},
                {"const": "knowledge"},
                {"const": "mcp"},
                {"const": "--closed-environment"},
                {"const": "--stdio"},
                {"const": "--expected-vault-id"},
                {"type": "string", "pattern": "^vault_[0-9a-f]{24}$"}
              ],
              "items": false
            }
          ]
        }
      }
    },
    "hostOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "next_step", "preserved_decisions", "open_gaps", "artifact_refs"],
      "properties": {
        "summary": {"type": "string", "maxLength": 1000},
        "next_step": {"type": "string", "maxLength": 500},
        "preserved_decisions": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 500}},
        "open_gaps": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 500}},
        "artifact_refs": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 200}}
      }
    }
  }
}
