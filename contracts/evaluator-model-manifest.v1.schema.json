{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/evaluator-model-manifest.v1.schema.json",
  "title": "Evaluator-owned immutable local model artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "alias", "model_id", "revision", "source", "license",
    "files", "total_byte_size", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.evaluator-model-manifest/v1"},
    "alias": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,79}$"},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "source": {"type": "string", "minLength": 1, "maxLength": 1000},
    "license": {"type": "string", "minLength": 1, "maxLength": 200},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "byte_size"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "byte_size": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
        }
      }
    },
    "total_byte_size": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    }
  }
}
