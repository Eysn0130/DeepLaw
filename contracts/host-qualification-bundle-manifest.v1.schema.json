{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/host-qualification-bundle-manifest.v1.schema.json",
  "title": "DeepLaw Host Qualification Bundle Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "host", "commit", "tree", "artifacts"],
  "properties": {
    "schema_version": {"const": "deeplaw.host-qualification-bundle-manifest/v1"},
    "host": {"enum": ["codex", "opencode"]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "bytes", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1, "maxLength": 100},
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
