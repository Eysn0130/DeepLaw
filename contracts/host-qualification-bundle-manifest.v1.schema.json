{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/host-qualification-bundle-manifest.v1.schema.json",
  "title": "DeepLaw Host Qualification Bundle Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "host", "commit", "tree", "artifacts"],
  "properties": {
    "schema_version": {"const": "deeplaw.host-qualification-bundle-manifest/v1"},
    "host": {"enum": ["codex", "opencode"]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "allOf": [
        {"contains": {"properties": {"role": {"const": "qualification_report"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"role": {"const": "sanitized_events_run_1"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"role": {"const": "sanitized_events_run_2"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"role": {"const": "sanitized_events_run_3"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1}
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "bytes", "sha256"],
        "properties": {
          "role": {
            "enum": [
              "qualification_report", "preflight_receipt",
              "sanitized_events_run_1", "sanitized_events_run_2",
              "sanitized_events_run_3"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"host": {"const": "opencode"}}, "required": ["host"]},
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 5,
            "maxItems": 5,
            "contains": {
              "properties": {"role": {"const": "preflight_receipt"}},
              "required": ["role"]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {"properties": {"artifacts": {"minItems": 4, "maxItems": 4}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
