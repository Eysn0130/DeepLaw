{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/knowledge-snapshot.v1.schema.json",
  "title": "DeepLaw verified local snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vault_id", "vault_revision", "audit_head", "created_at", "include_operator_state", "file_count", "inventory", "inventory_sha256", "snapshot_sha256"],
  "properties": {
    "schema_version": {"const": "deeplaw.knowledge-snapshot/v1"},
    "vault_id": {"type": "string", "pattern": "^vault_[0-9a-f]{24}$"},
    "vault_revision": {"type": "integer", "minimum": 0},
    "audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "include_operator_state": {"type": "boolean"},
    "file_count": {"type": "integer", "minimum": 1, "maximum": 300000},
    "inventory": {"type": "array", "minItems": 1, "maxItems": 300000, "items": {"$ref": "#/$defs/file"}},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096, "not": {"pattern": "^(?:/|.*(?:^|/)\\.\\.(?:/|$))"}},
        "byte_size": {"type": "integer", "minimum": 0, "maximum": 536870912},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
