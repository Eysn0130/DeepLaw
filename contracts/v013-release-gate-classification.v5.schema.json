{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/v013-release-gate-classification.v5.schema.json",
  "title": "DeepLaw v0.13 provenance-bound release gate classification v5",
  "description": "Closed gate mapping from real input contracts to provenance-bound validators. The development classification is intentionally not assembly-ready.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification_id",
    "categories",
    "assembly_policy",
    "gates"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.v013-release-gate-classification/v5"},
    "classification_id": {"const": "deeplaw-v013-commercial-gates-v5"},
    "categories": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/category"}
    },
    "assembly_policy": {"$ref": "#/$defs/assemblyPolicy"},
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+/-]{0,127}$"
    },
    "categoryName": {
      "type": "string",
      "enum": ["Core", "Capability", "Competitive Claim"]
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "category_id",
        "required",
        "not_claimed_allowed",
        "gate_ids"
      ],
      "properties": {
        "category": {"$ref": "#/$defs/categoryName"},
        "category_id": {"enum": ["core", "capability", "competitive_claim"]},
        "required": {"type": "boolean"},
        "not_claimed_allowed": {"type": "boolean"},
        "gate_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "assemblyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assembly_enabled", "reason_code"],
      "properties": {
        "assembly_enabled": {"const": false},
        "reason_code": {"enum": ["blocked_missing_raw_contract", "blocked_missing_validator"]}
      }
    },
    "validatorStatus": {
      "enum": [
        "blocked_missing_raw_contract",
        "blocked_missing_validator",
        "ready",
        "not_claimed_only"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "tool_version", "model_id", "argv_prefix"],
      "properties": {
        "host": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "tool_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "model_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "argv_prefix": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": false,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "minimum", "maximum"],
      "properties": {
        "metric": {"$ref": "#/$defs/identifier"},
        "minimum": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]}
      }
    },
    "hardZeroDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_field", "failure_ids", "maximum_allowed"],
      "properties": {
        "source_field": {"const": "gate_result.hard_failures"},
        "failure_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "maximum_allowed": {"const": 0}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "python_version"],
      "properties": {
        "platform": {"enum": ["linux", "macos", "windows"]},
        "python_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "category",
        "category_id",
        "required",
        "not_claimed_only",
        "assembly_enabled",
        "validator_id",
        "validator_version",
        "implementation_status",
        "accepted_input_schema_versions",
        "minimum_distinct_run_count",
        "required_unique_dimensions",
        "constraints",
        "required_corpus_roles",
        "artifact_kinds",
        "thresholds",
        "hard_zero_derivation",
        "allowed_applicability",
        "required_execution_platforms"
      ],
      "properties": {
        "gate_id": {"$ref": "#/$defs/identifier"},
        "category": {"$ref": "#/$defs/categoryName"},
        "category_id": {"enum": ["core", "capability", "competitive_claim"]},
        "required": {"type": "boolean"},
        "not_claimed_only": {"type": "boolean"},
        "assembly_enabled": {"const": false},
        "validator_id": {"$ref": "#/$defs/identifier"},
        "validator_version": {"$ref": "#/$defs/version"},
        "implementation_status": {"$ref": "#/$defs/validatorStatus"},
        "accepted_input_schema_versions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/schemaVersion"}
        },
        "minimum_distinct_run_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "required_unique_dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "constraints": {"$ref": "#/$defs/constraints"},
        "required_corpus_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["development", "qualification_holdout", "final_blind"]
          }
        },
        "artifact_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/threshold"}
        },
        "hard_zero_derivation": {"$ref": "#/$defs/hardZeroDerivation"},
        "allowed_applicability": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["applicable", "not_applicable"]}
        },
        "required_execution_platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 27,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/platform"}
        }
      }
    }
  }
}
