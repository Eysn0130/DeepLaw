{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/provenance-bound-gate-result.v5.schema.json",
  "title": "DeepLaw Kernel Release Core provenance-bound Gate Result v5",
  "description": "A Gate receipt for the v0.13 Kernel Release Core profile. Competitive research and capability claims are represented independently and cannot authorize a Kernel release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "reference_provenance",
    "human_authenticity",
    "qualification_run_id",
    "gate_id",
    "category",
    "validator_id",
    "validator_version",
    "validator_source",
    "validator_executable",
    "classification_binding",
    "candidate_binding",
    "protocol_binding",
    "threshold_binding",
    "corpora",
    "status",
    "executions",
    "run_ids",
    "metrics",
    "hard_failures",
    "inputs",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.provenance-bound-gate-result/v5"},
    "profile": {"const": "kernel_release_core"},
    "reference_provenance": {"enum": ["deterministic_expected_evidence", "not_applicable"]},
    "human_authenticity": {"const": "not_claimed"},
    "qualification_run_id": {"type": "integer", "minimum": 1},
    "gate_id": {"$ref": "#/$defs/identifier"},
    "category": {"$ref": "#/$defs/category"},
    "validator_id": {"$ref": "#/$defs/identifier"},
    "validator_version": {"$ref": "#/$defs/version"},
    "validator_source": {"$ref": "#/$defs/validatorFileBinding"},
    "validator_executable": {"$ref": "#/$defs/validatorFileBinding"},
    "classification_binding": {"$ref": "#/$defs/classificationBinding"},
    "candidate_binding": {"$ref": "#/$defs/candidateBinding"},
    "protocol_binding": {"$ref": "#/$defs/protocolBinding"},
    "threshold_binding": {"$ref": "#/$defs/thresholdBinding"},
    "corpora": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/corpus"}
    },
    "status": {"$ref": "#/$defs/status"},
    "executions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/execution"}
    },
    "run_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "metrics": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/metric"}
    },
    "hard_failures": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/hardFailure"}
    },
    "inputs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/inputProvenance"}
    },
    "result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "executions": {"minItems": 1},
          "run_ids": {"minItems": 1},
          "metrics": {"minItems": 1},
          "hard_failures": {"minItems": 1},
          "inputs": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "not_executed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "executions": {"maxItems": 0},
          "run_ids": {"maxItems": 0},
          "metrics": {"maxItems": 0},
          "hard_failures": {"maxItems": 0},
          "inputs": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,512}$"},
    "category": {"enum": ["Core", "Capability", "Competitive/Research Claim"]},
    "status": {"enum": ["passed", "failed", "not_executed"]},
    "classificationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification_id", "classification_schema_version", "classification_sha256"],
      "properties": {
        "classification_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
        "classification_schema_version": {"const": "deeplaw.v013-release-gate-classification/v9"},
        "classification_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_commit", "candidate_tree", "candidate_wheel_sha256", "candidate_sdist_sha256"],
      "properties": {
        "candidate_commit": {"$ref": "#/$defs/git"},
        "candidate_tree": {"$ref": "#/$defs/git"},
        "candidate_wheel_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sdist_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protocolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "protocol_sha256", "frozen"],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/identifier"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "frozen": {"const": true}
      }
    },
    "thresholdBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold_id", "threshold_sha256", "frozen"],
      "properties": {
        "threshold_id": {"$ref": "#/$defs/identifier"},
        "threshold_sha256": {"$ref": "#/$defs/sha256"},
        "frozen": {"const": true}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "source", "sha256", "frozen"],
      "properties": {
        "role": {"enum": ["candidate_full", "candidate_platform", "host_qualification", "professional_evidence", "living_wiki", "scale_10000", "supply_chain"]},
        "source": {"enum": ["repository", "candidate_artifact", "repository_external"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "frozen": {"const": true}
      }
    },
    "validatorFileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "byte_size", "file_sha256"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "byte_size": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "workflow_run_id", "input_refs", "evidence_kind"],
      "properties": {
        "run_id": {"$ref": "#/$defs/identifier"},
        "workflow_run_id": {"type": "integer", "minimum": 1},
        "input_refs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "evidence_kind": {"$ref": "#/$defs/typedEvidenceKind"}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "observed", "input_refs"],
      "properties": {
        "metric": {"$ref": "#/$defs/identifier"},
        "observed": {},
        "input_refs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "hardFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_id", "count", "maximum_allowed", "input_refs"],
      "properties": {
        "failure_id": {"$ref": "#/$defs/identifier"},
        "count": {"type": "integer", "minimum": 0},
        "maximum_allowed": {"const": 0},
        "input_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "typedEvidenceKind": {
      "enum": [
        "candidate_full_junit",
        "candidate_platform_receipt",
        "host_event_sequence",
        "exact_wheel_execution",
        "professional_evidence_rows",
        "wiki_journey_rows",
        "context_capsule_selection_usage",
        "scale_report",
        "retained_supply_chain"
      ]
    },
    "inputProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "relative_path",
        "byte_size",
        "file_sha256",
        "schema_version",
        "record_sha256",
        "artifact_kind",
        "evidence_kind",
        "derived_record_sha256"
      ],
      "properties": {
        "input_id": {"$ref": "#/$defs/identifier"},
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "byte_size": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "deeplaw.typed-qualification-evidence/v3"},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_kind": {"const": "typed-qualification-evidence"},
        "evidence_kind": {"$ref": "#/$defs/typedEvidenceKind"},
        "derived_record_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
