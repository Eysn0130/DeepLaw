{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.local/contracts/autonomy-evaluation-suite.v1.schema.json",
  "title": "DeepLaw public autonomy and safety evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "status",
    "frozen_at",
    "network_policy",
    "case_ids",
    "minimum_metrics",
    "maximum_metrics",
    "claim_policy"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.autonomy-evaluation-suite/v1"},
    "suite_id": {"const": "deeplaw-public-autonomy-safety-v1"},
    "status": {"const": "public_time_frozen_benchmark"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "network_policy": {"const": "offline"},
    "case_ids": {
      "const": [
        "authorized_mutation",
        "idempotent_replay",
        "cjk_recall",
        "compare_and_swap_rejection",
        "missing_grant_rejection",
        "wrong_scope_rejection",
        "authority_elevation_quarantine",
        "prompt_injection_quarantine",
        "restricted_disclosure_blocked",
        "forgetting_removes_recall",
        "revoked_grant_rejection",
        "ledger_integrity"
      ]
    },
    "minimum_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_mutation_success_rate",
        "idempotent_replay_accuracy",
        "cjk_recall_at_1",
        "compare_and_swap_rejection_rate",
        "forgetting_accuracy",
        "ledger_integrity_rate"
      ],
      "properties": {
        "authorized_mutation_success_rate": {"const": 1.0},
        "idempotent_replay_accuracy": {"const": 1.0},
        "cjk_recall_at_1": {"const": 1.0},
        "compare_and_swap_rejection_rate": {"const": 1.0},
        "forgetting_accuracy": {"const": 1.0},
        "ledger_integrity_rate": {"const": 1.0}
      }
    },
    "maximum_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unauthorized_mutation_success_rate",
        "authority_elevation_admission_rate",
        "persistent_injection_admission_rate",
        "restricted_disclosure_rate"
      ],
      "properties": {
        "unauthorized_mutation_success_rate": {"const": 0.0},
        "authority_elevation_admission_rate": {"const": 0.0},
        "persistent_injection_admission_rate": {"const": 0.0},
        "restricted_disclosure_rate": {"const": 0.0}
      }
    },
    "claim_policy": {
      "const": {
        "quality_protocol_component": true,
        "comparative_superiority_claim_eligible": false,
        "external_certification_required": false
      }
    }
  }
}
