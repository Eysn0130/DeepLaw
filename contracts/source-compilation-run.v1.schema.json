{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/source-compilation-run.v1.schema.json",
  "title": "DeepLaw Source Compilation Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "compilation_run_id", "source_key", "source_revision_id",
    "previous_source_revision_id", "source_ir_compilation_id",
    "source_ir_sha256", "expected_source_status", "compiler_profile",
    "compiler_profile_version", "host_identity", "model_identity",
    "prompt_template_id", "prompt_config_sha256",
    "plan_configuration_sha256", "status", "resumable", "packet_count",
    "staged_packet_count", "staged_object_count", "staged_relation_count",
    "unresolved_identity_count", "contradiction_count",
    "skipped_fragment_count", "warning_count", "coverage_ratio",
    "input_audit_head", "input_legacy_audit_head", "validation_sha256",
    "output_set_sha256", "canonical_commit_sha256",
    "projection_manifest_sha256", "receipt_sha256", "token_usage",
    "elapsed_ms", "retry_count", "failure_stage", "failure_sha256",
    "idempotent_replay", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.source-compilation-run/v1"},
    "compilation_run_id": {
      "type": "string", "pattern": "^compilationrun_[0-9a-f]{24}$"
    },
    "source_key": {
      "type": "string", "pattern": "^sourcekey_[0-9a-f]{24}$"
    },
    "source_revision_id": {
      "type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"
    },
    "previous_source_revision_id": {
      "type": ["string", "null"], "pattern": "^sourcerev_[0-9a-f]{24}$"
    },
    "source_ir_compilation_id": {
      "type": "string", "pattern": "^compilation_[0-9a-f]{24}$"
    },
    "source_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_source_status": {
      "enum": ["registered", "pending", "active", "superseded", "removed"]
    },
    "compiler_profile": {"type": "string", "minLength": 1, "maxLength": 200},
    "compiler_profile_version": {
      "type": "string", "minLength": 1, "maxLength": 100
    },
    "host_identity": {"type": "string", "minLength": 1, "maxLength": 200},
    "model_identity": {
      "type": ["string", "null"], "minLength": 1, "maxLength": 500
    },
    "prompt_template_id": {
      "type": "string", "minLength": 1, "maxLength": 300
    },
    "prompt_config_sha256": {
      "type": "string", "pattern": "^[0-9a-f]{64}$"
    },
    "plan_configuration_sha256": {
      "type": "string", "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "planned", "staging", "validating", "ready_to_commit", "committed",
        "projection_pending", "succeeded", "failed", "aborted"
      ]
    },
    "resumable": {"type": "boolean"},
    "packet_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "staged_packet_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "staged_object_count": {
      "type": "integer", "minimum": 0, "maximum": 100000
    },
    "staged_relation_count": {
      "type": "integer", "minimum": 0, "maximum": 100000
    },
    "unresolved_identity_count": {
      "type": "integer", "minimum": 0, "maximum": 100000
    },
    "contradiction_count": {
      "type": "integer", "minimum": 0, "maximum": 100000
    },
    "skipped_fragment_count": {
      "type": "integer", "minimum": 0, "maximum": 10000
    },
    "warning_count": {
      "type": "integer", "minimum": 0, "maximum": 100000
    },
    "coverage_ratio": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "input_audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_legacy_audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "output_set_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "receipt_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_commit_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "projection_manifest_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "token_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "status": {"enum": ["reported", "unreported"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "elapsed_ms": {"type": ["integer", "null"], "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0},
    "failure_stage": {"type": ["string", "null"], "maxLength": 200},
    "failure_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "idempotent_replay": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
