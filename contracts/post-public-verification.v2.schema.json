{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/post-public-verification.v2.schema.json",
  "title": "DeepLaw post-public release verification receipt v2",
  "description": "Post-public verification receipt bound to the immutable release identity and the exact public checksum set. It is emitted after publication and is not a precondition of the pre-publish release authorization gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "verified_at",
    "release_binding",
    "artifact_binding",
    "sigstore",
    "attestation",
    "anonymous_redownload",
    "public_sha256",
    "public_release_verified",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.post-public-verification/v2"},
    "status": {"const": "post_public_verified"},
    "verified_at": {"type": "string", "format": "date-time"},
    "release_binding": {"$ref": "#/$defs/releaseBinding"},
    "artifact_binding": {"$ref": "#/$defs/artifactHashes"},
    "sigstore": {"$ref": "#/$defs/verification"},
    "attestation": {"$ref": "#/$defs/attestation"},
    "anonymous_redownload": {"$ref": "#/$defs/redownload"},
    "public_sha256": {"$ref": "#/$defs/artifactHashes"},
    "public_release_verified": {"const": true},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "releaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "commit",
        "tree",
        "commercial_manifest_sha256",
        "sha256s_sha256"
      ],
      "properties": {
        "tag": {"$ref": "#/$defs/tag"},
        "commit": {"$ref": "#/$defs/git"},
        "tree": {"$ref": "#/$defs/git"},
        "commercial_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "sha256s_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wheel_sha256", "sdist_sha256"],
      "properties": {
        "wheel_sha256": {"$ref": "#/$defs/sha256"},
        "sdist_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "bundle_sha256", "verified"],
      "properties": {
        "identity": {"$ref": "#/$defs/identifier"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "verified": {"const": true}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "attestation_sha256", "verified"],
      "properties": {
        "identity": {"$ref": "#/$defs/identifier"},
        "attestation_sha256": {"$ref": "#/$defs/sha256"},
        "verified": {"const": true}
      }
    },
    "redownload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "source",
        "wheel_sha256",
        "sdist_sha256",
        "sha256_matches"
      ],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/identifier"},
        "source": {"const": "anonymous_public_redownload"},
        "wheel_sha256": {"$ref": "#/$defs/sha256"},
        "sdist_sha256": {"$ref": "#/$defs/sha256"},
        "sha256_matches": {"const": true}
      }
    }
  }
}
