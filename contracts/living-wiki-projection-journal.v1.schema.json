{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/living-wiki-projection-journal.v1.schema.json",
  "title": "DeepLaw Living Wiki Projection Journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "transaction_id", "phase", "old_manifest_sha256",
    "new_manifest_sha256", "input_audit_head", "legacy_audit_head",
    "projection_profile_sha256", "staging_path", "backup_path", "manifest_path",
    "created", "updated", "deleted", "change_set_sha256", "journal_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.living-wiki-projection-journal/v1"},
    "transaction_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "phase": {"enum": ["prepare", "activate", "cleanup"]},
    "old_manifest_sha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "new_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "legacy_audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projection_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "staging_path": {
      "type": "string",
      "pattern": "^\\.deeplaw/derived/tree/\\.projection-transactions/[0-9a-f]{32}/staging$"
    },
    "backup_path": {
      "type": "string",
      "pattern": "^\\.deeplaw/derived/tree/\\.projection-transactions/[0-9a-f]{32}/backup$"
    },
    "manifest_path": {"const": ".deeplaw/derived/tree/living-wiki-manifest.json"},
    "created": {
      "type": "array", "maxItems": 1000000,
      "items": {"$ref": "#/$defs/new_descriptor"}
    },
    "updated": {
      "type": "array", "maxItems": 1000000,
      "items": {"$ref": "#/$defs/updated_descriptor"}
    },
    "deleted": {
      "type": "array", "maxItems": 1000000,
      "items": {"$ref": "#/$defs/old_descriptor"}
    },
    "change_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "journal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "path": {
      "type": "string", "minLength": 1, "maxLength": 2000,
      "pattern": "^(wiki|canvas)/[^./][^\u0000]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": "integer", "minimum": 0, "maximum": 262144},
    "new_descriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "byte_size", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "byte_size": {"$ref": "#/$defs/size"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "old_descriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "old_byte_size", "old_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "old_byte_size": {"$ref": "#/$defs/size"},
        "old_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "updated_descriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "old_byte_size", "old_sha256", "byte_size", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "old_byte_size": {"$ref": "#/$defs/size"},
        "old_sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"$ref": "#/$defs/size"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
