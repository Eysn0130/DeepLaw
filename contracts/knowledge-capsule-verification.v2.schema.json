{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/knowledge-capsule-verification.v2.schema.json",
  "title": "DeepLaw Autonomous Knowledge Capsule Verification v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "capsule_id", "expected_capsule_id", "digest_valid",
    "id_valid", "query_plan_valid", "provider_payload_bytes",
    "provider_hard_limit_valid", "vault_matches", "audit_anchor_valid",
    "autonomous_integrity_valid", "receipt_checks", "valid"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.knowledge-capsule-verification/v2"},
    "capsule_id": {"type": "string", "pattern": "^capsule_[0-9a-f]{24}$"},
    "expected_capsule_id": {"type": "string", "pattern": "^capsule_[0-9a-f]{24}$"},
    "digest_valid": {"type": "boolean"},
    "id_valid": {"type": "boolean"},
    "query_plan_valid": {"type": "boolean"},
    "provider_payload_bytes": {"type": "integer", "minimum": 0},
    "provider_hard_limit_valid": {"type": "boolean"},
    "vault_matches": {"type": ["boolean", "null"]},
    "audit_anchor_valid": {"type": ["boolean", "null"]},
    "autonomous_integrity_valid": {"type": ["boolean", "null"]},
    "receipt_checks": {
      "type": "array", "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "knowledge_id", "revision_id", "source_integrity_valid", "valid"
        ],
        "properties": {
          "knowledge_id": {"type": "string", "pattern": "^knowledge_[0-9a-f]{24}$"},
          "revision_id": {"type": "string", "pattern": "^knowledgerev_[0-9a-f]{24}$"},
          "source_integrity_valid": {"type": "boolean"},
          "valid": {"type": "boolean"}
        }
      }
    },
    "valid": {"type": "boolean"}
  }
}
