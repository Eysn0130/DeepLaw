{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/real-host-compile-report.v1.schema.json",
  "title": "DeepLaw Real Host Compile Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "status", "executed", "host",
    "host_version", "model_identity", "source_revision_id", "network_policy",
    "prompt_sha256", "command_sha256", "exit_code", "stdout_sha256",
    "stdout_bytes", "stderr_sha256", "stderr_bytes", "compilation_run_id",
    "receipt_sha256", "projection_manifest_sha256", "verification_valid",
    "elapsed_ms", "failure_class", "failure_summary", "recorded_at",
    "competitive_claim_eligible"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.real-host-compile-report/v1"},
    "report_id": {"type": "string", "pattern": "^hostrun_[0-9a-f]{24}$"},
    "status": {"enum": ["not_executed", "passed", "failed"]},
    "executed": {"type": "boolean"},
    "host": {"enum": ["codex", "claude_code", "opencode", "gemini_cli"]},
    "host_version": {"type": "string", "minLength": 1, "maxLength": 500},
    "model_identity": {"type": "string", "minLength": 1, "maxLength": 500},
    "source_revision_id": {
      "type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"
    },
    "network_policy": {"enum": ["offline", "explicit_bounded"]},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "exit_code": {"type": ["integer", "null"], "minimum": -255, "maximum": 255},
    "stdout_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "stdout_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
    "stderr_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "stderr_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
    "compilation_run_id": {
      "type": ["string", "null"], "pattern": "^compilationrun_[0-9a-f]{24}$"
    },
    "receipt_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "projection_manifest_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "verification_valid": {"type": ["boolean", "null"]},
    "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
    "failure_class": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"
    },
    "failure_summary": {"type": ["string", "null"], "maxLength": 1000},
    "recorded_at": {"type": "string", "format": "date-time"},
    "competitive_claim_eligible": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "not_executed"}}},
      "then": {
        "properties": {
          "executed": {"const": false},
          "exit_code": {"const": null},
          "compilation_run_id": {"const": null},
          "verification_valid": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "passed"}}},
      "then": {
        "properties": {
          "executed": {"const": true},
          "exit_code": {"const": 0},
          "verification_valid": {"const": true},
          "failure_class": {"const": null},
          "failure_summary": {"const": null}
        }
      }
    }
  ]
}
