{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "writer_id",
    "host_id",
    "model_id",
    "task_sha256",
    "input_sha256",
    "output_sha256",
    "tool_results_sha256",
    "scope",
    "sensitivity",
    "status",
    "started_at",
    "ended_at",
    "metadata",
    "recorded_at",
    "receipt_sha256",
    "idempotent_replay",
    "audit_head"
  ],
  "properties": {
    "schema_version": {
      "const": "deeplaw.knowledge-run-record/v2"
    },
    "run_id": {
      "type": "string"
    },
    "writer_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_sha256": {
      "type": "string"
    },
    "input_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_results_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "enum": [
        "personal",
        "project",
        "domain"
      ]
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ]
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "partial",
        "aborted"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_binding",
        "action_state"
      ],
      "properties": {
        "task_kind": {
          "type": "string",
          "maxLength": 500
        },
        "tool_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "artifact_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,199}$",
            "not": {
              "anyOf": [
                {
                  "pattern": "\\.\\."
                },
                {
                  "pattern": "(^|[._:-])([Aa][Uu][Tt][Hh]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Ss][Ee][Cc][Rr][Ee][Tt][Ss]?|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Kk][Ee][Yy])($|[._:-])"
                }
              ]
            }
          }
        },
        "notes_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_binding": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://deeplaw.dev/contracts/task-context-binding.v1.schema.json",
          "title": "DeepLaw Task Context Binding v1",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "project_sha256",
            "task_lineage_sha256",
            "parent_task_lineage_sha256",
            "repository_sha256",
            "worktree_sha256",
            "base_revision",
            "dirty_state_sha256",
            "binding_sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "deeplaw.task-context-binding/v1"
            },
            "project_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "task_lineage_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "parent_task_lineage_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "repository_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "worktree_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "base_revision": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "dirty_state_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "repository_sha256": {
                    "type": "null"
                  },
                  "worktree_sha256": {
                    "type": "null"
                  },
                  "base_revision": {
                    "type": "null"
                  },
                  "dirty_state_sha256": {
                    "type": "null"
                  }
                },
                "required": [
                  "repository_sha256",
                  "worktree_sha256",
                  "base_revision",
                  "dirty_state_sha256"
                ]
              },
              "then": {},
              "else": {
                "required": [
                  "repository_sha256",
                  "worktree_sha256",
                  "base_revision",
                  "dirty_state_sha256"
                ],
                "properties": {
                  "repository_sha256": {
                    "type": "string"
                  },
                  "worktree_sha256": {
                    "type": "string"
                  },
                  "base_revision": {
                    "type": "string"
                  },
                  "dirty_state_sha256": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "action_state": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://deeplaw.dev/contracts/task-action-state.v1.schema.json",
          "title": "DeepLaw host-reported task action state v1",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "action_id",
            "request_sha256",
            "status",
            "outcome_sha256",
            "expected_prior_run_id",
            "evidence_level"
          ],
          "properties": {
            "schema_version": {
              "const": "deeplaw.task-action-state/v1"
            },
            "action_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "request_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "status": {
              "enum": [
                "not_executed",
                "initiated_unknown",
                "succeeded",
                "failed"
              ]
            },
            "outcome_sha256": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              ]
            },
            "expected_prior_run_id": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
                }
              ]
            },
            "evidence_level": {
              "const": "host_reported"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "not_executed",
                      "initiated_unknown"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "outcome_sha256": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "outcome_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "recorded_at": {
      "type": "string"
    },
    "receipt_sha256": {
      "type": "string"
    },
    "idempotent_replay": {
      "type": "boolean"
    },
    "audit_head": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/knowledge-run-record.v2.schema.json",
  "title": "DeepLaw task action Run record v2"
}
