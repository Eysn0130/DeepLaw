{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/source-compilation-packet.v1.schema.json",
  "title": "DeepLaw Source Compilation Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "compilation_run_id", "packet_id", "ordinal",
    "packet_count", "source_revision_id", "source_ir_compilation_id",
    "input_audit_head", "compiler_profile", "compilation_context", "fragments"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.source-compilation-packet/v1"},
    "compilation_run_id": {
      "type": "string", "pattern": "^compilationrun_[0-9a-f]{24}$"
    },
    "packet_id": {"type": "string", "pattern": "^packet_[0-9a-f]{24}$"},
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 10000},
    "packet_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "source_revision_id": {
      "type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"
    },
    "source_ir_compilation_id": {
      "type": "string", "pattern": "^compilation_[0-9a-f]{24}$"
    },
    "input_audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiler_profile": {"type": "string", "minLength": 1, "maxLength": 200},
    "compilation_context": {"$ref": "#/$defs/compilationContext"},
    "fragments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fragment_id", "fragment_revision_id", "ordinal", "locator",
          "text", "text_sha256", "logical_node_keys", "instruction_risk"
        ],
        "properties": {
          "fragment_id": {
            "type": "string", "pattern": "^fragment_[0-9a-f]{24}$"
          },
          "fragment_revision_id": {
            "type": "string", "pattern": "^irfragment_[0-9a-f]{24}$"
          },
          "ordinal": {"type": "integer", "minimum": 1},
          "locator": {"type": "string", "minLength": 1, "maxLength": 2000},
          "text": {"type": "string", "minLength": 1, "maxLength": 200000},
          "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "logical_node_keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 2000}
          },
          "instruction_risk": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "compilationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_schema", "relevant_knowledge", "identity_candidates",
        "previous_outputs", "affected_syntheses", "truncated"
      ],
      "properties": {
        "plan_schema": {
          "const": "deeplaw.source-compilation-plan/v1"
        },
        "relevant_knowledge": {
          "type": "array",
          "maxItems": 6,
          "items": {"$ref": "#/$defs/relevantKnowledge"}
        },
        "identity_candidates": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/identityCandidate"}
        },
        "previous_outputs": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/previousOutput"}
        },
        "affected_syntheses": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/affectedSynthesis"}
        },
        "truncated": {"type": "boolean"}
      }
    },
    "knowledgeKind": {
      "enum": [
        "claim", "concept", "entity", "event", "decision", "procedure",
        "experience", "preference", "synthesis", "comparison", "skill", "memory"
      ]
    },
    "relevantKnowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge_id", "revision_id", "kind", "semantic_key", "title",
        "body_excerpt", "selection_reason"
      ],
      "properties": {
        "knowledge_id": {
          "type": "string", "pattern": "^knowledge_[0-9a-f]{24}$"
        },
        "revision_id": {
          "type": "string", "pattern": "^knowledgerev_[0-9a-f]{24}$"
        },
        "kind": {"$ref": "#/$defs/knowledgeKind"},
        "semantic_key": {
          "type": ["string", "null"], "maxLength": 300
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "body_excerpt": {"type": "string", "maxLength": 800},
        "selection_reason": {
          "type": "string", "minLength": 1, "maxLength": 1000
        }
      }
    },
    "identityCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge_id", "revision_id", "kind", "semantic_key", "title",
        "aliases", "match_basis"
      ],
      "properties": {
        "knowledge_id": {
          "type": "string", "pattern": "^knowledge_[0-9a-f]{24}$"
        },
        "revision_id": {
          "type": "string", "pattern": "^knowledgerev_[0-9a-f]{24}$"
        },
        "kind": {"$ref": "#/$defs/knowledgeKind"},
        "semantic_key": {
          "type": ["string", "null"], "maxLength": 300
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "aliases": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "match_basis": {"const": "bounded_retrieval_candidate"}
      }
    },
    "previousOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compilation_run_id", "output_kind", "output_id", "object_id",
        "source_revision_id"
      ],
      "properties": {
        "compilation_run_id": {
          "type": "string", "pattern": "^compilationrun_[0-9a-f]{24}$"
        },
        "output_kind": {
          "enum": ["knowledge_revision", "relation_revision"]
        },
        "output_id": {
          "type": "string",
          "pattern": "^(knowledgerev|relationrev)_[0-9a-f]{24}$"
        },
        "object_id": {
          "type": "string",
          "pattern": "^(knowledge|relationkey)_[0-9a-f]{24}$"
        },
        "source_revision_id": {
          "type": "string", "pattern": "^sourcerev_[0-9a-f]{24}$"
        }
      }
    },
    "affectedSynthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_id", "revision_id", "title"],
      "properties": {
        "knowledge_id": {
          "type": "string", "pattern": "^knowledge_[0-9a-f]{24}$"
        },
        "revision_id": {
          "type": "string", "pattern": "^knowledgerev_[0-9a-f]{24}$"
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
