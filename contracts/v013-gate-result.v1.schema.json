{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/v013-gate-result.v1.schema.json",
  "title": "DeepLaw v0.13 derived provenance Gate Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "gate_id",
    "category",
    "candidate_version",
    "candidate_binding",
    "classification_binding",
    "protocol_binding",
    "gold_binding",
    "corpus",
    "validator",
    "status",
    "executions",
    "metrics",
    "hard_failures",
    "failures",
    "redaction",
    "raw_inputs",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.v013-gate-result/v1"},
    "artifact_kind": {"const": "v013-derived-provenance-gate-result"},
    "gate_id": {"$ref": "#/$defs/identifier"},
    "category": {"enum": ["Core", "Capability", "Competitive Claim"]},
    "candidate_version": {"$ref": "#/$defs/semver"},
    "candidate_binding": {"$ref": "#/$defs/candidateBinding"},
    "classification_binding": {"$ref": "#/$defs/documentBinding"},
    "protocol_binding": {"$ref": "#/$defs/documentBinding"},
    "gold_binding": {"$ref": "#/$defs/goldBinding"},
    "corpus": {"$ref": "#/$defs/corpus"},
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator_id", "validator_version", "source_sha256", "executable_sha256"],
      "properties": {
        "validator_id": {"$ref": "#/$defs/identifier"},
        "validator_version": {"$ref": "#/$defs/semver"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "executable_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "status": {"enum": ["passed", "failed", "not_executed", "not_claimed"]},
    "executions": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/executionIdentity"}
    },
    "metrics": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/metric"}
    },
    "hard_failures": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/hardFailure"}
    },
    "failures": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_canary_count", "private_path_count", "content_minimized"],
      "properties": {
        "secret_canary_count": {"type": "integer", "minimum": 0},
        "private_path_count": {"type": "integer", "minimum": 0},
        "content_minimized": {"const": true}
      }
    },
    "raw_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/fileBinding"}
    },
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 32
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "lock_sha256", "wheel_sha256", "sdist_sha256"],
      "properties": {
        "commit": {"$ref": "#/$defs/git"},
        "tree": {"$ref": "#/$defs/git"},
        "lock_sha256": {"$ref": "#/$defs/sha256"},
        "wheel_sha256": {"$ref": "#/$defs/sha256"},
        "sdist_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "documentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "sha256"],
      "properties": {
        "document_id": {"$ref": "#/$defs/identifier"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "goldBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "role", "source", "independent"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "role": {"enum": ["development", "qualification_holdout", "final_blind"]},
        "source": {"enum": ["repository", "repository_external"]},
        "independent": {"type": "boolean"}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "role", "source", "read_only"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"enum": ["development", "qualification_holdout", "final_blind"]},
        "source": {"enum": ["repository", "repository_external"]},
        "read_only": {"const": true}
      }
    },
    "executionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "tool_name", "tool_version", "model_id", "reasoning_effort", "dimensions", "raw_input_sha256"],
      "properties": {
        "run_id": {"$ref": "#/$defs/identifier"},
        "tool_name": {"type": "string", "minLength": 1, "maxLength": 100},
        "tool_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "model_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "reasoning_effort": {
          "anyOf": [
            {"type": "null"},
            {"enum": ["low", "medium", "high", "xhigh", "max"]}
          ]
        },
        "dimensions": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "raw_input_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "observed", "numerator", "denominator", "minimum", "maximum"],
      "properties": {
        "metric": {"$ref": "#/$defs/identifier"},
        "observed": {"type": "number"},
        "numerator": {"type": "number", "minimum": 0},
        "denominator": {"type": "number", "exclusiveMinimum": 0},
        "minimum": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]}
      }
    },
    "hardFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_id", "count", "maximum_allowed"],
      "properties": {
        "failure_id": {"$ref": "#/$defs/identifier"},
        "count": {"type": "integer", "minimum": 0},
        "maximum_allowed": {"const": 0}
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "byte_size", "file_sha256", "schema_version", "record_sha256"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,512}$"
        },
        "byte_size": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "string", "minLength": 1, "maxLength": 200},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
