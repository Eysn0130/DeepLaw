{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.local/contracts/typed-compiler-benchmark.v1.schema.json",
  "title": "DeepLaw typed compiler benchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "suite_sha256",
    "candidate_line",
    "compiler_identity",
    "scorer_sha256",
    "case_count",
    "counts",
    "metrics",
    "per_case",
    "claim_eligible",
    "limitations",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.typed-compiler-benchmark/v1"},
    "suite_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "suite_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_line": {"type": "string", "minLength": 1, "maxLength": 100},
    "compiler_identity": {"type": "string", "minLength": 1, "maxLength": 500},
    "scorer_sha256": {"$ref": "#/$defs/sha256"},
    "case_count": {"type": "integer", "minimum": 1, "maximum": 100000},
    "counts": {"$ref": "#/$defs/counts"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "per_case": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "counts", "metrics"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "counts": {"$ref": "#/$defs/counts"},
          "metrics": {"$ref": "#/$defs/metrics"}
        }
      }
    },
    "claim_eligible": {"const": false},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold_claims",
        "predicted_claims",
        "true_positive_gold_claims",
        "true_positive_predictions",
        "hallucinated_predictions",
        "unsupported_predictions",
        "exact_source_span_claims",
        "duplicate_predictions",
        "reviewed_predictions",
        "accepted_predictions",
        "cross_document_gold_claims",
        "cross_document_predictions",
        "correct_cross_document_claims"
      ],
      "properties": {
        "gold_claims": {"type": "integer", "minimum": 0},
        "predicted_claims": {"type": "integer", "minimum": 0},
        "true_positive_gold_claims": {"type": "integer", "minimum": 0},
        "true_positive_predictions": {"type": "integer", "minimum": 0},
        "hallucinated_predictions": {"type": "integer", "minimum": 0},
        "unsupported_predictions": {"type": "integer", "minimum": 0},
        "exact_source_span_claims": {"type": "integer", "minimum": 0},
        "duplicate_predictions": {"type": "integer", "minimum": 0},
        "reviewed_predictions": {"type": "integer", "minimum": 0},
        "accepted_predictions": {"type": "integer", "minimum": 0},
        "cross_document_gold_claims": {"type": "integer", "minimum": 0},
        "cross_document_predictions": {"type": "integer", "minimum": 0},
        "correct_cross_document_claims": {"type": "integer", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision",
        "recall",
        "f1",
        "hallucinated_claim_rate",
        "unsupported_claim_rate",
        "source_span_correctness",
        "duplicate_claim_rate",
        "review_acceptance_rate",
        "cross_document_synthesis_correctness"
      ],
      "properties": {
        "precision": {"type": "number", "minimum": 0, "maximum": 1},
        "recall": {"type": "number", "minimum": 0, "maximum": 1},
        "f1": {"type": "number", "minimum": 0, "maximum": 1},
        "hallucinated_claim_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "unsupported_claim_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "source_span_correctness": {"type": "number", "minimum": 0, "maximum": 1},
        "duplicate_claim_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "review_acceptance_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "cross_document_synthesis_correctness": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
