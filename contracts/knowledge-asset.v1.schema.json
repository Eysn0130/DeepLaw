{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplaw.dev/contracts/knowledge-asset.v1.schema.json",
  "title": "DeepLaw Knowledge Asset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "uri",
    "vault_id",
    "kind",
    "memory_tier",
    "title",
    "statement",
    "semantic_key",
    "status",
    "verification",
    "trust",
    "sensitivity",
    "legal_authority",
    "directive_mode",
    "source_refs",
    "tags",
    "warnings",
    "created_at",
    "activated_at",
    "expires_at",
    "supersedes_asset_id",
    "origin_uri",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "deeplaw.knowledge-asset/v1"},
    "asset_id": {"type": "string", "pattern": "^asset_[0-9a-f]{24}$"},
    "uri": {"type": "string", "pattern": "^deeplaw://vault_[0-9a-f]{24}/assets/asset_[0-9a-f]{24}$"},
    "vault_id": {"type": "string", "pattern": "^vault_[0-9a-f]{24}$"},
    "kind": {
      "type": "string",
      "enum": [
        "constraint",
        "decision",
        "fact",
        "procedure",
        "rule",
        "experience",
        "lesson",
        "question",
        "reference"
      ]
    },
    "memory_tier": {
      "type": "string",
      "enum": ["working", "project", "experience", "wisdom", "domain"]
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 500},
    "statement": {"type": "string", "minLength": 1, "maxLength": 20000},
    "semantic_key": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 256}
      ]
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "active", "superseded", "revoked", "quarantined"]
    },
    "verification": {
      "type": "string",
      "enum": ["unverified", "source_bound", "human_verified"]
    },
    "trust": {
      "type": "string",
      "enum": ["untrusted", "user_provided", "verified_source"]
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "private", "restricted"]
    },
    "legal_authority": {"const": false},
    "directive_mode": {
      "type": "string",
      "enum": ["data_only", "reviewed_instruction"]
    },
    "source_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/source_ref"}
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "activated_at": {
      "oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
    },
    "expires_at": {
      "oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
    },
    "supersedes_asset_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^asset_[0-9a-f]{24}$"}
      ]
    },
    "origin_uri": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 2000}
      ]
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "fragment_id", "locator", "quote_sha256"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^source_[0-9a-f]{24}$"},
        "fragment_id": {"type": "string", "pattern": "^fragment_[0-9a-f]{24}$"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 2000},
        "quote_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "active"}}},
      "then": {
        "properties": {
          "verification": {"const": "human_verified"},
          "activated_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {"properties": {"memory_tier": {"const": "working"}}},
      "then": {
        "properties": {
          "expires_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {"properties": {"verification": {"const": "source_bound"}}},
      "then": {
        "properties": {
          "source_refs": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["proposed", "quarantined"]}
        }
      },
      "then": {
        "properties": {
          "verification": {"enum": ["unverified", "source_bound"]},
          "activated_at": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "directive_mode": {"const": "reviewed_instruction"}
        }
      },
      "then": {
        "properties": {
          "status": {"const": "active"},
          "kind": {"enum": ["constraint", "procedure", "rule"]},
          "verification": {"const": "human_verified"}
        }
      }
    }
  ]
}
