{
  "schema_version": "deeplaw.v013-qualification-protocol/v1",
  "protocol_id": "deeplaw-v013-source-candidate-qualification",
  "protocol_version": 1,
  "status": "candidate_qualification",
  "freeze_status": "protocol_frozen_candidate_binding_pending",
  "objective": "Qualify the v0.13 source candidate for evidence-complete Living Wiki and persistent Agent Context behavior without confusing development evidence with an external qualification holdout or final blind holdout.",
  "candidate_binding": {
    "package_version": "0.12.0",
    "wheel_filename": null,
    "wheel_sha256": null,
    "source_commit": null,
    "qualification_holdout_sha256": null,
    "final_blind_holdout_sha256": null
  },
  "data_layers": {
    "development": {
      "layer_kind": "development",
      "residency": "repository_or_public_synthetic",
      "source_id": "v013_development_synthetic",
      "status": "development_only",
      "source_visibility": "compiler_visible_source_only",
      "gold_visibility": "development_labels_may_be_visible",
      "scorer_visibility": "compiler_forbidden",
      "tuning_policy": "permitted; never qualifies a holdout",
      "corpus_sha256": null
    },
    "qualification_holdout": {
      "layer_kind": "qualification_holdout",
      "residency": "repo_external",
      "source_id": "v013_external_qualification_holdout",
      "status": "not_bound",
      "source_visibility": "compiler_visible_source_only",
      "gold_visibility": "evaluator_only",
      "scorer_visibility": "evaluator_only",
      "tuning_policy": "any diagnostic_or_tuning_use_downgrades_to_development",
      "corpus_sha256": null,
      "gold_sha256": null
    },
    "final_blind": {
      "layer_kind": "final_blind",
      "residency": "repo_external",
      "source_id": "v013_external_final_blind_holdout",
      "status": "not_bound",
      "source_visibility": "compiler_visible_source_only",
      "gold_visibility": "evaluator_only",
      "scorer_visibility": "evaluator_only",
      "entry_condition": "after_final_candidate_freeze_only",
      "failure_policy": "failure_then_repair_requires_new_unseen_holdout",
      "corpus_sha256": null,
      "gold_sha256": null
    }
  },
  "compiler_contract": {
    "execution_artifact": "exact_candidate_wheel_only",
    "allowed_inputs": [
      "candidate_wheel",
      "selected_layer_source_corpus",
      "explicit_deeplaw_mcp"
    ],
    "forbidden_inputs": [
      "repository_source_tree",
      "qualification_gold",
      "final_blind_gold",
      "scorer",
      "expected_ids",
      "private_corpus",
      "ambient_credentials",
      "host_global_config"
    ],
    "source_access": "selected_layer_source_corpus_only",
    "mcp_access": "explicit_deeplaw_mcp_only",
    "network_policy": "offline_except_explicit_provider_channel",
    "input_mounts_read_only": true,
    "repository_source_access": false,
    "gold_access": false,
    "scorer_access": false,
    "expected_identity_access": false,
    "ambient_secret_access": false
  },
  "evaluator_contract": {
    "execution_role": "read_only_output_and_gold_scorer",
    "allowed_inputs": ["compiled_output", "corresponding_gold"],
    "forbidden_inputs": [
      "repository_source_tree",
      "candidate_wheel",
      "compiler_process",
      "private_material"
    ],
    "read_only_inputs": true,
    "repository_source_access": false,
    "compiler_process_access": false,
    "candidate_mutation": false,
    "output_mutation": false
  },
  "frozen_controls": {
    "thresholds_frozen_before_final_result": true,
    "budgets_frozen_before_final_result": true,
    "failure_conditions_frozen_before_final_result": true,
    "metric_set_id": "deeplaw-v013-qualification-metrics-v1",
    "provider_payload_bytes": 65536,
    "statement_candidate_limit": 512,
    "graph_hops": {"minimum": 0, "maximum": 2},
    "graph_admission_limit": 500,
    "graph_scan_limit": 5000,
    "rss_request_count": 10000,
    "rss_max_relative_growth": 0.1,
    "concurrent_readers": 8,
    "query_trace_policy": {
      "ttl_seconds": 900,
      "max_entries": 16,
      "max_bytes": 1048576,
      "hash": "sha256_integrity_recomputed_on_read",
      "owner_delete": true,
      "plaintext_default": false
    }
  },
  "metrics": [
    {"metric_id": "retrieval_recall_at_k", "category": "retrieval", "direction": "higher", "acceptance": {"mode": "minimum", "value": 0.9}, "measurement_status": "not_executed", "zero_denominator_status": "not_executed"},
