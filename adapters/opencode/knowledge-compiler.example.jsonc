{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "deeplaw_knowledge": {
      "type": "local",
      "command": ["deeplaw", "knowledge", "mcp", "--stdio"],
      "enabled": true,
      "timeout": 5000
    },
    "deeplaw_knowledge_sink": {
      "type": "local",
      "command": [
        "deeplaw",
        "knowledge",
        "sink",
        "mcp",
        "--grant-id",
        "<owner-created-compilation-grant-id>",
        "--stdio"
      ],
      "enabled": true,
      "timeout": 5000
    }
  },
  "permission": {
    "*": "deny",
    "deeplaw_knowledge_knowledge_support": "allow",
    "deeplaw_knowledge_sink_knowledge_sink": "allow",
    "skill": {
      "*": "deny",
      "deeplaw-compile-source": "allow"
    }
  }
}
