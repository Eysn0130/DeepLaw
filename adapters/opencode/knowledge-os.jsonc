{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "deeplaw_knowledge": {
      "type": "local",
      "command": [
        "deeplaw",
        "knowledge",
        "mcp",
        "--stdio"
      ],
      "enabled": true,
      "timeout": 5000
    }
  },
  "permission": {
    "*": "deny",
    "deeplaw_knowledge_knowledge_support": "allow",
    "skill": {
      "deeplaw-query": "deny",
      "deeplaw-navigate-wiki": "deny",
      "deeplaw-verify-evidence": "deny"
    },
    "task": {
      "deeplaw-knowledge": "deny"
    }
  }
}
